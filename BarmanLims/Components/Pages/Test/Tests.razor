        <MudText Typo="Typo.h6" Class="mb-4">
            افزودن تعریف نتیجه
        </MudText>

        @if (SelectedResultSet != null)
        {
            <MudText Typo="Typo.body2" Class="mb-3">
                مجموعه نتیجه:
                <b>@SelectedResultSet.Name</b>
            </MudText>
        }

        @if (AvailableResultDefinitions.Count == 0)
        {
            <MudAlert Severity="Severity.Info">
                تعریف نتیجه قابل انتخابی برای این آزمون وجود ندارد.
            </MudAlert>
        }
        else
        {
            <MudSelect T="Guid"
                       @bind-Value="SelectedResultDefinitionId"
                       Label="تعریف نتیجه"
                       Variant="Variant.Outlined"
                       FullWidth="true">

                @foreach (var definition in AvailableResultDefinitions)
                {
                    <MudSelectItem T="Guid"
                                   Value="@definition.Id">

                        @definition.Code - @definition.Name

                    </MudSelectItem>
                }

            </MudSelect>

            <MudNumericField T="int"
                             @bind-Value="NewResultSetItemDisplayOrder"
                             Label="ترتیب نمایش"
                             Variant="Variant.Outlined"
                             Min="1"
                             Class="mt-4" />

            <MudGrid Class="mt-2">

                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal?"
                                     @bind-Value="NewResultSetItemLOD"
                                     Label="LOD (حد تشخیص)"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Min="0" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal?"
                                     @bind-Value="NewResultSetItemLOQ"
                                     Label="LOQ (حد تعیین مقدار)"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Min="0" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal?"
                                     @bind-Value="NewResultSetItemMinValue"
                                     Label="حداقل"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal?"
                                     @bind-Value="NewResultSetItemMaxValue"
                                     Label="حداکثر"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense" />
                </MudItem>

            </MudGrid>
        }

        @if (!string.IsNullOrWhiteSpace(ResultSetItemError))
        {
            <MudAlert Severity="Severity.Error"
                      Class="mt-4">

                @ResultSetItemError

            </MudAlert>
        }

    </DialogContent>

    <DialogActions>

        <MudButton Variant="Variant.Text"
                   OnClick="@(() => AddResultSetItemDialogVisible = false)">

            انصراف

        </MudButton>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="@(AvailableResultDefinitions.Count == 0)"
                   OnClick="SaveResultSetItem">

            افزودن

        </MudButton>

    </DialogActions>

</MudDialog>
