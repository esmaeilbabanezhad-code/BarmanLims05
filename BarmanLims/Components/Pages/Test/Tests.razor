    private async Task OpenAddResultSetItem()
    {
        if (SelectedResultSet == null ||
            SelectedResultSet.Id == Guid.Empty)
            return;

        ResultSetItemError = null;

        AvailableResultDefinitions =
            await TestResultDefinitionService.GetByTestIdAsync(
                SelectedResultSet.TestId);

        var existingIds =
            ResultSetItems
                .Select(x => x.TestResultDefinitionId)
                .ToHashSet();

        AvailableResultDefinitions =
            AvailableResultDefinitions
                .Where(x => !existingIds.Contains(x.Id))
                .OrderBy(x => x.DisplayOrder)
                .ToList();

        NewResultSetItemDisplayOrder =
            ResultSetItems.Count == 0
                ? 1
                : ResultSetItems.Max(x => x.DisplayOrder) + 1;

        SelectedResultDefinitionId = Guid.Empty;

        AddResultSetItemDialogVisible = true;
    }
    private async Task SaveResultSetItem()
    {
        if (SelectedResultSet == null ||
            SelectedResultSet.Id == Guid.Empty)
            return;

        ResultSetItemError = null;

        if (SelectedResultDefinitionId == Guid.Empty)
        {
            ResultSetItemError =
                "Please select a result definition.";

            return;
        }

        if (NewResultSetItemDisplayOrder < 1)
        {
            ResultSetItemError =
                "Display order must be greater than zero.";

            return;
        }

        if (NewResultSetItemLOD.HasValue &&
            NewResultSetItemLOD.Value < 0)
        {
            ResultSetItemError =
                "LOD cannot be negative.";

            return;
        }

        if (NewResultSetItemLOQ.HasValue &&
            NewResultSetItemLOQ.Value < 0)
        {
            ResultSetItemError =
                "LOQ cannot be negative.";

            return;
        }

        if (NewResultSetItemMinValue.HasValue &&
            NewResultSetItemMaxValue.HasValue &&
            NewResultSetItemMinValue.Value >
            NewResultSetItemMaxValue.Value)
        {
            ResultSetItemError =
                "Min value cannot be greater than Max value.";

            return;
        }

        try
        {
            await TestResultSetItemService.AddAsync(
                SelectedResultSet.Id,
                SelectedResultDefinitionId,
                NewResultSetItemDisplayOrder,
                NewResultSetItemLOD,
                NewResultSetItemLOQ,
                NewResultSetItemMinValue,
                NewResultSetItemMaxValue);

            // Reload items
            ResultSetItems =
                await TestResultSetItemService
                    .GetByResultSetIdAsync(
                        SelectedResultSet.Id);

            // Close add dialog
            AddResultSetItemDialogVisible = false;

            // Clear selection
            SelectedResultDefinitionId =
                Guid.Empty;

            NewResultSetItemDisplayOrder = 1;

            NewResultSetItemLOD = null;
            NewResultSetItemLOQ = null;
            NewResultSetItemMinValue = null;
            NewResultSetItemMaxValue = null;

            ResultSetItemError = null;
        }
        catch (Exception ex)
        {
            ResultSetItemError =
                $"Error adding result definition: {ex.Message}";
        }
    }
