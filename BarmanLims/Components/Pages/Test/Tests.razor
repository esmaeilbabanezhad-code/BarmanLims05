    private async Task SaveResultDefinition()
    {
        if (IsSaving)
            return;

        try
        {
            ResultDefinitionError = "";

            if (EditingId == Guid.Empty)
            {
                ResultDefinitionError =
                    "آزمون انتخاب‌شده مشخص نیست.";

                return;
            }

            if (string.IsNullOrWhiteSpace(
                    ResultDefinitionForm.Code))
            {
                ResultDefinitionError =
                    "کد نتیجه الزامی است.";

                return;
            }

            if (string.IsNullOrWhiteSpace(
                    ResultDefinitionForm.Name))
            {
                ResultDefinitionError =
                    "نام نتیجه الزامی است.";

                return;
            }

            if (ResultDefinitionForm.DisplayOrder < 0)
            {
                ResultDefinitionError =
                    "ترتیب نمایش نمی‌تواند منفی باشد.";

                return;
            }

            if (ResultDefinitionForm.DecimalPlaces < 0)
            {
                ResultDefinitionError =
                    "تعداد ارقام اعشار نمی‌تواند منفی باشد.";

                return;
            }

            ResultDefinitionForm.TestId = EditingId;

            IsSaving = true;

            if (IsEditingResultDefinition)
            {
                await TestResultDefinitionService
                    .UpdateAsync(ResultDefinitionForm);
            }
            else
            {
                await TestResultDefinitionService
                    .CreateAsync(ResultDefinitionForm);
            }

            ResultDefinitions =
                await TestResultDefinitionService
                    .GetByTestIdAsync(EditingId);

            ResultDefinitionDialogVisible = false;

            ResultDefinitionForm =
                new TestResultDefinitionDto();

            ResultDefinitionError = "";
        }
        catch (Exception ex)
        {
            ResultDefinitionError =
                $"خطا در ذخیره تعریف نتیجه: {ex.Message}";
        }
        finally
        {
            IsSaving = false;
        }
    }

    // =========================================================
