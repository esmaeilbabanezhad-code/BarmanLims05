    // =========================================================

    private async Task SaveTest()
    {
        if (IsSaving)
            return;

        try
        {
            DialogError = "";

            if (string.IsNullOrWhiteSpace(Form.Code))
            {
                DialogError = "Code is required.";
                return;
            }

            if (string.IsNullOrWhiteSpace(Form.Name))
            {
                DialogError = "Name is required.";
                return;
            }

            IsSaving = true;

            if (!IsEditMode)
            {
                await TestService.CreateAsync(
                    new CreateTestDto
                    {
                        Code = Form.Code,
                        Name = Form.Name,
                        EnglishName = Form.EnglishName,
                        Unit = Form.Unit,
                        Method = Form.Method,
                        InstrumentName = Form.InstrumentName,
                        LOD = Form.LOD,
                        LOQ = Form.LOQ,
                        DepartmentId = Form.DepartmentId,
                        SampleCategoryId = Form.SampleCategoryId,
                        MatrixId = Form.MatrixId,
                        DefaultAnalystId = Form.DefaultAnalystId,
                        DefaultResult = Form.DefaultResult,
                        IsQuantitative = Form.IsQuantitative,
                        IsActiveForReception =
                            Form.IsActiveForReception,
                        Description = Form.Description
                    });
            }
            else
            {
                await TestService.UpdateAsync(
                    EditingId,
                    new UpdateTestDto
                    {
                        Code = Form.Code,
                        Name = Form.Name,
                        EnglishName = Form.EnglishName,
                        Unit = Form.Unit,
                        Method = Form.Method,
                        InstrumentName = Form.InstrumentName,
                        LOD = Form.LOD,
                        LOQ = Form.LOQ,
                        DepartmentId = Form.DepartmentId,
                        SampleCategoryId = Form.SampleCategoryId,
                        MatrixId = Form.MatrixId,
                        DefaultAnalystId = Form.DefaultAnalystId,
                        DefaultResult = Form.DefaultResult,
                        IsQuantitative = Form.IsQuantitative,
                        IsActiveForReception =
                            Form.IsActiveForReception,
                        Description = Form.Description
                    });
            }

            DialogVisible = false;

            await LoadTests();
        }
        catch (Exception ex)
        {
            DialogError =
                $"Error saving test: {ex.Message}";
        }
        finally
        {
            IsSaving = false;
        }
    }


