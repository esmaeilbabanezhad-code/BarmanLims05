    private async Task SaveTestLimitRule()
    {
        if (TestLimitRuleType == LimitType.Exact &&
    !TestLimitRuleExactValue.HasValue)
        {
            TestLimitRuleFormError = "برای نوع «مقدار دقیق»، وارد کردن مقدار دقیق الزامی است.";
            return;
        }
        if (TestLimitRuleType != LimitType.Minimum &&
    TestLimitRuleType != LimitType.Range)
        {
            TestLimitRuleLowerValue = null;
            TestLimitRuleLowerInclusive = false;
        }

        if (TestLimitRuleType != LimitType.Maximum &&
            TestLimitRuleType != LimitType.Range)
        {
            TestLimitRuleUpperValue = null;
            TestLimitRuleUpperInclusive = false;
        }

        if (TestLimitRuleType != LimitType.Exact)
        {
            TestLimitRuleExactValue = null;
        }

        if (TestLimitRuleType != LimitType.Qualitative)
        {
            TestLimitRuleAllowedValues = null;
        }
        if (TestLimitRuleTestId == Guid.Empty)
        {
            TestLimitRuleFormError = "آزمون مشخص نشده است.";
            return;
        }

        if (TestLimitRuleLimitReferenceId == Guid.Empty)
        {
            TestLimitRuleFormError = "مرجع حد مجاز را انتخاب کنید.";
            return;
        }

        if (TestLimitRuleType == LimitType.Minimum &&
    !TestLimitRuleLowerValue.HasValue)
        {
            TestLimitRuleFormError =
                "برای نوع «حداقل»، وارد کردن حد پایین الزامی است.";
            return;
        }

        if (TestLimitRuleType == LimitType.Maximum &&
            !TestLimitRuleUpperValue.HasValue)
        {
            TestLimitRuleFormError =
                "برای نوع «حداکثر»، وارد کردن حد بالا الزامی است.";
            return;
        }

        if (TestLimitRuleType == LimitType.Range)
        {
            if (!TestLimitRuleLowerValue.HasValue ||
                !TestLimitRuleUpperValue.HasValue)
            {
                TestLimitRuleFormError =
                    "برای نوع «بازه»، وارد کردن حد پایین و حد بالا الزامی است.";
                return;
            }

            if (TestLimitRuleLowerValue.Value >
                TestLimitRuleUpperValue.Value)
            {
                TestLimitRuleFormError =
                    "در نوع «بازه»، حد پایین نمی‌تواند بزرگ‌تر از حد بالا باشد.";
                return;
            }
        }

        if (TestLimitRuleType == LimitType.Qualitative &&
            string.IsNullOrWhiteSpace(TestLimitRuleAllowedValues))
        {
            TestLimitRuleFormError =
                "برای نوع «کیفی»، وارد کردن مقادیر مجاز الزامی است.";
            return;
        }

        if (TestLimitRulePriority < 1)
        {
            TestLimitRuleFormError =
                "اولویت باید حداقل ۱ باشد.";
            return;
        }

        if (TestLimitRuleValidFrom.HasValue &&
            TestLimitRuleValidTo.HasValue &&
            TestLimitRuleValidTo.Value.Date <
            TestLimitRuleValidFrom.Value.Date)
        {
            TestLimitRuleFormError =
                "تاریخ پایان اعتبار نمی‌تواند قبل از تاریخ شروع اعتبار باشد.";
            return;
        }

        try
        {
            TestLimitRuleFormError = "";

            if (IsEditingTestLimitRule)
            {
                // =========================================
                // Update existing rule
                // =========================================

                if (EditingTestLimitRuleId == Guid.Empty)
                {
                    TestLimitRuleFormError =
                        "شناسه قانون برای ویرایش مشخص نشده است.";

                    return;
                }

                var rule =
                    await TestLimitRuleService.GetByIdAsync(
                        EditingTestLimitRuleId);

                if (rule is null)
                {
                    TestLimitRuleFormError =
                        "قانون حد مجاز مورد نظر پیدا نشد.";

                    return;
                }

                rule.TestId =
                    TestLimitRuleTestId;

                rule.LimitReferenceId =
                     TestLimitRuleLimitReferenceId;

                rule.LimitType =
                    TestLimitRuleType;

                rule.LowerValue =
                    TestLimitRuleLowerValue;

                rule.UpperValue =
                    TestLimitRuleUpperValue;

                rule.ExactValue = TestLimitRuleExactValue;

                rule.LowerInclusive =
                    TestLimitRuleLowerInclusive;

                rule.UpperInclusive =
                    TestLimitRuleUpperInclusive;

                rule.Priority =
                    TestLimitRulePriority;

                rule.IsActive =
                    TestLimitRuleIsActive;

                rule.ValidFrom =
    TestLimitRuleValidFrom.HasValue
        ? DateTime.SpecifyKind(
            TestLimitRuleValidFrom.Value,
            DateTimeKind.Utc)
        : DateTime.UtcNow.Date;

                rule.ValidTo =
                    TestLimitRuleValidTo.HasValue
                        ? DateTime.SpecifyKind(
                            TestLimitRuleValidTo.Value,
                            DateTimeKind.Utc)
                        : null;

                rule.Unit = string.IsNullOrWhiteSpace(TestLimitRuleUnit)
                    ? null
                    : TestLimitRuleUnit.Trim();

                rule.AllowedValues = string.IsNullOrWhiteSpace(TestLimitRuleAllowedValues)
                    ? null
                    : TestLimitRuleAllowedValues.Trim();


                rule.Description =
                    string.IsNullOrWhiteSpace(
                        TestLimitRuleDescription)
                        ? null
                        : TestLimitRuleDescription.Trim();

                await TestLimitRuleService.UpdateAsync(rule);
            }
            else
            {
                // =========================================
                // Create new rule
                // =========================================

                var rule = new TestLimitRule
                {
                    TestId =
                        TestLimitRuleTestId,

                    LimitReferenceId =
                        TestLimitRuleLimitReferenceId,

                    LimitType =
                        TestLimitRuleType,

                    LowerValue =
                        TestLimitRuleLowerValue,

                    UpperValue =
                        TestLimitRuleUpperValue,

                    ExactValue = TestLimitRuleExactValue,

                    LowerInclusive =
                        TestLimitRuleLowerInclusive,

                    UpperInclusive =
                        TestLimitRuleUpperInclusive,

                    Priority =
                        TestLimitRulePriority,

                    IsActive =
                        TestLimitRuleIsActive,

                    ValidFrom =
    TestLimitRuleValidFrom.HasValue
        ? DateTime.SpecifyKind(
            TestLimitRuleValidFrom.Value,
            DateTimeKind.Utc)
        : DateTime.UtcNow.Date,

                    ValidTo =
    TestLimitRuleValidTo.HasValue
        ? DateTime.SpecifyKind(
            TestLimitRuleValidTo.Value,
            DateTimeKind.Utc)
        : null,

                    Unit = string.IsNullOrWhiteSpace(TestLimitRuleUnit)
                        ? null
                        : TestLimitRuleUnit.Trim(),

                    AllowedValues = string.IsNullOrWhiteSpace(TestLimitRuleAllowedValues)
                        ? null
                        : TestLimitRuleAllowedValues.Trim(),

                    Description =
                        string.IsNullOrWhiteSpace(
                            TestLimitRuleDescription)
                            ? null
                            : TestLimitRuleDescription.Trim()
                };

                await TestLimitRuleService.CreateAsync(rule);
            }

            // =========================================
            // Refresh list
            // =========================================

            TestLimitRules =
                await TestLimitRuleService.GetByTestIdAsync(
                    TestLimitRuleTestId);

            TestLimitRuleFormVisible = false;
        }
        catch (Exception ex)
        {
            var errorMessage =
                ex.InnerException?.InnerException?.Message
                ?? ex.InnerException?.Message
                ?? ex.Message;

            await InvokeAsync(() =>
            {
                TestLimitRuleFormError =
                    $"خطا: {errorMessage}";
            });
        }
    }
    private async Task DeleteTestLimitRule(Guid id)
    {
        TestLimitRuleFormError = $"Delete clicked: {id}";
        if (id == Guid.Empty)
            return;

        try
        {
            TestLimitRuleFormError = "";

            var result =
               await TestLimitRuleService.DeleteAsync(id);

            TestLimitRuleFormError =
                $"DeleteAsync result = {result}";

            if (!result)
            {
                TestLimitRuleFormError =
                    "قانون حد مجاز مورد نظر پیدا نشد.";

                return;
            }

            TestLimitRules =
                await TestLimitRuleService.GetByTestIdAsync(
                    TestLimitRuleTestId);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            var errorMessage =
                ex.InnerException?.InnerException?.Message
                ?? ex.InnerException?.Message
                ?? ex.Message;

            TestLimitRuleFormError =
                $"خطا در حذف قانون حد مجاز: {errorMessage}";
        }
    }
    private void CloseReferenceLimits()
    {
        ReferenceLimitsDialogVisible = false;
    }
    private void OpenCreateReferenceLimit()
    {
        if (SelectedTestForReferenceLimits is null ||
            SelectedTestForReferenceLimits.Id == Guid.Empty)
            return;

        IsEditingReferenceLimit = false;
        EditingReferenceLimitId = Guid.Empty;
        ReferenceLimitTestId =
            SelectedTestForReferenceLimits.Id;

        ReferenceLimitMatrixId = null;
        ReferenceLimitProductName = null;
        ReferenceLimitOrganizationName = null;

        ReferenceLimitMinValue = null;
        ReferenceLimitMaxValue = null;

        ReferenceLimitWarningLow = null;
        ReferenceLimitWarningHigh = null;

        ReferenceLimitUnit =
            SelectedTestForReferenceLimits.Unit;

        ReferenceLimitPriority = 1;

        ReferenceLimitIsTemporary = false;

        ReferenceLimitValidFrom = null;
        ReferenceLimitValidTo = null;

        ReferenceLimitDescription = null;

        ReferenceLimitFormError = "";

        ReferenceLimitFormVisible = true;
    }
    private void CloseCreateReferenceLimit()
    {
        ReferenceLimitFormVisible = false;
        ReferenceLimitFormError = "";
    }
    private async Task SaveReferenceLimit()
    {
        if (ReferenceLimitTestId == Guid.Empty)
        {
            ReferenceLimitFormError =
                "آزمون برای حد مجاز مشخص نشده است.";

            return;
        }

        try
        {
            ReferenceLimitFormError = "";

            var referenceLimit = new ReferenceLimit
            {
                TestId = ReferenceLimitTestId,

                MatrixId = ReferenceLimitMatrixId,

                ProductName = string.IsNullOrWhiteSpace(
                    ReferenceLimitProductName)
                    ? null
                    : ReferenceLimitProductName.Trim(),

                OrganizationName = string.IsNullOrWhiteSpace(
                    ReferenceLimitOrganizationName)
                    ? null
                    : ReferenceLimitOrganizationName.Trim(),

                MinValue = ReferenceLimitMinValue,
                MaxValue = ReferenceLimitMaxValue,

                WarningLow = ReferenceLimitWarningLow,
                WarningHigh = ReferenceLimitWarningHigh,

                Unit = string.IsNullOrWhiteSpace(
                    ReferenceLimitUnit)
                    ? null
                    : ReferenceLimitUnit.Trim(),

                Priority = ReferenceLimitPriority,

                IsTemporary = ReferenceLimitIsTemporary,

                ValidFrom = ReferenceLimitValidFrom,
                ValidTo = ReferenceLimitValidTo,

                Description = string.IsNullOrWhiteSpace(
                    ReferenceLimitDescription)
                    ? null
                    : ReferenceLimitDescription.Trim()
            };

            if (IsEditingReferenceLimit)
            {
                // در حالت ویرایش باید Id رکورد اصلی حفظ شود.
                if (EditingReferenceLimitId == Guid.Empty)
                {
                    ReferenceLimitFormError =
                        "رکورد حد مجاز برای ویرایش مشخص نشده است.";

                    return;
                }

                referenceLimit.Id = EditingReferenceLimitId;

                await ReferenceLimitService.UpdateAsync(
                    referenceLimit);
            }
            else
            {
                await ReferenceLimitService.CreateAsync(
                    referenceLimit);
            }

            ReferenceLimits =
                await ReferenceLimitService.GetByTestIdAsync(
                    ReferenceLimitTestId);

            ReferenceLimitFormVisible = false;
            IsEditingReferenceLimit = false;
            EditingReferenceLimitId = Guid.Empty;
        }
        catch (Exception ex)
        {
            ReferenceLimitFormError =
                $"خطا در ذخیره حد مجاز: {ex.Message}";
        }
    }
    private void OpenEditReferenceLimit(ReferenceLimit limit)
    {
        IsEditingReferenceLimit = true;
        EditingReferenceLimitId = limit.Id;
        ReferenceLimitTestId = limit.TestId;

        ReferenceLimitMatrixId = limit.MatrixId;
        ReferenceLimitProductName = limit.ProductName;
        ReferenceLimitOrganizationName = limit.OrganizationName;

        ReferenceLimitMinValue = limit.MinValue;
        ReferenceLimitMaxValue = limit.MaxValue;

        ReferenceLimitWarningLow = limit.WarningLow;
        ReferenceLimitWarningHigh = limit.WarningHigh;

        ReferenceLimitUnit = limit.Unit;
        ReferenceLimitPriority = limit.Priority;

        ReferenceLimitIsTemporary = limit.IsTemporary;

        ReferenceLimitValidFrom = limit.ValidFrom;
        ReferenceLimitValidTo = limit.ValidTo;

        ReferenceLimitDescription = limit.Description;

        ReferenceLimitFormError = "";

        ReferenceLimitFormVisible = true;
    }
    private async Task DeleteReferenceLimit(Guid id)
    {
        if (id == Guid.Empty)
            return;

        try
        {
            ReferenceLimitFormError = "";

            var deleted =
                await ReferenceLimitService.DeleteAsync(id);

            if (!deleted)
            {
                ReferenceLimitFormError =
                    "حد مجاز موردنظر پیدا نشد.";

                return;
            }

            ReferenceLimits =
                await ReferenceLimitService.GetByTestIdAsync(
                    ReferenceLimitTestId);
        }
        catch (Exception ex)
        {
            ReferenceLimitFormError =
                $"خطا در حذف حد مجاز: {ex.Message}";
        }
    }
