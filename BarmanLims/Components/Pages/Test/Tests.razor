                      Dense="true"
                      Hover="true"
                      Bordered="true">

                <HeaderContent>

                    <MudTh>ماتریس</MudTh>
                    <MudTh>محصول</MudTh>
                    <MudTh>سازمان / مرجع</MudTh>
                    <MudTh>حداقل</MudTh>
                    <MudTh>حداکثر</MudTh>
                    <MudTh>واحد</MudTh>
                    <MudTh>اولویت</MudTh>
                    <MudTh>عملیات</MudTh>

                </HeaderContent>

                <RowTemplate>

                    <MudTd>
                        @(context.Matrix?.Name ?? "-")
                    </MudTd>

                    <MudTd>
                        @(context.ProductName ?? "-")
                    </MudTd>

                    <MudTd>
                        @(context.OrganizationName ?? "-")
                    </MudTd>

                    <MudTd>
                        @(context.MinValue?.ToString() ?? "-")
                    </MudTd>

                    <MudTd>
                        @(context.MaxValue?.ToString() ?? "-")
                    </MudTd>

                    <MudTd>
                        @(context.Unit ?? "-")
                    </MudTd>

                    <MudTd>
                        @context.Priority
                    </MudTd>
                    <MudTd>

                        <MudButton Size="Size.Small"
                                   Variant="Variant.Text"
                                   Color="Color.Primary"
                                   OnClick="@(() => OpenEditReferenceLimit(context))">

                            ویرایش

                        </MudButton>
                        <MudButton Size="Size.Small"
                                   Variant="Variant.Text"
                                   Color="Color.Error"
                                   OnClick="@(() => DeleteTestLimitRule(context.Id))">
                            حذف
