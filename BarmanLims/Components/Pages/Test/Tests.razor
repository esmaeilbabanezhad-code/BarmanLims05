                       Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.Rule"
                       OnClick="OpenTestLimitRules">

                قوانین حد مجاز

            </MudButton>
        </div>
        @if (ReferenceLimits.Count == 0)
        {
