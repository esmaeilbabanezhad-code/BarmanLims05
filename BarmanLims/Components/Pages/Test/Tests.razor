@code
{
    // =========================================================
    // Data
    // =========================================================

    private List<TestLookupDto> TestItems = new();

    private List<TestLookupDto> DeletedTests = new();

    private List<Department> Departments = new();

    private List<SampleCategory> SampleCategories = new();

    private List<Matrix> Matrices = new();

    private List<Employee> Employees = new();

    private List<ReferenceLimit> ReferenceLimits = new();

    private TestLookupDto? SelectedTestForReferenceLimits;

    private bool ReferenceLimitFormVisible;

    private bool IsEditingReferenceLimit;

    private Guid EditingReferenceLimitId;

    private Guid ReferenceLimitTestId;

    private Guid? ReferenceLimitMatrixId;

    private string? ReferenceLimitProductName;

    private string? ReferenceLimitOrganizationName;

    private decimal? ReferenceLimitMinValue;

    private decimal? ReferenceLimitMaxValue;

    private decimal? ReferenceLimitWarningLow;

    private decimal? ReferenceLimitWarningHigh;

    private string? ReferenceLimitUnit;

    private int ReferenceLimitPriority = 1;

    private bool ReferenceLimitIsTemporary;

    private DateTime? ReferenceLimitValidFrom;

    private DateTime? ReferenceLimitValidTo;

    private string? ReferenceLimitDescription;

    private string ReferenceLimitFormError = "";


    // =========================================================
    // State
    // =========================================================

    private bool IsLoading;

    private bool IsLoadingDeleted;

    private bool IsSaving;

    private bool DialogVisible;

    private bool ReferenceLimitsDialogVisible;

    private bool DeletedDialogVisible;

    private bool IsEditMode;


    // =========================================================
    // Search / Errors
    // =========================================================

    private string SearchText = "";

    private string ErrorMessage = "";

    private string DialogError = "";


    // =========================================================
    // Editing
    // =========================================================

    private Guid EditingId;


    // =========================================================
    // Form
    // =========================================================

    private TestFormModel Form = new();

    // =========================================================
    // Test Result Definitions
    // =========================================================

    private List<TestResultDefinitionDto> ResultDefinitions = new();

    private TestResultDefinitionDto ResultDefinitionForm = new();

    private bool ResultDefinitionDialogVisible = false;

    private bool IsEditingResultDefinition = false;

    private Guid EditingResultDefinitionId = Guid.Empty;

    private string ResultDefinitionError = "";

    // =========================================================
    // Test Result Sets
    // =========================================================

    private List<TestResultSetDto> ResultSets = new();

    private TestResultSetDto ResultSetForm = new();

    private bool ResultSetsDialogVisible = false;

    private bool AddResultSetDialogVisible = false;

    private string ResultSetError = "";

    private List<StandardSample> StandardSamples = new();

  
    private List<CustomerLookupDto> Customers = new();
    

   


    // =========================================================
    // Test Matrix View
    // =========================================================

    private bool IsMatrixLoading;
    private string MatrixError = "";
    private string MatrixSearchText = "";

    private Guid? MatrixTestId;
    private Guid? MatrixCategoryId;
    private Guid? MatrixContextId;
    private Guid? MatrixStandardSampleId;
    private Guid? MatrixCustomerId;

    private List<TestMatrixRow> TestMatrixRows = new();

    private List<TestMatrixRow> FilteredTestMatrixRows
    {
        get
        {
            IEnumerable<TestMatrixRow> query = TestMatrixRows;

            if (MatrixTestId.HasValue)
                query = query.Where(x => x.TestId == MatrixTestId.Value);

            if (MatrixCategoryId.HasValue)
                query = query.Where(x => x.CategoryId == MatrixCategoryId.Value);

            if (MatrixContextId.HasValue)
                query = query.Where(x => x.MatrixId == MatrixContextId.Value);

            if (MatrixStandardSampleId.HasValue)
                query = query.Where(x => x.StandardSampleId == MatrixStandardSampleId.Value);

            if (MatrixCustomerId.HasValue)
                query = query.Where(x => x.CustomerId == MatrixCustomerId.Value);

            if (!string.IsNullOrWhiteSpace(MatrixSearchText))
            {
                var search = MatrixSearchText.Trim();

                query = query.Where(x =>
                    Contains(x.TestCode, search) ||
                    Contains(x.TestName, search) ||
                    Contains(x.ResultCode, search) ||
                    Contains(x.ResultName, search) ||
                    Contains(x.CategoryName, search) ||
                    Contains(x.MatrixName, search) ||
                    Contains(x.StandardSampleName, search) ||
                    Contains(x.CustomerName, search));
            }

            return query
                .OrderBy(x => x.TestName)
                .ThenBy(x => x.CategoryName)
                .ThenBy(x => x.MatrixName)
                .ThenBy(x => x.ResultDisplayOrder)
                .ToList();
        }
    }

    private sealed class TestMatrixRow
    {
        public Guid TestId { get; set; }
        public TestLookupDto Test { get; set; } = new();

        public string TestCode { get; set; } = "";
        public string TestName { get; set; } = "";
        public string? ResultCode { get; set; }
        public string ResultName { get; set; } = "";

        public Guid? CategoryId { get; set; }
        public Guid? MatrixId { get; set; }
        public Guid? StandardSampleId { get; set; }
        public Guid? CustomerId { get; set; }

        public string? CategoryName { get; set; }
        public string? MatrixName { get; set; }
        public string? StandardSampleName { get; set; }
        public string? CustomerName { get; set; }
        public string? Unit { get; set; }

        public decimal? LOD { get; set; }
        public decimal? LOQ { get; set; }
        public decimal? MinValue { get; set; }
        public decimal? MaxValue { get; set; }

        public string Source { get; set; } = "";
        public int ResultDisplayOrder { get; set; }
    }

    private async Task LoadTestMatrixAsync()
    {
        try
        {
            IsMatrixLoading = true;
            MatrixError = "";
            TestMatrixRows.Clear();

            if (StandardSamples.Count == 0)
                StandardSamples = await StandardSampleService.GetAllAsync();

            if (Customers.Count == 0)
                Customers = await CustomerService.GetLookupAsync();

            var categoryNames = SampleCategories
                .ToDictionary(x => x.Id, x => x.Name);

            var matrixNames = Matrices
                .ToDictionary(x => x.Id, x => x.Name);

            var standardSampleNames = StandardSamples
                .ToDictionary(x => x.Id, x => x.Name);

            var customerNames = Customers
                .ToDictionary(x => x.Id, x => x.DisplayName);

            foreach (var test in TestItems)
            {
                var resultSets =
                    await TestResultSetService.GetByTestIdAsync(test.Id);

                if (resultSets.Count == 0)
                {
                    TestMatrixRows.Add(new TestMatrixRow
                    {
                        TestId = test.Id,
                        Test = test,
                        TestCode = test.Code,
                        TestName = test.Name,
                        ResultName = test.Name,
                        CategoryId = test.SampleCategoryId,
                        MatrixId = test.MatrixId,
                        CategoryName = test.SampleCategoryId.HasValue &&
                                       categoryNames.TryGetValue(test.SampleCategoryId.Value, out var catName)
                            ? catName
                            : null,
                        MatrixName = test.MatrixId.HasValue &&
                                     matrixNames.TryGetValue(test.MatrixId.Value, out var matrixName)
                            ? matrixName
                            : null,
                        Unit = test.Unit,
                        LOD = test.LOD,
                        LOQ = test.LOQ,
                        Source = "پیش‌فرض آزمون"
                    });

                    continue;
                }

                foreach (var resultSet in resultSets)
                {
                    var items =
                        await TestResultSetItemService
                            .GetByResultSetIdAsync(resultSet.Id);

                    if (items.Count == 0)
                    {
                        TestMatrixRows.Add(new TestMatrixRow
                        {
                            TestId = test.Id,
                            Test = test,
                            TestCode = test.Code,
                            TestName = test.Name,
                            ResultName = resultSet.Name,
                            CategoryId = resultSet.SampleCategoryId,
                            MatrixId = resultSet.MatrixId,
                            StandardSampleId = resultSet.StandardSampleId,
                            CustomerId = resultSet.CustomerId,
                            CategoryName = resultSet.SampleCategoryId.HasValue &&
                                           categoryNames.TryGetValue(resultSet.SampleCategoryId.Value, out var emptyCatName)
                                ? emptyCatName
                                : null,
                            MatrixName = resultSet.MatrixId.HasValue &&
                                         matrixNames.TryGetValue(resultSet.MatrixId.Value, out var emptyMatrixName)
                                ? emptyMatrixName
                                : null,
                            StandardSampleName = resultSet.StandardSampleId.HasValue &&
                                                 standardSampleNames.TryGetValue(resultSet.StandardSampleId.Value, out var emptySampleName)
                                ? emptySampleName
                                : null,
                            CustomerName = resultSet.CustomerId.HasValue &&
                                           customerNames.TryGetValue(resultSet.CustomerId.Value, out var emptyCustomerName)
                                ? emptyCustomerName
                                : null,
                            Unit = test.Unit,
                            LOD = test.LOD,
                            LOQ = test.LOQ,
                            Source = $"مجموعه: {resultSet.Name}"
                        });

                        continue;
                    }

                    foreach (var item in items)
                    {
                        TestMatrixRows.Add(new TestMatrixRow
                        {
                            TestId = test.Id,
                            Test = test,
                            TestCode = test.Code,
                            TestName = test.Name,
                            ResultCode = item.Code,
                            ResultName = item.Name,
                            CategoryId = resultSet.SampleCategoryId,
                            MatrixId = resultSet.MatrixId,
                            StandardSampleId = resultSet.StandardSampleId,
                            CustomerId = resultSet.CustomerId,
                            CategoryName = resultSet.SampleCategoryId.HasValue &&
                                           categoryNames.TryGetValue(resultSet.SampleCategoryId.Value, out var itemCatName)
                                ? itemCatName
                                : null,
                            MatrixName = resultSet.MatrixId.HasValue &&
                                         matrixNames.TryGetValue(resultSet.MatrixId.Value, out var itemMatrixName)
                                ? itemMatrixName
                                : null,
                            StandardSampleName = resultSet.StandardSampleId.HasValue &&
                                                 standardSampleNames.TryGetValue(resultSet.StandardSampleId.Value, out var itemSampleName)
                                ? itemSampleName
                                : null,
                            CustomerName = resultSet.CustomerId.HasValue &&
                                           customerNames.TryGetValue(resultSet.CustomerId.Value, out var itemCustomerName)
                                ? itemCustomerName
                                : null,
                            Unit = item.Unit ?? test.Unit,
                            LOD = item.LOD ?? test.LOD,
                            LOQ = item.LOQ ?? test.LOQ,
                            MinValue = item.MinValue,
                            MaxValue = item.MaxValue,
                            Source = $"مجموعه: {resultSet.Name}",
                            ResultDisplayOrder = item.DisplayOrder
                        });
                    }
                }
            }
        }
        catch (Exception ex)
        {
            MatrixError = $"خطا در بارگذاری ماتریس آزمون: {ex.Message}";
        }
        finally
        {
            IsMatrixLoading = false;
        }
    }

    // =========================================================
    // Filter
    // =========================================================

    private List<TestLookupDto> FilteredTests
    {
        get
        {
            if (string.IsNullOrWhiteSpace(SearchText))
                return TestItems;

            var search = SearchText.Trim();

            return TestItems
                .Where(x =>
                    Contains(x.Code, search) ||
                    Contains(x.Name, search) ||
                    Contains(x.EnglishName, search))
                .ToList();
        }
    }


    // =========================================================
    // Initialization
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        await LoadTests();

        Departments =
            await TestService.GetDepartmentsAsync();

        Employees =
              await EmployeeService.GetAllAsync();

        SampleCategories =
            await TestService.GetSampleCategoriesAsync();

        Matrices =
            await TestService.GetMatricesAsync();

        StandardSamples =
            await StandardSampleService.GetAllAsync();

        Customers =
           await CustomerService.GetLookupAsync();

        await LoadTestMatrixAsync();
    }


    // =========================================================
    // Load Tests
    // =========================================================

    private async Task LoadTests()
    {
        try
        {
            IsLoading = true;
            ErrorMessage = "";

            TestItems =
                await TestService.GetAllAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage =
                $"Error loading tests: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }


    // =========================================================
    // Create
    // =========================================================

    private async Task OpenCreate()
    {
        IsEditMode = false;

        EditingId = Guid.Empty;

        DialogError = "";

        try
        {
            var code =
                await NumberSequenceService
                    .GetNextCodeAsync("Test");

            Form = new TestFormModel
            {
                Code = code,
                IsActiveForReception = true,
                IsQuantitative = false
            };

            DialogVisible = true;
        }
        catch (Exception ex)
        {
            DialogError =
                $"خطا در تولید کد آزمون: {ex.Message}";
        }
    }


    // =========================================================
    // Edit
    // =========================================================

    private async Task OpenEdit(TestLookupDto test)
    {
        IsEditMode = true;

        EditingId = test.Id;

        Form = new TestFormModel
        {
            Code = test.Code,
            Name = test.Name,
            EnglishName = test.EnglishName,
            Unit = test.Unit,
            Method = test.Method,
            InstrumentName = test.InstrumentName,
            LOD = test.LOD,
            LOQ = test.LOQ,
            DepartmentId = test.DepartmentId,
            SampleCategoryId = test.SampleCategoryId,
            MatrixId = test.MatrixId,
            DefaultAnalystId = test.DefaultAnalystId,
            DefaultResult = test.DefaultResult,
            IsQuantitative = test.IsQuantitative,
            IsActiveForReception = test.IsActiveForReception,
            Description = test.Description
        };

        DialogError = "";
        ResultDefinitions =
            await TestResultDefinitionService.GetByTestIdAsync(test.Id);
        DialogVisible = true;
    }

    private async Task OpenCreateResultDefinition()
    {
        ResultDefinitionError = "";

        if (!IsEditMode || EditingId == Guid.Empty)
        {
            ResultDefinitionError =
                "ابتدا آزمون را ذخیره و سپس برای تعریف نتایج ویرایش کنید.";

            return;
        }

        try
        {
            var code =
                await NumberSequenceService
                    .GetNextCodeAsync("ResultDefinition");

            ResultDefinitionForm = new TestResultDefinitionDto
            {
                Id = Guid.Empty,
                TestId = EditingId,
                Code = code,
                Name = "",
                Unit = null,
                DisplayOrder = ResultDefinitions.Count,
                IsRequired = true,
