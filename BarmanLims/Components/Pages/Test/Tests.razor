@page "/tests"

@using MudBlazor
@using Barman.Application.DTOs.Test
@using Barman.Domain.Entities
@using Barman.Domain.Enums
@using Barman.Application.Interfaces
@using Barman.Application.DTOs.Customer
@using Barman.Application.DTOs.LimitReference

@inject Barman.Application.Interfaces.ITestService TestService
@inject Barman.Application.Interfaces.IReferenceLimitService ReferenceLimitService
@inject Barman.Application.Interfaces.ILimitReferenceService LimitReferenceService
@inject Barman.Application.Interfaces.ITestLimitRuleService TestLimitRuleService
@inject Barman.Application.Interfaces.ITestResultDefinitionService TestResultDefinitionService
@inject Barman.Application.Interfaces.ITestResultSetService TestResultSetService
@inject Barman.Application.Interfaces.ITestResultSetItemService TestResultSetItemService
@inject Barman.Application.Interfaces.IStandardSampleService StandardSampleService
@inject ICustomerService CustomerService
@inject ISampleCategoryService SampleCategoryService
@inject IMatrixService MatrixService
@inject INumberSequenceService NumberSequenceService
@inject IEmployeeService EmployeeService

<MudPaper Class="pa-4">

    <div class="d-flex justify-space-between align-center">

        <MudText Typo="Typo.h5">
            ماتریس آزمون و مشخصات آزمون
        </MudText>

        <div>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenCreate">
                آزمون جدید
            </MudButton>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Error"
                       Class="ms-2"
                       StartIcon="@Icons.Material.Filled.DeleteSweep"
                       OnClick="ShowDeleted">
                آزمون‌های حذف‌شده
            </MudButton>

        </div>

    </div>

    <MudDivider Class="my-3" />

    @* =========================================================
       ماتریس آزمون — نمای Context / Effective Specification
       منطق Save فعلی آزمون‌ها و Dialogها عمداً دست‌نخورده است.
       ========================================================= *@

    <MudPaper Class="pa-3 mb-4" Outlined="true">
        <div class="d-flex justify-space-between align-center mb-3">
            <MudText Typo="Typo.h6">ماتریس مشخصات مؤثر آزمون</MudText>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="LoadTestMatrixAsync"
                       Disabled="@IsMatrixLoading">
                @(IsMatrixLoading ? "در حال بارگذاری..." : "به‌روزرسانی ماتریس")
            </MudButton>
        </div>

        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="Guid?"
                           @bind-Value="MatrixTestId"
                           Label="آزمون"
                           Variant="Variant.Outlined"
                           Clearable="true"
                           Dense="true">
                    @foreach (var test in TestItems.OrderBy(x => x.Name))
                    {
                        <MudSelectItem T="Guid?" Value="@test.Id">
                            @test.Code - @test.Name
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="Guid?"
                           @bind-Value="MatrixCategoryId"
                           Label="دسته‌بندی نمونه"
                           Variant="Variant.Outlined"
                           Clearable="true"
                           Dense="true">
                    @foreach (var category in SampleCategories.OrderBy(x => x.Name))
                    {
                        <MudSelectItem T="Guid?" Value="@category.Id">
                            @category.Name
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="Guid?"
                           @bind-Value="MatrixContextId"
                           Label="ماتریس"
                           Variant="Variant.Outlined"
                           Clearable="true"
                           Dense="true">
                    @foreach (var matrix in Matrices.OrderBy(x => x.Name))
                    {
                        <MudSelectItem T="Guid?" Value="@matrix.Id">
                            @matrix.Name
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="Guid?"
                           @bind-Value="MatrixStandardSampleId"
                           Label="نمونه استاندارد"
                           Variant="Variant.Outlined"
                           Clearable="true"
                           Dense="true">
                    @foreach (var sample in StandardSamples.OrderBy(x => x.Name))
                    {
                        <MudSelectItem T="Guid?" Value="@sample.Id">
                            @sample.Name
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="Guid?"
                           @bind-Value="MatrixCustomerId"
                           Label="مشتری"
                           Variant="Variant.Outlined"
                           Clearable="true"
                           Dense="true">
                    @foreach (var customer in Customers.OrderBy(x => x.DisplayName))
                    {
                        <MudSelectItem T="Guid?" Value="@customer.Id">
                            @customer.DisplayName
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudTextField T="string"
                              @bind-Value="MatrixSearchText"
                              Label="جستجوی ماتریس"
                              Placeholder="کد، نام آزمون یا نام Result..."
                              Variant="Variant.Outlined"
                              Immediate="true"
                              Clearable="true"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" />
            </MudItem>
        </MudGrid>

        <MudDivider Class="my-3" />

        @if (IsMatrixLoading)
        {
            <div class="d-flex justify-center pa-5">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(MatrixError))
        {
            <MudAlert Severity="Severity.Error" Class="mb-2">
                @MatrixError
            </MudAlert>
        }
        else if (FilteredTestMatrixRows.Count == 0)
        {
            <MudAlert Severity="Severity.Info">
                موردی مطابق فیلترهای ماتریس پیدا نشد.
            </MudAlert>
        }
        else
        {
            <MudTable Items="FilteredTestMatrixRows"
                      Dense="true"
                      Hover="true"
                      Striped="true"
                      Bordered="true"
                      FixedHeader="true"
                      Height="520px"
                      RowsPerPage="25">
                <HeaderContent>
                    <MudTh>آزمون</MudTh>
                    <MudTh>نتیجه</MudTh>
                    <MudTh>دسته‌بندی</MudTh>
                    <MudTh>ماتریس</MudTh>
                    <MudTh>نمونه استاندارد</MudTh>
                    <MudTh>مشتری</MudTh>
                    <MudTh>واحد</MudTh>
                    <MudTh>LOD</MudTh>
                    <MudTh>LOQ</MudTh>
                    <MudTh>Min</MudTh>
                    <MudTh>Max</MudTh>
                    <MudTh>منبع</MudTh>
                    <MudTh>عملیات</MudTh>
                </HeaderContent>

                <RowTemplate>
                    <MudTd DataLabel="آزمون">
                        <b>@context.TestCode</b><br />
                        @context.TestName
                    </MudTd>

                    <MudTd DataLabel="نتیجه">
                        @if (!string.IsNullOrWhiteSpace(context.ResultCode))
                        {
                            <b>@context.ResultCode</b><br />
                        }
                        @context.ResultName
                    </MudTd>

                    <MudTd DataLabel="دسته‌بندی">
                        @(context.CategoryName ?? "-")
                    </MudTd>

                    <MudTd DataLabel="ماتریس">
                        @(context.MatrixName ?? "-")
                    </MudTd>

                    <MudTd DataLabel="نمونه استاندارد">
                        @(context.StandardSampleName ?? "-")
                    </MudTd>

                    <MudTd DataLabel="مشتری">
                        @(context.CustomerName ?? "-")
                    </MudTd>

                    <MudTd DataLabel="واحد">
                        @(context.Unit ?? "-")
                    </MudTd>

                    <MudTd DataLabel="LOD">
                        @(context.LOD?.ToString("0.######") ?? "-")
                    </MudTd>

                    <MudTd DataLabel="LOQ">
                        @(context.LOQ?.ToString("0.######") ?? "-")
                    </MudTd>

                    <MudTd DataLabel="Min">
                        @(context.MinValue?.ToString("0.######") ?? "-")
                    </MudTd>

                    <MudTd DataLabel="Max">
                        @(context.MaxValue?.ToString("0.######") ?? "-")
                    </MudTd>

                    <MudTd DataLabel="منبع">
                        @context.Source
                    </MudTd>

                    <MudTd DataLabel="عملیات">
                        <MudButton Size="Size.Small"
                                   Variant="Variant.Text"
                                   Color="Color.Primary"
                                   OnClick="@(() => OpenResultSets(context.TestId))">
                            مشخصات آزمون
                        </MudButton>

                        <MudButton Size="Size.Small"
                                   Variant="Variant.Text"
                                   Color="Color.Warning"
                                   OnClick="@(() => OpenReferenceLimits(context.Test))">
                            حدود مجاز
                        </MudButton>
                    </MudTd>
                </RowTemplate>

                <PagerContent>
                    <MudTablePager RowsPerPageString="تعداد در صفحه"
                                   AllItemsText="همه"
                                   HorizontalAlignment="HorizontalAlignment.Right" />
                </PagerContent>
            </MudTable>
        }
    </MudPaper>

    <MudText Typo="Typo.h6" Class="mb-2">
        مدیریت پایه آزمون‌ها
    </MudText>

    <MudTextField T="string"
                  @bind-Value="SearchText"
                  Label="جستجو"
                  Placeholder="کد، نام یا نام انگلیسی..."
                  Variant="Variant.Outlined"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Immediate="true"
                  Clearable="true"
                  Class="mb-4" />

    @if (IsLoading)
    {
        <div class="d-flex justify-center pa-6">

            <MudProgressCircular Indeterminate="true"
                                 Color="Color.Primary" />

        </div>
    }
    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <MudAlert Severity="Severity.Error"
                  Class="mb-4">

            @ErrorMessage

        </MudAlert>
    }
    else if (FilteredTests.Count == 0)
    {
        <MudAlert Severity="Severity.Info">

            آزمونی یافت نشد.

        </MudAlert>
    }
    else
    {
        <MudTable Items="FilteredTests"
                  Hover="true"
                  Dense="true"
                  Striped="true"
                  Bordered="true"
                  RowsPerPage="25">

            <HeaderContent>

                <MudTh>
                    <MudTableSortLabel T="Test"
                                       SortBy="@(x => x.Code)">
                        کد
                    </MudTableSortLabel>
                </MudTh>

                <MudTh>
                    <MudTableSortLabel T="Test"
                                       SortBy="@(x => x.Name)">
                        نام
                    </MudTableSortLabel>
                </MudTh>

                <MudTh>
                    <MudTableSortLabel T="Test"
                                       SortBy="@(x => x.EnglishName)">
                        نام انگلیسی
                    </MudTableSortLabel>
                </MudTh>

                <MudTh>
                    <MudTableSortLabel T="Test"
                                       SortBy="@(x => x.Unit)">
                        واحد
                    </MudTableSortLabel>
                </MudTh>

                <MudTh>
                    <MudTableSortLabel T="Test"
                                       SortBy="@(x => x.IsQuantitative)">
                        نوع
                    </MudTableSortLabel>
                </MudTh>

                <MudTh>
                    <MudTableSortLabel T="Test"
                                       SortBy="@(x => x.IsActiveForReception)">
                        وضعیت پذیرش
                    </MudTableSortLabel>
                </MudTh>

                <MudTh>
                    <MudTableSortLabel T="Test"
                                       SortBy="@(x => x.LOD)">
                        LOD
                    </MudTableSortLabel>
                </MudTh>

                <MudTh>
                    <MudTableSortLabel T="Test"
                                       SortBy="@(x => x.LOQ)">
                        LOQ
                    </MudTableSortLabel>
                </MudTh>

                <MudTh>عملیات</MudTh>

            </HeaderContent>

            <RowTemplate>

                <MudTd>
                    @context.Code
                </MudTd>

                <MudTd>
                    @context.Name
                </MudTd>

                <MudTd>
                    @context.EnglishName
                </MudTd>

                <MudTd>
                    @context.Unit
                </MudTd>

                <MudTd>

                    @if (context.IsQuantitative)
                    {
                        <MudChip T="string"
                                 Color="Color.Primary"
                                 Size="Size.Small">
                            کمی
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string"
                                 Color="Color.Secondary"
                                 Size="Size.Small">
                            کیفی
                        </MudChip>
                    }

                </MudTd>

                <MudTd>

                    @if (context.IsActiveForReception)
                    {
                        <MudChip T="string"
                                 Color="Color.Success"
                                 Size="Size.Small">
                            فعال
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string"
                                 Color="Color.Default"
                                 Size="Size.Small">
                            غیرفعال
                        </MudChip>
                    }

                </MudTd>

                <MudTd>
                    @(context.LOD?.ToString() ?? "-")
                </MudTd>

                <MudTd>
                    @(context.LOQ?.ToString() ?? "-")
                </MudTd>

                <MudTd>

                    <MudButton Size="Size.Small"
                               Variant="Variant.Outlined"
                               Color="Color.Primary"
                               OnClick="@(() => OpenEdit(context))">

                        ویرایش

                    </MudButton>
                    <MudButton Size="Size.Small"
                               Variant="Variant.Outlined"
                               Color="Color.Info"
                               Class="ms-1"
                               OnClick="@(() => OpenReferenceLimits(context))">

                        حدود مجاز

                    </MudButton>
                    <MudButton Size="Size.Small"
                               Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               Class="ms-1"
                               OnClick="@(() => OpenResultSets(context))">

                        مجموعه‌های نتیجه

                    </MudButton>
                    @if (context.IsActiveForReception)
                    {
                        <MudButton Size="Size.Small"
                                   Variant="Variant.Text"
                                   Color="Color.Warning"
                                   Class="ms-1"
                                   OnClick="@(() => Deactivate(context.Id))">

                            غیرفعال کردن

                        </MudButton>
                    }
                    else
                    {
                        <MudButton Size="Size.Small"
                                   Variant="Variant.Text"
                                   Color="Color.Success"
                                   Class="ms-1"
                                   OnClick="@(() => Activate(context.Id))">

                            فعال کردن

                        </MudButton>
                    }

                    <MudButton Size="Size.Small"
                               Variant="Variant.Text"
                               Color="Color.Error"
                               Class="ms-1"
                               OnClick="@(() => Delete(context.Id))">

                        حذف

                    </MudButton>

                </MudTd>

            </RowTemplate>
            <PagerContent>
                <MudTablePager RowsPerPageString="تعداد در صفحه"
                               PageSizeOptions="@(new[] { 10, 25, 50, 100 })" />
            </PagerContent>
        </MudTable>
    }

</MudPaper>


@* ========================================================= *@
@* Create / Edit Dialog                                      *@
@* ========================================================= *@

<MudDialog @bind-Visible="DialogVisible">

    <DialogContent>

        <MudText Typo="Typo.h6"
                 Class="mb-4">

            @(IsEditMode ? "Edit Test" : "New Test")

        </MudText>

        <MudTextField T="string"
                      @bind-Value="Form.Code"
                      Label="کد"
                      Variant="Variant.Outlined"
                      Required="true"
                      ReadOnly="true"
                      Disabled="@IsSaving"
                      Class="mb-3" />

        <MudTextField T="string"
                      @bind-Value="Form.Name"
                      Label="نام"
                      Variant="Variant.Outlined"
                      Required="true"
                      Disabled="@IsSaving"
                      Class="mb-3" />

        <MudTextField T="string"
                      @bind-Value="Form.EnglishName"
                      Label="نام انگلیسی"
                      Variant="Variant.Outlined"
                      Disabled="@IsSaving"
                      Class="mb-3" />

        <MudSelect T="Guid?"
                   Label="بخش"
                   Variant="Variant.Outlined"
                   @bind-Value="Form.DepartmentId"
                   Disabled="@IsSaving"
                   Class="mb-3">

            @foreach (var department in Departments)
            {
                <MudSelectItem T="Guid?"
                               Value="@department.Id">

                    @department.Name

                </MudSelectItem>
            }

        </MudSelect>
        <MudSelect T="Guid?"
                   Label="کارشناس پیش‌فرض"
                   Variant="Variant.Outlined"
                   @bind-Value="Form.DefaultAnalystId"
                   Disabled="@IsSaving"
                   Class="mb-3">

            @foreach (var employee in Employees.Where(x => x.IsActive))
            {
                <MudSelectItem T="Guid?"
                               Value="@employee.Id">

                    @employee.FullName

                </MudSelectItem>
            }

        </MudSelect>

        <MudSelect T="Guid?"
                   Label="دسته‌بندی نمونه"
                   Variant="Variant.Outlined"
                   Value="Form.SampleCategoryId"
                   ValueChanged="OnSampleCategoryChanged"
                   Disabled="@IsSaving"
                   Class="mb-3">

            @foreach (var category in SampleCategories)
            {
                <MudSelectItem T="Guid?"
                               Value="@category.Id">

                    @category.Name

                </MudSelectItem>
            }

        </MudSelect>

        <MudSelect T="Guid?"
                   Label="ماتریس"
                   Variant="Variant.Outlined"
                   @bind-Value="Form.MatrixId"
                   Disabled="@IsSaving"
                   Class="mb-3">

            @foreach (var matrix in Matrices)
            {
                <MudSelectItem T="Guid?"
                               Value="@matrix.Id">

                    @matrix.Name

                </MudSelectItem>
            }

        </MudSelect>

        <MudTextField T="string"
                      @bind-Value="Form.Unit"
                      Label="واحد"
                      Variant="Variant.Outlined"
                      Disabled="@IsSaving"
                      Class="mb-3" />

        <MudTextField T="string"
                      @bind-Value="Form.Method"
                      Label="روش"
                      Variant="Variant.Outlined"
                      Disabled="@IsSaving"
                      Class="mb-3" />

        <MudTextField T="string"
                      @bind-Value="Form.InstrumentName"
                      Label="دستگاه"
                      Variant="Variant.Outlined"
                      Disabled="@IsSaving"
                      Class="mb-3" />

        <MudGrid>

            <MudItem xs="12" sm="6">

                <MudNumericField T="decimal?"
                                 @bind-Value="Form.LOD"
                                 Label="LOD (حد تشخیص)"
                                 Variant="Variant.Outlined"
                                 Disabled="@IsSaving" />

            </MudItem>

            <MudItem xs="12" sm="6">

                <MudNumericField T="decimal?"
                                 @bind-Value="Form.LOQ"
                                 Label="LOQ (حد تعیین مقدار)"
                                 Variant="Variant.Outlined"
                                 Disabled="@IsSaving" />

            </MudItem>

        </MudGrid>

        <MudTextField T="string"
                      @bind-Value="Form.DefaultResult"
                      Label="نتیجه پیش‌فرض"
                      Variant="Variant.Outlined"
                      Disabled="@IsSaving"
                      Class="mt-3 mb-3" />

        <MudCheckBox T="bool"
                     @bind-Value="Form.IsQuantitative"
                     Label="آزمون کمی"
                     Disabled="@IsSaving" />

        <MudCheckBox T="bool"
                     @bind-Value="Form.IsActiveForReception"
                     Label="قابل استفاده در پذیرش"
                     Disabled="@IsSaving" />

        <MudTextField T="string"
                      @bind-Value="Form.Description"
                      Label="توضیحات"
                      Variant="Variant.Outlined"
                      Lines="3"
                      Disabled="@IsSaving"
                      Class="mt-3" />

        @* ========================================================= *@
        @* Test Result Definitions                                  *@
        @* ========================================================= *@

        <MudDivider Class="my-4" />

        <MudText Typo="Typo.h6" Class="mb-3">
            تعریف نتایج
        </MudText>

        <div class="d-flex justify-space-between align-center mb-3">

            <MudText Typo="Typo.body2">
                تعریف خروجی‌های آزمون
            </MudText>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Disabled="@(!IsEditMode || IsSaving)"
                       OnClick="OpenCreateResultDefinition">

                افزودن نتیجه

            </MudButton>

        </div>

        @if (ResultDefinitions.Count == 0)
        {
            <MudAlert Severity="Severity.Info"
                      Variant="Variant.Outlined">

                برای این آزمون نتیجه تفصیلی تعریف نشده است.

            </MudAlert>
        }
        else
        {
            <MudTable Items="ResultDefinitions"
                      Dense="true"
                      Hover="true"
                      Bordered="true"
                      Striped="true">

                <HeaderContent>

                    <MudTh>ترتیب</MudTh>
                    <MudTh>کد</MudTh>
                    <MudTh>نام نتیجه</MudTh>
                    <MudTh>واحد</MudTh>
                    <MudTh>اجباری</MudTh>
                    <MudTh>اعشار</MudTh>
                    <MudTh>عملیات</MudTh>

                </HeaderContent>

                <RowTemplate>

                    <MudTd>
                        @context.DisplayOrder
                    </MudTd>

                    <MudTd>
                        @context.Code
                    </MudTd>

                    <MudTd>
                        @context.Name
                    </MudTd>

                    <MudTd>
                        @(context.Unit ?? "-")
                    </MudTd>

                    <MudTd>

                        @if (context.IsRequired)
                        {
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Color="Color.Success">
                                بله
                            </MudChip>
                        }
                        else
                        {
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Color="Color.Default">
                                خیر
                            </MudChip>
                        }

                    </MudTd>

                    <MudTd>
                        @(context.DecimalPlaces?.ToString() ?? "-")
                    </MudTd>

                    <MudTd>

                        <MudButton Size="Size.Small"
                                   Variant="Variant.Text"
                                   Color="Color.Primary"
                                   Disabled="@IsSaving"
                                   OnClick="@(() => OpenEditResultDefinition(context))">

                            ویرایش

                        </MudButton>

                        <MudButton Size="Size.Small"
                                   Variant="Variant.Text"
                                   Color="Color.Error"
                                   Disabled="@IsSaving"
                                   OnClick="@(() => DeleteResultDefinition(context.Id))">

                            حذف

                        </MudButton>

                    </MudTd>

                </RowTemplate>

            </MudTable>
        }

        @if (!string.IsNullOrWhiteSpace(DialogError))
        {
            <MudAlert Severity="Severity.Error"
                      Class="mt-4">

                @DialogError

            </MudAlert>
        }

    </DialogContent>

    <DialogActions>

        <MudButton Variant="Variant.Text"
                   Disabled="@IsSaving"
                   OnClick="CloseDialog">

            انصراف

        </MudButton>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="@IsSaving"
                   OnClick="SaveTest">

            @if (IsSaving)
            {
                <MudProgressCircular Size="Size.Small"
                                     Indeterminate="true"
                                     Class="me-2" />

                <span>در حال ذخیره...</span>
            }
            else
            {
                <span>ذخیره</span>
            }

        </MudButton>

    </DialogActions>

</MudDialog>

@* ========================================================= *@
@* Test Result Definition Dialog                          *@
@* ========================================================= *@

<MudDialog @bind-Visible="ResultDefinitionDialogVisible">

    <DialogContent>

        <MudTextField T="string"
                      @bind-Value="ResultDefinitionForm.Code"
                      Label="کد نتیجه"
                      Variant="Variant.Outlined"
                      Required="true"
                      Disabled="@IsSaving"
                      Class="mb-3"
                      ReadOnly="true" />

        <MudTextField T="string"
                      @bind-Value="ResultDefinitionForm.Name"
