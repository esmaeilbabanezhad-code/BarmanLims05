private async Task SaveEmployee()
{
formMessage = null;
if (string.IsNullOrWhiteSpace(PersonnelCode))
{
    formMessage = "کد پرسنلی الزامی است.";
    formMessageSeverity = Severity.Error;
    return;
}

if (string.IsNullOrWhiteSpace(FullName))
{
    formMessage = "نام و نام خانوادگی الزامی است.";
    formMessageSeverity = Severity.Error;
    return;
}

if (string.IsNullOrWhiteSpace(NationalCode))
{
    formMessage = "کد ملی الزامی است.";
    formMessageSeverity = Severity.Error;
    return;
}

if (employees.Any(x =>
    x.PersonnelCode.Equals(
        PersonnelCode.Trim(),
        StringComparison.OrdinalIgnoreCase)
    && x.Id != EditingId))
{
    formMessage = "این کد پرسنلی قبلاً ثبت شده است.";
    formMessageSeverity = Severity.Error;
    return;
}

try
{
    isSaving = true;

    if (EditingId == Guid.Empty)
    {
        var employee = new Employee
        {
            PersonnelCode = PersonnelCode.Trim(),
            FullName = FullName.Trim(),
            NationalCode = NationalCode.Trim(),

            Mobile = string.IsNullOrWhiteSpace(Mobile)
                ? null
                : Mobile.Trim(),

            Email = string.IsNullOrWhiteSpace(Email)
                ? null
                : Email.Trim(),

            CanApprove = CanApprove,
            CanReview = CanReview,
            IsSystemUser = IsSystemUser,
            IsActive = IsActive
        };

        await EmployeeService.CreateAsync(employee);

formMessage =
                    "کارمند با موفقیت ثبت شد.";

    }
    else
    {
        var employee =
            await EmployeeService.GetByIdAsync(EditingId);

        if (employee is null)
        {
            formMessage = "کارمند موردنظر پیدا نشد.";
            formMessageSeverity = Severity.Error;
            return;
        }

        employee.PersonnelCode = PersonnelCode.Trim();
        employee.FullName = FullName.Trim();
        employee.NationalCode = NationalCode.Trim();

        employee.Mobile = string.IsNullOrWhiteSpace(Mobile)
            ? null
            : Mobile.Trim();

        employee.Email = string.IsNullOrWhiteSpace(Email)
            ? null
            : Email.Trim();

        employee.CanApprove = CanApprove;
        employee.CanReview = CanReview;
        employee.IsSystemUser = IsSystemUser;
        employee.IsActive = IsActive;

        await EmployeeService.UpdateAsync(employee);

        formMessage =
                            "تغییرات کارمند با موفقیت ذخیره شد.";
    }

    formMessageSeverity = Severity.Success;

    await LoadEmployees();

    ClearForm();

    showForm = false;
}
catch (Exception ex)
{
    formMessage =
        $"خطا در ذخیره اطلاعات کارمند: {ex.Message}";

    formMessageSeverity = Severity.Error;
}
finally
{
    isSaving = false;
}
}
