@page "/employees"
@using Barman.Application.Interfaces
@using Barman.Domain.Entities
@using Barman.Application.Interfaces.Repositories
@using BarmanLims.Components.Shared
@using BarmanLims.Components.Authorization
@attribute [RequirePermission("Employee.View")]

@inject IDepartmentRepository DepartmentRepository
@inject IEmployeeService EmployeeService
@inject IDepartmentService DepartmentService
@inject IDepartmentResponsibilityService DepartmentResponsibilityService
@inject ITechnicalManagerSectionHeadService TechnicalManagerSectionHeadService
@inject IEmployeeTechnicalManagerScopeService EmployeeTechnicalManagerScopeService
@inject ITechnicalManagerScopeService TechnicalManagerScopeService
@inject IGenericRepository<Role> RoleRepository
@inject IPermissionService PermissionService
@inject Barman.Application.Interfaces.ICurrentUserService CurrentUserService
@inject NavigationManager NavigationManager


<PageTitle>مدیریت کارکنان</PageTitle>
<MudContainer MaxWidth="MaxWidth.Large" Class="pa-4">
   
    <PermissionView Permission="Employee.View"> 
<MudPaper Class="pa-5">
<MudText Typo="Typo.h5" Class="mb-4">
    مدیریت کارکنان
</MudText>

@if (!showForm && CanCreate)
{
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.PersonAdd"
               OnClick="ShowAddForm">

        افزودن کارمند

    </MudButton>
}

@if (showForm)
{
    <MudPaper Outlined="true" Class="pa-4 mt-4">

        <MudText Typo="Typo.h6" Class="mb-4">
            @(EditingId == Guid.Empty
                  ? "افزودن کارمند جدید"
                : "ویرایش کارمند")
        </MudText>

        <MudGrid>

            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="PersonnelCode"
                              Label="کد پرسنلی"
                              Variant="Variant.Outlined"
                              Required="true" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="FullName"
                              Label="نام و نام خانوادگی"
                              Variant="Variant.Outlined"
                              Required="true" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="NationalCode"
                              Label="کد ملی"
                              Variant="Variant.Outlined"
                              Required="true" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="Mobile"
                              Label="موبایل"
                              Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="12">
                <MudTextField @bind-Value="Email"
                              Label="ایمیل"
                              Variant="Variant.Outlined"
                              InputType="InputType.Email" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="Guid?"
                               @bind-Value="selectedDepartmentId"
                               Label="بخش"
                               Variant="Variant.Outlined"
                               Clearable="true">

                @foreach (var department in departments)
                    {
                            <MudSelectItem T="Guid?"
                                           Value="@((Guid?)department.Id)">
                                @department.Name
                            </MudSelectItem>
                    }

                </MudSelect>
            </MudItem>

                <MudItem xs="12" sm="3">
                    <MudCheckBox @bind-Value="departmentIsPrimary"
                                 Label="بخش اصلی" />
                </MudItem>

                <MudItem xs="12" sm="2">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               Class="mt-2"
                               OnClick="AddDepartmentToEmployee"
                               Disabled="@isSaving">
                        افزودن
                    </MudButton>
                </MudItem>

                <MudItem xs="12" sm="7">
                    <MudSelect T="Guid?"
                               @bind-Value="selectedRoleId"
                               Label="نقش"
                               Variant="Variant.Outlined"
                               Clearable="true">

                        @foreach (var role in roles)
                        {
                            <MudSelectItem T="Guid?"
                                           Value="@((Guid?)role.Id)">
                                @role.Name
                            </MudSelectItem>
                        }

                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="3">
                    <MudCheckBox @bind-Value="roleIsPrimary"
                                 Label="نقش اصلی" />
                </MudItem>

                <MudItem xs="12" sm="2">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               Class="mt-2"
                               OnClick="AddRoleToEmployee"
                               Disabled="@isSaving">
                        افزودن
                    </MudButton>
                </MudItem>


                @if (EditingId != Guid.Empty)
                {
                    @if (employeeRoles.Any())
                    {
                        <MudPaper Outlined="true" Class="pa-4 mt-4">

                            <MudText Typo="Typo.h6" Class="mb-3">
                                نقش‌های کارمند
                            </MudText>

                            <MudTable Items="employeeRoles"
                                      Dense="true"
                                      Hover="true"
                                      Bordered="true">

                                <HeaderContent>
                                    <MudTh>نقش</MudTh>
                                    <MudTh>وضعیت</MudTh>
                                    <MudTh>عملیات</MudTh>
                                </HeaderContent>

                                <RowTemplate>
                                    <MudTd>
                                        @context.Role?.Name
                                    </MudTd>

                                    <MudTd>
                                        @if (context.IsPrimary)
                                        {
                                            <MudChip T="string"
                                                     Color="Color.Success"
                                                     Size="Size.Small">
                                                اصلی
                                            </MudChip>
                                        }
                                        else
                                        {
                                            <MudChip T="string"
                                                     Color="Color.Default"
                                                     Size="Size.Small">
                                                عادی
                                            </MudChip>
                                        }
                                    </MudTd>

                                    <MudTd>
                                        @if (!context.IsPrimary)
                                        {
                                            <MudButton Size="Size.Small"
                                                       Variant="Variant.Outlined"
                                                       Color="Color.Primary"
                                                       Class="mr-2"
                                                       OnClick="@(() => SetPrimaryRoleFromEmployee(context.Id))"
                                                       Disabled="@isSaving">
                                                اصلی کردن
                                            </MudButton>
                                        }

                                        <MudButton Size="Size.Small"
                                                   Variant="Variant.Outlined"
                                                   Color="Color.Error"
                                                   OnClick="@(() => RemoveRoleFromEmployee(context.Id))"
                                                   Disabled="@isSaving">
                                            حذف
                                        </MudButton>
                                    </MudTd>
                                </RowTemplate>

                            </MudTable>

                        </MudPaper>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Class="mt-4">
                            هنوز نقشی برای این کارمند ثبت نشده است.
                        </MudAlert>
                    }
                }

                @* =========================================================
                   مسئولیت‌های سازمانی
                   ========================================================= *@

                @if (EditingId != Guid.Empty)
                {
                    @if (employeeDepartments.Any())
                    {
                        <MudPaper Outlined="true" Class="pa-4 mt-4">

                            <MudText Typo="Typo.h6" Class="mb-3">
                                بخش‌های کارمند
                            </MudText>

                            <MudTable Items="employeeDepartments"
                                      Dense="true"
                                      Hover="true"
                                      Bordered="true">

                                <HeaderContent>
                                    <MudTh>بخش</MudTh>
                                    <MudTh>وضعیت</MudTh>
                                    <MudTh>عملیات</MudTh>
                                </HeaderContent>

                                <RowTemplate>

                                    <MudTd>
                                        @context.Department?.Name
                                    </MudTd>

                                    <MudTd>
                                        @if (context.IsPrimary)
                                        {
                                            <MudChip T="string"
                                                     Color="Color.Success"
                                                     Size="Size.Small">
                                                اصلی
                                            </MudChip>
                                        }
                                        else
                                        {
                                            <MudChip T="string"
                                                     Color="Color.Default"
                                                     Size="Size.Small">
                                                عادی
                                            </MudChip>
                                        }
                                    </MudTd>

                                    <MudTd>
                                        @if (!context.IsPrimary)
                                        {
                                            <MudButton Size="Size.Small"
                                                       Variant="Variant.Outlined"
                                                       Color="Color.Primary"
                                                       Class="mr-2"
                                                       OnClick="@(() => SetPrimaryDepartmentFromEmployee(context.Id))"
                                                       Disabled="@isSaving">
                                                اصلی کردن
                                            </MudButton>
                                        }

                                        <MudButton Size="Size.Small"
                                                   Variant="Variant.Outlined"
                                                   Color="Color.Error"
                                                   OnClick="@(() => RemoveDepartmentFromEmployee(context.Id))"
                                                   Disabled="@isSaving">
                                            حذف
                                        </MudButton>
                                    </MudTd>

                                </RowTemplate>

                            </MudTable>

                        </MudPaper>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Class="mt-4">
                            هنوز بخشی برای این کارمند ثبت نشده است.
                        </MudAlert>
                    }
                }

                <MudPaper Outlined="true" Class="pa-4 mt-5">

                    <MudText Typo="Typo.h6" Class="mb-3">
                        مسئولیت‌های سازمانی
                    </MudText>

                    @if (EditingId != Guid.Empty)
                    {
                        <MudGrid>

                            <MudItem xs="12" sm="5">
                                <MudSelect T="Guid?"
                                           @bind-Value="selectedResponsibilityDepartmentId"
                                           Label="انتخاب بخش"
                                           Variant="Variant.Outlined"
                                           Clearable="true">
                                    @foreach (var employeeDepartment in employeeDepartments)
                                    {
                                        <MudSelectItem T="Guid?"
                                                       Value="@((Guid?)employeeDepartment.DepartmentId)">
                                            @employeeDepartment.Department?.Name
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>

                            <MudItem xs="12" sm="4">
                                <MudSelect T="DepartmentResponsibilityType"
                                           @bind-Value="selectedResponsibilityType"
                                           Label="نوع مسئولیت"
                                           Variant="Variant.Outlined">
                                    <MudSelectItem Value="DepartmentResponsibilityType.TechnicalManager">
                                        مسئول فنی
                                    </MudSelectItem>
                                    <MudSelectItem Value="DepartmentResponsibilityType.SectionHead">
                                        مسئول بخش
                                    </MudSelectItem>
                                </MudSelect>
                            </MudItem>

                            <MudItem xs="12" sm="2">
                                <MudCheckBox @bind-Value="responsibilityIsPrimary"
                                             Label="مسئول اصلی" />
                            </MudItem>

                            <MudItem xs="12" sm="1">
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           FullWidth="true"
                                           Class="mt-2"
                                           OnClick="AddResponsibilityToEmployee"
                                           Disabled="@isSaving">
                                    افزودن
                                </MudButton>
                            </MudItem>

                        </MudGrid>

                        @if (employeeResponsibilities.Any())
                        {
                            <MudTable Items="employeeResponsibilities"
                                      Dense="true"
                                      Hover="true"
                                      Bordered="true"
                                      Class="mt-4">
                                <HeaderContent>
                                    <MudTh>بخش</MudTh>
                                    <MudTh>نوع مسئولیت</MudTh>
                                    <MudTh>وضعیت</MudTh>
                                    <MudTh>اصلی</MudTh>
                                    <MudTh>عملیات</MudTh>
                                </HeaderContent>

                                <RowTemplate>
                                    <MudTd>@context.Department?.Name</MudTd>

                                    <MudTd>
                                        @if (context.ResponsibilityType ==
                                            DepartmentResponsibilityType.TechnicalManager)
                                        {
                                            <MudChip T="string" Size="Size.Small">
                                                مسئول فنی
                                            </MudChip>
                                        }
                                        else
                                        {
                                            <MudChip T="string" Size="Size.Small">
                                                مسئول بخش
                                            </MudChip>
                                        }
                                    </MudTd>

                                    <MudTd>
                                        @if (context.IsActive)
                                        {
                                            <MudChip T="string"
                                                     Color="Color.Success"
                                                     Size="Size.Small">
                                                فعال
                                            </MudChip>
                                        }
                                        else
                                        {
                                            <MudChip T="string"
                                                     Color="Color.Default"
                                                     Size="Size.Small">
                                                غیرفعال
                                            </MudChip>
                                        }
                                    </MudTd>

                                    <MudTd>
                                        @if (context.IsPrimary)
                                        {
                                            <MudChip T="string"
                                                     Color="Color.Success"
                                                     Size="Size.Small">
                                                اصلی
                                            </MudChip>
                                        }
                                        else
                                        {
                                            <MudChip T="string"
                                                     Color="Color.Default"
                                                     Size="Size.Small">
                                                عادی
                                            </MudChip>
                                        }
                                    </MudTd>

                                    <MudTd>
                                        <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                                                     Size="Size.Small"
                                                     Dense="true">

                                            <MudMenuItem OnClick="@(() => EditResponsibility(context))">
                                                    ویرایش
                                            </MudMenuItem>
                                            
                                            <MudMenuItem OnClick="@(() => RemoveResponsibilityFromEmployee(context.Id))">
                                                    حذف
                                            </MudMenuItem>
                                            
                                        </MudMenu>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info" Class="mt-4">
                                هنوز مسئولیتی برای این کارمند ثبت نشده است.
                            </MudAlert>
                        }
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info">
                            پس از ذخیره کارمند، می‌توانید مسئولیت‌های سازمانی او را ثبت کنید.
                        </MudAlert>
                    }
                </MudPaper>
                        <MudPaper Outlined="true" Class="pa-4 mt-5">

                            <MudText Typo="Typo.h6" Class="mb-3">
                                محدوده‌های مسئول فنی
                            </MudText>

                            @if (EditingId != Guid.Empty)
                            {
                                <MudGrid>

                                    <MudItem xs="12" sm="6">
                                        <MudSelect T="Guid?"
                                                   @bind-Value="selectedTechnicalManagerScopeId"
                                                   Label="محدوده مسئول فنی"
                                                   Variant="Variant.Outlined"
                                                   Clearable="true">

                                            @foreach (var scope in technicalManagerScopes)
                                            {
                                                <MudSelectItem T="Guid?"
                                                               Value="@((Guid?)scope.Id)">
                                                    @scope.Name
                                                </MudSelectItem>
                                            }

                                        </MudSelect>
                                    </MudItem>

                                    <MudItem xs="12" sm="2">
                                        <MudCheckBox @bind-Value="technicalManagerScopeIsPrimary"
                                                     Label="اصلی" />
                                    </MudItem>

                                    <MudItem xs="12" sm="4">
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Primary"
                                                   FullWidth="true"
                                                   Class="mt-2"
                                                   OnClick="AddTechnicalManagerScopeToEmployee"
                                                   Disabled="@isSaving">
                                            افزودن محدوده
                                        </MudButton>
                                    </MudItem>

                                </MudGrid>

                                @if (employeeTechnicalManagerScopes.Any())
                                {
                                    <MudTable Items="employeeTechnicalManagerScopes"
                                              Dense="true"
                                              Hover="true"
                                              Bordered="true"
                                              Class="mt-4">

                                        <HeaderContent>
                                            <MudTh>کد</MudTh>
                                            <MudTh>محدوده</MudTh>
                                            <MudTh>وضعیت</MudTh>
                                            <MudTh>اصلی</MudTh>
                                            <MudTh>عملیات</MudTh>
                                        </HeaderContent>

                                        <RowTemplate>
                                            <MudTd>@context.TechnicalManagerScope?.Code</MudTd>
                                            <MudTd>@context.TechnicalManagerScope?.Name</MudTd>

                                            <MudTd>
                                                @if (context.IsActive)
                                                {
                                                    <MudChip T="string"
                                                             Color="Color.Success"
                                                             Size="Size.Small">
                                                        فعال
                                                    </MudChip>
                                                }
                                                else
                                                {
                                                    <MudChip T="string"
                                                             Color="Color.Default"
                                                             Size="Size.Small">
                                                        غیرفعال
                                                    </MudChip>
                                                }
                                            </MudTd>

                                            <MudTd>
                                                @if (context.IsPrimary)
                                                {
                                                    <MudChip T="string"
                                                             Color="Color.Success"
                                                             Size="Size.Small">
                                                        اصلی
                                                    </MudChip>
                                                }
                                                else
                                                {
                                                    <MudChip T="string"
                                                             Color="Color.Default"
                                                             Size="Size.Small">
                                                        عادی
                                                    </MudChip>
                                                }
                                            </MudTd>

                                            <MudTd>

                                                <MudButton Size="Size.Small"
                                                           Variant="Variant.Outlined"
                                                           Color="Color.Primary"
                                                           Class="mr-2"
                                                           OnClick="@(() => EditTechnicalManagerScope(context))"
                                                           Disabled="@isSaving">
                                                    ویرایش
                                                </MudButton>

                                                @if (context.IsActive)
                                                {
                                                    <MudButton Size="Size.Small"
                                                               Variant="Variant.Outlined"
                                                               Color="Color.Warning"
                                                               OnClick="@(() => RemoveTechnicalManagerScopeFromEmployee(context.Id))"
                                                               Disabled="@isSaving">
                                                        غیرفعال
                                                    </MudButton>
                                                }
                                                else
                                                {
                                                    <MudButton Size="Size.Small"
                                                               Variant="Variant.Outlined"
                                                               Color="Color.Success"
                                                               OnClick="@(() => ActivateTechnicalManagerScopeForEmployee(context.Id))"
                                                               Disabled="@isSaving">
                                                        فعال‌سازی
                                                    </MudButton>
                                                }

                                            </MudTd>
                                        </RowTemplate>

                                    </MudTable>
                                }
                                else
                                {
                                    <MudAlert Severity="Severity.Info" Class="mt-4">
                                        هنوز محدوده‌ای برای این کارمند ثبت نشده است.
                                    </MudAlert>
                                }
                            }
                            else
                            {
                                <MudAlert Severity="Severity.Info">
                                    پس از ذخیره کارمند، می‌توانید محدوده مسئول فنی او را ثبت کنید.
                                </MudAlert>
                            }

                        </MudPaper>
            <MudItem xs="12" sm="4">
                <MudCheckBox @bind-Value="CanApprove"
                             Label="قابل تأیید" />
            </MudItem>

            <MudItem xs="12" sm="4">
                <MudCheckBox @bind-Value="CanReview"
                             Label="قابل بازبینی" />
            </MudItem>

            <MudItem xs="12" sm="4">
                <MudCheckBox @bind-Value="IsSystemUser"
                             Label="کاربر سیستم" />
            </MudItem>

            <MudItem xs="12">
                <MudCheckBox @bind-Value="IsActive"
                                     Label="کارمند فعال" />
            </MudItem>

        </MudGrid>

        @if (!string.IsNullOrWhiteSpace(formMessage))
        {
            <MudAlert Severity="@formMessageSeverity"
                      Class="mt-4">

                @formMessage

            </MudAlert>
        }

        <div class="mt-4">

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SaveEmployee"
                       Disabled="@isSaving">

                @(isSaving
                    ? "در حال ذخیره..."
                    : (EditingId == Guid.Empty
                        ? "ذخیره کارمند"
                        : "ذخیره تغییرات"))

            </MudButton>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       Class="mr-2"
                       OnClick="CancelForm"
                       Disabled="@isSaving">

               انصراف

            </MudButton>

        </div>

    </MudPaper>
}
</MudPaper>
<MudPaper Class="pa-5 mt-5">
<MudText Typo="Typo.h6" Class="mb-3">
            فهرست کارکنان
</MudText>

@if (isLoading)
{
    <MudProgressLinear Indeterminate="true"
                       Color="Color.Primary"
                       Class="mb-4" />
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <MudAlert Severity="Severity.Error"
              Class="mb-4">

        @errorMessage

    </MudAlert>
}

<MudButton Variant="Variant.Outlined"
           Color="Color.Primary"
           StartIcon="@Icons.Material.Filled.Refresh"
           OnClick="LoadEmployees"
           Disabled="@isLoading">

    بازخوانی

</MudButton>

<MudTable Items="employees"
          Dense="true"
          Hover="true"
          Bordered="true"
          Striped="true"
          Class="mt-4">

    <HeaderContent>

        <MudTh>کد پرسنلی</MudTh>
        <MudTh>نام و نام خانوادگی</MudTh>
        <MudTh>نقش / نقش اصلی</MudTh>
        <MudTh>بخش / بخش اصلی</MudTh>
        <MudTh>کد ملی</MudTh>
        <MudTh>موبایل</MudTh>
        <MudTh>تأیید</MudTh>
        <MudTh>بازبینی</MudTh>
        <MudTh>کاربر سیستم</MudTh>
        <MudTh>وضعیت</MudTh>
        <MudTh>عملیات</MudTh>

    </HeaderContent>

    <RowTemplate>

        <MudTd DataLabel="کد پرسنلی">
            @context.PersonnelCode
        </MudTd>

        <MudTd DataLabel="نام و نام خانوادگی">
            @context.FullName
        </MudTd>

        <MudTd DataLabel="نقش / نقش اصلی">
            @if (employeeRolesMap.TryGetValue(context.Id, out var rolesForEmployee)
                && rolesForEmployee.Any())
            {
                @foreach (var item in rolesForEmployee)
                {
                    <div class="mb-1">
                        <span>@item.Role?.Name</span>
                        @if (item.IsPrimary)
                        {
                            <MudChip T="string"
                                     Color="Color.Success"
                                     Size="Size.Small"
                                     Class="mr-1">
                                اصلی
                            </MudChip>
                        }
                    </div>
                }
            }
            else
            {
                <span>-</span>
            }
        </MudTd>

        <MudTd DataLabel="بخش / بخش اصلی">
            @if (employeeDepartmentsMap.TryGetValue(context.Id, out var departmentsForEmployee)
                && departmentsForEmployee.Any())
            {
                @foreach (var item in departmentsForEmployee)
                {
                    <div class="mb-1">
                        <span>@item.Department?.Name</span>
                        @if (item.IsPrimary)
                        {
                            <MudChip T="string"
                                     Color="Color.Success"
                                     Size="Size.Small"
                                     Class="mr-1">
                                اصلی
                            </MudChip>
                        }
                    </div>
                }
            }
            else
            {
                <span>-</span>
            }
        </MudTd>

        <MudTd DataLabel="کد ملی">
            @context.NationalCode
        </MudTd>

        <MudTd DataLabel="موبایل">
            @(context.Mobile ?? "-")
        </MudTd>

        <MudTd DataLabel="تأیید">
            @(context.CanApprove ? "بله" : "خیر")
        </MudTd>

        <MudTd DataLabel="بازبینی">
            @(context.CanReview ? "بله" : "خیر")
        </MudTd>

        <MudTd DataLabel="کاربر سیستم">
            @(context.IsSystemUser ? "بله" : "خیر")
        </MudTd>

        <MudTd DataLabel="وضعیت">

            @if (context.IsActive)
            {
                <MudChip T="string"
                         Color="Color.Success"
                         Size="Size.Small">

                            فعال

                </MudChip>
