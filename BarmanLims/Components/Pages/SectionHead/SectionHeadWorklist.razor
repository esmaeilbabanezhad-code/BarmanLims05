    private async Task AssignDisplayGroupToAnalyst(
        AssignmentDisplayGroup group)
    {
        try
        {
            ErrorMessage = "";

            var assignments = group.Assignments
                .Where(x => x.Id != Guid.Empty)
                .ToList();

            if (assignments.Count == 0)
            {
                ErrorMessage =
                    "برای این Panel آزمونی برای تخصیص وجود ندارد.";

                return;
            }

            var withoutAnalyst = assignments
                .Where(x =>
                    !x.AnalystId.HasValue ||
                    x.AnalystId.Value == Guid.Empty)
                .ToList();

            if (withoutAnalyst.Count > 0)
            {
                var testNames = string.Join(
                    "، ",
                    withoutAnalyst.Select(x =>
                        string.IsNullOrWhiteSpace(x.Test?.Name)
                            ? x.Test?.Code
                            : $"{x.Test.Code} - {x.Test.Name}"));

                ErrorMessage =
                    "برای همه آزمون‌های Panel باید کارشناس تعیین شود." +
                    Environment.NewLine +
                    $"آزمون‌های بدون کارشناس: {testNames}";

                return;
            }

            foreach (var assignment in assignments)
            {
                await TestAssignmentService
                    .AssignToAnalystAsync(
                        assignment.Id,
                        assignment.AnalystId);
            }

            foreach (var assignment in assignments)
            {
                Assignments.Remove(assignment);
            }

            SelectedDisplayGroupKeys.Remove(
                GetDisplayGroupKey(group));

            ExpandedDisplayGroupKeys.Remove(
                GetDisplayGroupKey(group));

            StateHasChanged();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }


