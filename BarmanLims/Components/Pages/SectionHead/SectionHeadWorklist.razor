@page "/section-head/worklist"

@using Barman.Domain.Entities
@using Barman.Application.Services

@inject TestAssignmentService TestAssignmentService

<PageTitle>کارتابل بخش</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-4">

    <MudPaper Class="pa-4">

        <MudText Typo="Typo.h5" Class="mb-4">
            کارتابل بخش
        </MudText>

        <MudGrid Class="mb-4">

            <MudItem xs="12" md="6">

                <MudSelect T="Guid?"
                           Label="انتخاب بخش"
                           Variant="Variant.Outlined"
                           Clearable="true"
                           Dense="true"
                           Value="SelectedDepartmentId"
                           ValueChanged="OnDepartmentChanged">

                    @foreach (var department in Departments)
                    {
                        <MudSelectItem T="Guid?"
                                       Value="@((Guid?)department.Id)">
                            @department.Name
                        </MudSelectItem>
                    }

                </MudSelect>

            </MudItem>

        </MudGrid>

        @if (IsLoading)
        {
            <MudProgressLinear Indeterminate="true"
                               Color="Color.Primary" />
        }
        else if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <MudAlert Severity="Severity.Error">
                @ErrorMessage
            </MudAlert>
        }
        else if (!SelectedDepartmentId.HasValue)
        {
            <MudAlert Severity="Severity.Info">
                ابتدا بخش را انتخاب کنید.
            </MudAlert>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mb-3">
                تعداد آزمون‌های در انتظار بخش:
                <b>@Assignments.Count</b>
            </MudText>

            <MudTable Items="Assignments"
                      Dense="true"
                      Hover="true"
                      Striped="true"
                      Bordered="true">

                <HeaderContent>

                    <MudTh>نمونه</MudTh>
                    <MudTh>کد آزمون</MudTh>
                    <MudTh>نام آزمون</MudTh>
                    <MudTh>بخش</MudTh>
                    <MudTh>وضعیت</MudTh>

                </HeaderContent>

                <RowTemplate>

                    <MudTd DataLabel="نمونه">
                        @context.Sample?.SampleCode
                    </MudTd>

                    <MudTd DataLabel="کد آزمون">
                        @context.Test?.Code
                    </MudTd>

                    <MudTd DataLabel="نام آزمون">
                        @context.Test?.Name
                    </MudTd>

                    <MudTd DataLabel="بخش">
                        @(context.Department?.Name ?? "-")
                    </MudTd>

                    <MudTd DataLabel="وضعیت">

                        <MudChip T="string"
                                 Color="Color.Warning"
                                 Size="Size.Small">
                            در انتظار بررسی بخش
                        </MudChip>

                    </MudTd>

                </RowTemplate>

                <NoRecordsContent>

                    <MudAlert Severity="Severity.Info">
                        آزمونی در انتظار بررسی بخش وجود ندارد.
                    </MudAlert>

                </NoRecordsContent>

            </MudTable>
        }

    </MudPaper>

</MudContainer>

@code {

    private List<TestAssignment> Assignments = new();

    private List<Department> Departments = new();

    private Guid? SelectedDepartmentId;

    private bool IsLoading = false;

    private string ErrorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Departments =
                await TestAssignmentService
                    .GetDepartmentsAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
            Departments = new();
        }
    }

    private async Task OnDepartmentChanged(Guid? departmentId)
    {
        SelectedDepartmentId = departmentId;

        Assignments = new();

        if (!departmentId.HasValue)
            return;

        try
        {
            IsLoading = true;
            ErrorMessage = "";

            Assignments =
                await TestAssignmentService
                    .GetPendingForSectionHeadAsync(
                        departmentId.Value);
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
            Assignments = new();
        }
        finally
        {
            IsLoading = false;
        }
    }
}