    private IEnumerable<ResultApprovalDisplayGroup>
    FilteredResultApprovalDisplayGroups
    {
        get
        {
            IEnumerable<ResultApprovalDisplayGroup> query =
                ResultApprovalDisplayGroups;

            if (!string.IsNullOrWhiteSpace(ResultApprovalSearchText))
            {
                var search =
                    ResultApprovalSearchText.Trim();

                query = query.Where(x =>
                    (x.SampleCode?.Contains(
                        search,
                        StringComparison.OrdinalIgnoreCase) ?? false)
                    ||
                    (x.PanelCode?.Contains(
                        search,
                        StringComparison.OrdinalIgnoreCase) ?? false)
                    ||
                    (x.PanelName?.Contains(
                        search,
                        StringComparison.OrdinalIgnoreCase) ?? false)
                    ||
                    x.Assignments.Any(a =>
                        (a.Test?.Code?.Contains(
                            search,
                            StringComparison.OrdinalIgnoreCase) ?? false)
                        ||
                        (a.Test?.Name?.Contains(
                            search,
                            StringComparison.OrdinalIgnoreCase) ?? false)));
            }

            if (ResultStatusFilter != "همه")
            {
                query = query.Where(group =>
                {
                    var status =
                        GetDisplayGroupResultStatus(group);

                    return ResultStatusFilter switch
                    {
                        "رد" =>
                            status == ResultSetStatus.OutOfLimit,

                        "پاس" =>
                            status == ResultSetStatus.Normal,

                        "بدون حدود مجاز" =>
                            status == ResultSetStatus.NoApplicableLimit,

                        "بدون نتیجه" =>
                            status == ResultSetStatus.NoResult,

                        "نتیجه ناقص" =>
                            status == ResultSetStatus.Incomplete,

                        _ => true
                    };
                });
            }

            if (ProposalFilter == "دارای پیشنهاد")
            {
                query = query.Where(group =>
                    group.Assignments.Any(x =>
                        LimitChangeRequests.Any(r =>
                            r.TestAssignmentId == x.Id &&
                            r.Status == TestLimitChangeRequestStatus.Pending &&
                            !r.IsDeleted)));
            }
            else if (ProposalFilter == "بدون پیشنهاد")
            {
                query = query.Where(group =>
                    !group.Assignments.Any(x =>
                        LimitChangeRequests.Any(r =>
                            r.TestAssignmentId == x.Id &&
                            r.Status == TestLimitChangeRequestStatus.Pending &&
                            !r.IsDeleted)));
            }

            return query;
        }
    }

