    protected override async Task OnInitializedAsync()
    {
        try
        {
            var employeeId = CurrentUserService.EmployeeId;

            if (!employeeId.HasValue || employeeId.Value == Guid.Empty)
            {
                throw new InvalidOperationException(
                    "کاربر جاری به یک کارمند معتبر متصل نیست.");
            }

            var responsibilities =
                await DepartmentResponsibilityService
                    .GetByEmployeeIdAsync(employeeId.Value);

            CurrentUserDepartmentIds =
                responsibilities
                    .Where(x =>
                        x.ResponsibilityType ==
                            DepartmentResponsibilityType.SectionHead &&
                        x.IsActive &&
                        !x.IsDeleted)
                    .Select(x => x.DepartmentId)
                    .Distinct()
                    .ToList();

            Departments =
                (await TestAssignmentService
                    .GetDepartmentsAsync())
                .Where(x =>
                    CurrentUserDepartmentIds.Contains(x.Id))
                .ToList();

            if (Departments.Count == 1)
            {
                SelectedDepartmentId = Departments[0].Id;

                await OnDepartmentChanged(
                    SelectedDepartmentId);
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
            Departments = new();
            CurrentUserDepartmentIds = new();
        }
    }

    private async Task OnDepartmentChanged(Guid? departmentId)
    {
        SelectedDepartmentId = departmentId;

        Assignments = new();
        LimitChangeRequests = new();
        PendingResultApprovals = new();

        if (!departmentId.HasValue)
            return;

        try
        {
            IsLoading = true;
            ErrorMessage = "";

            Assignments =
                await TestAssignmentService
                    .GetPendingForSectionHeadAsync(
                        departmentId.Value);
            PendingResultApprovals =
            await TestAssignmentService
          .GetPendingResultApprovalForSectionHeadAsync(
            departmentId.Value);

            var statuses =
    await TestAssignmentService
        .GetResultSetStatusesAsync(
            PendingResultApprovals);

            ResultApprovalStatuses = new();

            foreach (var statusDto in statuses)
            {
                var status =
                    statusDto.IsOutOfLimit
                        ? ResultSetStatus.OutOfLimit
                        : statusDto.HasNoResult
                            ? ResultSetStatus.NoResult
                            : statusDto.IsIncomplete
                                ? ResultSetStatus.Incomplete
                                : statusDto.HasNoApplicableLimit
                                    ? ResultSetStatus.NoApplicableLimit
                                    : ResultSetStatus.Normal;

                ResultApprovalStatuses[statusDto.AssignmentId] =
                    new ResultApprovalStatusInfo
                    {
                        AssignmentId = statusDto.AssignmentId,
                        Status = status,
                        ResultCount = statusDto.ResultCount,
                        RequiredResultCount = statusDto.RequiredResultCount,
                        OutOfLimitCount = statusDto.OutOfLimitCount,
                        HasAnyLimit = statusDto.HasAnyLimit
                    };
            }

            // Legacy single-result assignments
            foreach (var assignment in PendingResultApprovals
                .Where(x =>
                    !x.TestResultSetId.HasValue ||
                    x.TestResultSetId.Value == Guid.Empty))
            {
                var resultInfo =
                    new ResultApprovalStatusInfo
                    {
                        AssignmentId = assignment.Id,
                        ResultCount =
                            string.IsNullOrWhiteSpace(assignment.Result)
                                ? 0
                                : 1,
                        RequiredResultCount = 1,
                        OutOfLimitCount =
                            !string.IsNullOrWhiteSpace(assignment.Result) &&
                            TestAssignmentService.IsResultOutOfLimit(assignment)
                                ? 1
                                : 0,
                        HasAnyLimit =
                            TestAssignmentService.GetApplicableLimitRule(assignment) is not null ||
                            TestAssignmentService.GetApplicableReferenceLimit(assignment) is not null
                    };

                resultInfo.Status =
                    resultInfo.ResultCount == 0
                        ? ResultSetStatus.NoResult
                        : resultInfo.OutOfLimitCount > 0
                            ? ResultSetStatus.OutOfLimit
                            : !resultInfo.HasAnyLimit
                                ? ResultSetStatus.NoApplicableLimit
                                : ResultSetStatus.Normal;

                ResultApprovalStatuses[assignment.Id] =
                    resultInfo;
            }

            await LoadAnalysts(departmentId.Value);

            LimitChangeRequests =
              await TestLimitChangeRequestService
             .GetPendingForSectionHeadAsync(
               departmentId.Value);
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
            Assignments = new();
        }
        finally
        {
            IsLoading = false;
        }
    }
