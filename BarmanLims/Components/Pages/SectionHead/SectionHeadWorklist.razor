        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }
    private class ResultApprovalStatusInfo
    {
        public Guid AssignmentId { get; set; }

        public ResultSetStatus Status { get; set; }

        public int ResultCount { get; set; }

        public int RequiredResultCount { get; set; }

        public int OutOfLimitCount { get; set; }

        public bool HasAnyLimit { get; set; }

        public string Summary =>
            Status switch
            {
                ResultSetStatus.NoResult =>
                    "بدون نتیجه",

                ResultSetStatus.Incomplete =>
                    $"نتیجه ناقص ({ResultCount}/{RequiredResultCount})",

                ResultSetStatus.OutOfLimit =>
                    "خارج از محدوده",

                ResultSetStatus.NoApplicableLimit =>
                    "بدون حدود مجاز",

                ResultSetStatus.Normal =>
                    "پاس",

                _ =>
                    "-"
            };
    }
