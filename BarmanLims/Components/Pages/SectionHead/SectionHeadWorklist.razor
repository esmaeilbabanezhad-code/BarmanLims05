    private bool HasPendingLimitProposal(TestAssignment assignment)
    {
        return LimitChangeRequests.Any(x =>
            x.TestAssignmentId == assignment.Id &&
            x.Status == TestLimitChangeRequestStatus.Pending &&
            !x.IsDeleted &&
            (
                x.RequestedLOD.HasValue ||
                x.RequestedLOQ.HasValue ||
                x.RequestedMinValue.HasValue ||
                x.RequestedMaxValue.HasValue
            ));
    }

    private int GetPackageAssignmentPriority(TestAssignment assignment)
    {
        // 0 = خارج از حدود
        // 1 = دارای پیشنهاد
        // 2 = عادی

        if (TestAssignmentService.IsResultOutOfLimit(assignment))
            return 0;

        if (HasPendingLimitProposal(assignment))
            return 1;

        return 2;
    }
    private ResultSetStatus GetDisplayGroupResultStatus(
    ResultApprovalDisplayGroup group)
    {
        var statuses =
            group.Assignments
                .Select(assignment =>
                    ResultApprovalStatuses.TryGetValue(
                        assignment.Id,
                        out var info)
                        ? info
                        : null)
                .Where(x => x is not null)
                .Select(x => x!)
                .ToList();

        if (statuses.Count == 0)
            return ResultSetStatus.NoResult;

        if (statuses.Any(x =>
            x.Status == ResultSetStatus.OutOfLimit))
        {
            return ResultSetStatus.OutOfLimit;
        }

        if (statuses.All(x =>
            x.Status == ResultSetStatus.NoResult))
        {
            return ResultSetStatus.NoResult;
        }

        if (statuses.Any(x =>
            x.Status == ResultSetStatus.Incomplete ||
            x.Status == ResultSetStatus.NoResult))
        {
            return ResultSetStatus.Incomplete;
        }

        if (statuses.Any(x =>
            x.Status == ResultSetStatus.NoApplicableLimit))
        {
            return ResultSetStatus.NoApplicableLimit;
        }

        return ResultSetStatus.Normal;
    }

    private int GetResultStatusSortValue(
        ResultApprovalDisplayGroup group)
    {
        return GetDisplayGroupResultStatus(group) switch
        {
            ResultSetStatus.OutOfLimit => 0,
            ResultSetStatus.Incomplete => 1,
            ResultSetStatus.NoResult => 2,
            ResultSetStatus.NoApplicableLimit => 3,
            ResultSetStatus.Normal => 4,
            _ => 5
        };
    }
    
    private int GetProposalSortValue(
    ResultApprovalDisplayGroup group)
    {
        if (group.IsPanel)
        {
            return group.Assignments.Any(x =>
                HasPendingLimitProposal(x))
                ? 0
                : 1;
        }

        var assignment = group.Assignments.FirstOrDefault();

        return assignment is not null &&
               HasPendingLimitProposal(assignment)
            ? 0
            : 1;
    }

    private IEnumerable<TestAssignment> GetSortedPackageAssignments(
    IEnumerable<TestAssignment> assignments)
{
    return PackageSortMode switch
    {
        1 =>
            assignments
                .OrderBy(x =>
                    HasPendingLimitProposal(x) ? 0 : 1)
                .ThenBy(x => GetPackageAssignmentPriority(x))
                .ThenBy(x => x.Test?.Code),

        2 =>
            assignments
                .OrderBy(x => x.Test?.Code),

        _ =>
            assignments
                .OrderBy(x => GetPackageAssignmentPriority(x))
                .ThenBy(x => x.Test?.Code)
    };
}
