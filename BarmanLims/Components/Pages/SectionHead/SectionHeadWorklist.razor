@page "/section-head/worklist"

@using Barman.Domain.Entities
@using Barman.Application.Services
@using Barman.Application.Interfaces
@using Barman.Domain.Enums
@using Barman.Application.DTOs.Test

@inject TestAssignmentService TestAssignmentService
@inject ICurrentUserService CurrentUserService
@inject IDepartmentResponsibilityService DepartmentResponsibilityService
@inject ITestLimitChangeRequestService TestLimitChangeRequestService
@inject ITestAssignmentResultValueService TestAssignmentResultValueService
@inject ITestResultSetItemService TestResultSetItemService




<PageTitle>کارتابل بخش</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-4">

    <MudPaper Class="pa-4">

        <MudText Typo="Typo.h5" Class="mb-4">
            کارتابل بخش
        </MudText>
        <MudTabs @bind-ActivePanelIndex="ActiveTab"
                 Rounded="true"
                 Elevation="0"
                 Class="mb-4">

            <MudTabPanel Text="ارجاعات">
                <MudText Typo="Typo.body2">
                    آزمون‌های در انتظار تخصیص به کارشناس
                </MudText>
            </MudTabPanel>

            <MudTabPanel Text="تأییدیه نتایج">

                @if (PendingResultApprovals.Count == 0)
                {
                    <MudAlert Severity="Severity.Info">
                        هیچ نتیجه‌ای در انتظار تأیید نیست.
                    </MudAlert>
                }
                else
                {
                    <MudTextField T="string"
                                  @bind-Value="ResultApprovalSearchText"
                                  Label="جستجوی نتیجه"
                                  Placeholder="کد نمونه، کد آزمون، نام آزمون یا نتیجه"
                                  Variant="Variant.Outlined"
                                  Clearable="true"
                                  Immediate="true"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Class="mb-3" />

                    <MudGrid Class="mb-3">

                        <MudItem xs="12" md="6">
                            <MudSelect T="string"
                                       @bind-Value="ResultStatusFilter"
                                       Label="وضعیت نتیجه"
                                       Variant="Variant.Outlined"
                                       Dense="true">

                                <MudSelectItem T="string" Value="@("همه")">
                                    همه
                                </MudSelectItem>

                                <MudSelectItem T="string" Value="@("رد")">
                                    رد
                                </MudSelectItem>

                                <MudSelectItem T="string" Value="@("پاس")">
                                    پاس
                                </MudSelectItem>

                                <MudSelectItem T="string" Value="@("بدون حدود مجاز")">
                                    بدون حدود مجاز
                                </MudSelectItem>

                                <MudSelectItem T="string" Value="@("بدون نتیجه")">
                                    بدون نتیجه
                                </MudSelectItem>

                                <MudSelectItem T="string" Value="@("نتیجه ناقص")">
                                    نتیجه ناقص
                                </MudSelectItem>

                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" md="6">
                            <MudSelect T="string"
                                       @bind-Value="ProposalFilter"
                                       Label="پیشنهادات"
                                       Variant="Variant.Outlined"
                                       Dense="true">

                                <MudSelectItem T="string" Value="@("همه")">
                                    همه
                                </MudSelectItem>

                                <MudSelectItem T="string" Value="@("دارای پیشنهاد")">
                                    دارای پیشنهاد
                                </MudSelectItem>

                                <MudSelectItem T="string" Value="@("بدون پیشنهاد")">
                                    بدون پیشنهاد
                                </MudSelectItem>

                            </MudSelect>
                        </MudItem>

                    </MudGrid>

                    <MudTable Items="FilteredResultApprovalDisplayGroups"
                              Hover="true"
                              Striped="true"
                              Bordered="true">
                        
                        <HeaderContent>

                            <MudTh>
                                <MudTableSortLabel T="ResultApprovalDisplayGroup"
                                                   SortBy="@(x => x.SampleCode)">
                                    نمونه
                                </MudTableSortLabel>
                            </MudTh>

                            <MudTh>
                                <MudTableSortLabel T="ResultApprovalDisplayGroup"
                                                   SortBy="@(x => x.SortTitle)">
                                    Panel / آزمون
                                </MudTableSortLabel>
                            </MudTh>

                            <MudTh>
                                <MudTableSortLabel T="ResultApprovalDisplayGroup"
                                                   SortBy="@(x => x.PanelName)">
                                    نام Panel / آزمون
                                </MudTableSortLabel>
                            </MudTh>

                            <MudTh>
                                <MudTableSortLabel T="ResultApprovalDisplayGroup"
                                                   SortBy="@(x => x.Assignments.FirstOrDefault()?.Result)">
                                    نتیجه
                                </MudTableSortLabel>
                            </MudTh>

                            <MudTh>
                               <MudTableSortLabel T="ResultApprovalDisplayGroup"
                                       SortBy="@(x => x.Assignments.FirstOrDefault()?.Unit)">
                                       واحد
                               </MudTableSortLabel>
                            </MudTh>
                            <MudTh>
                                <MudTableSortLabel T="ResultApprovalDisplayGroup"
                                                   SortBy="@(x => GetResultStatusSortValue(x))">
                                    وضعیت نتیجه
                                </MudTableSortLabel>
                            </MudTh>

                            <MudTh>
                                <MudTableSortLabel T="ResultApprovalDisplayGroup"
                                                   SortBy="@(x => GetProposalSortValue(x))">
                                    پیشنهادات
                                </MudTableSortLabel>
                            </MudTh>

                            <MudTh>
                                عملیات
                            </MudTh>

                        </HeaderContent>

                        <RowTemplate>

                                    @{
                                        var firstAssignment = context.Assignments.FirstOrDefault();
                                        var isPanel = context.IsPanel;

                                       
                                    }

                            

                            <MudTd DataLabel="نمونه">
                                @context.SampleCode
                            </MudTd>

                                <MudTd DataLabel="Panel / آزمون">
                                @if (isPanel)
                                {
                                    <b>@context.PanelCode</b>
                                }
                                else
                                {
                                    @firstAssignment?.Test?.Code
                                }
                            </MudTd>

                                <MudTd DataLabel="نام Panel / آزمون">
                                @if (isPanel)
                                {
                                    @context.PanelName
                                }
                                else
                                {
                                    @firstAssignment?.Test?.Name
                                }
                            </MudTd>

                            <MudTd DataLabel="نتیجه">

                                @if (isPanel)
                                {
                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Color="Color.Primary">
                                        Package (@context.Assignments.Count آزمون)
                                    </MudChip>
                                }
                                else if (firstAssignment is not null &&
                                ResultApprovalStatuses.TryGetValue(
                                firstAssignment.Id,
                                out var resultInfo))
                                {
                                    if (resultInfo.RequiredResultCount > 0)
                                    {
                                        <MudChip T="string"
                                                 Size="Size.Small"
                                                 Color="Color.Primary">
                                            @resultInfo.ResultCount از
                                            @resultInfo.RequiredResultCount
                                        </MudChip>
                                    }
                                    else
                                    {
                                        <MudChip T="string"
                                                 Size="Size.Small"
                                                 Color="Color.Default">
                                            بدون نتیجه
                                        </MudChip>
                                    }
                                }
                                else
                                {
                                    @(firstAssignment?.Result ?? "-")
                                }

                            </MudTd>

                            <MudTd DataLabel="واحد">
                                @if (!isPanel)
                                {
                                    @firstAssignment?.Unit
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </MudTd>

                            <MudTd DataLabel="وضعیت">

                                @{
                                    var displayStatus =
                                    GetDisplayGroupResultStatus(context);

                                    var statusInfo =
                                    context.Assignments
                                    .Select(a =>
                                    ResultApprovalStatuses.TryGetValue(
                                    a.Id,
                                    out var info)
                                    ? info
                                    : null)
                                    .Where(x => x is not null)
                                    .Select(x => x!)
                                    .ToList();

                                    var outOfLimitCount =
                                    statusInfo.Sum(x => x.OutOfLimitCount);
                                }

                                @switch (displayStatus)
                                {
                                    case ResultSetStatus.OutOfLimit:

                                        <MudChip T="string"
                                                 Size="Size.Small"
                                                 Color="Color.Error">
                                            @outOfLimitCount آزمون خارج از محدوده
                                        </MudChip>

                                        break;

                                    case ResultSetStatus.NoResult:

                                        <MudChip T="string"
                                                 Size="Size.Small"
                                                 Color="Color.Default">
                                            بدون نتیجه
                                        </MudChip>

                                        break;

                                    case ResultSetStatus.Incomplete:

                                        <MudChip T="string"
                                                 Size="Size.Small"
                                                 Color="Color.Warning">
                                            نتیجه ناقص
                                        </MudChip>

                                        break;

                                    case ResultSetStatus.NoApplicableLimit:

                                        <MudChip T="string"
                                                 Size="Size.Small"
                                                 Color="Color.Warning">
                                            بدون حدود مجاز
                                        </MudChip>

                                        break;

                                    case ResultSetStatus.Normal:

                                        <MudChip T="string"
                                                 Size="Size.Small"
                                                 Color="Color.Success">
                                            پاس
                                        </MudChip>

                                        break;

                                    default:

                                        <MudChip T="string"
                                                 Size="Size.Small"
                                                 Color="Color.Default">
                                            بدون نتیجه
                                        </MudChip>

                                        break;
                                }

                            </MudTd>
                                <MudTd DataLabel="پیشنهادات">

                                    @{
                                        var hasProposal = isPanel
                                        ? context.Assignments.Any(x => HasPendingLimitProposal(x))
                                        : firstAssignment is not null &&
                                        HasPendingLimitProposal(firstAssignment);
                                    }

                                    @if (hasProposal)
                                    {
                                        <MudChip T="string"
                                                 Size="Size.Small"
                                                 Color="Color.Warning">
                                            دارد
                                        </MudChip>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.body2">
                                            ندارد
                                        </MudText>
                                    }

                                </MudTd>
                            <MudTd DataLabel="عملیات">
                                @if (isPanel)
                                {
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               OnClick="@(() => OpenResultApproval(context.Assignments.First()))">
                                        مشاهده Package
                                    </MudButton>
                                }
                                else if (firstAssignment is not null)
                                {
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               OnClick="@(() => OpenResultApproval(firstAssignment))">
                                        بررسی
                                    </MudButton>
                                }
                            </MudTd>
                            
                        </RowTemplate>
                        <ChildRowContent>
                            @if (SelectedResultApproval is not null &&
                                                    (
                                                    (
                                                    context.IsPanel &&
                                                    SelectedResultApproval.TestPanelId == context.TestPanelId &&
                                                    SelectedResultApproval.SampleId == context.SampleId
                                                    )
                                                    ||
                                                    (
                                                    !context.IsPanel &&
                                                    SelectedResultApproval.Id ==
                                                    context.Assignments.FirstOrDefault()?.Id
                                                    )
                                                    ))
                            {
                                <MudTr>
                                    <td colspan="6">
                                        <MudPaper Class="pa-3 ma-2"
                                                  Outlined="true">

                                            <MudText Typo="Typo.subtitle2"
                                                     Class="mb-3">
                                                @(context.IsPanel
                                                                                        ? "بررسی نتیجه Package"
                                                                                        : "بررسی نتیجه آزمون")
                                            </MudText>
                                    @if (context.IsPanel)
                                            {
                                                var totalCount = context.Assignments.Count;

                                                var outOfLimitCount =
                                                context.Assignments.Count(x =>
                                                TestAssignmentService.IsResultOutOfLimit(x));

                                                var proposalCount =
                                                context.Assignments.Count(x =>
                                                HasPendingLimitProposal(x));

                                                var normalCount =
                                                context.Assignments.Count(x =>
                                                !TestAssignmentService.IsResultOutOfLimit(x) &&
                                                !HasPendingLimitProposal(x));
                                                <MudSelect T="int"
                                                           @bind-Value="PackageSortMode"
                                                           Label="مرتب‌سازی آزمون‌ها"
                                                           Variant="Variant.Outlined"
                                                           Dense="true"
                                                           Class="mb-3">

                                                    <MudSelectItem T="int" Value="0">
                                                        موارد مهم‌تر اول
                                                    </MudSelectItem>

                                                    <MudSelectItem T="int" Value="1">
                                                        موارد پیشنهادی اول
                                                    </MudSelectItem>

                                                    <MudSelectItem T="int" Value="2">
                                                        کد آزمون
                                                    </MudSelectItem>

                                                </MudSelect>
                                                <MudPaper Class="pa-3 mb-3"
                                                          Outlined="true">

                                                    <MudStack Row="true"
                                                              Spacing="3"
                                                              AlignItems="AlignItems.Center"
                                                              Wrap="Wrap.Wrap">

                                                        <MudText Typo="Typo.body2">
                                                            <b>وضعیت Package:</b>
                                                        </MudText>

                                                        <MudChip T="string"
                                                                 Size="Size.Small">
                                                            @totalCount آزمون
                                                        </MudChip>

                                                        @if (outOfLimitCount > 0)
                                                        {
                                                            <MudChip T="string"
                                                                     Size="Size.Small"
                                                                     Color="Color.Error">
                                                                @outOfLimitCount خارج از حدود
                                                            </MudChip>
                                                        }

                                                        @if (proposalCount > 0)
                                                        {
                                                            <MudChip T="string"
                                                                     Size="Size.Small">
                                                                @proposalCount دارای پیشنهاد
                                                            </MudChip>
                                                        }

                                                        @if (normalCount > 0)
                                                        {
                                                            <MudChip T="string"
                                                                     Size="Size.Small">
                                                                @normalCount عادی
                                                            </MudChip>
                                                        }

                                                    </MudStack>

                                                </MudPaper>
                                            }
                                    @foreach (var assignment in GetSortedPackageAssignments(context.Assignments))
                                                                       
                                            {
                                                <MudPaper Class="pa-3 mb-3"
                                                          Outlined="true">

                                                    <MudText Typo="Typo.subtitle2"
                                                             Class="mb-2">
                                                        <b>@assignment.Test?.Code</b>
                                                        -
                                                        @assignment.Test?.Name
                                                    </MudText>

                                                    @{
                                                        var referenceLimit =
                                                        TestAssignmentService.GetApplicableReferenceLimit(assignment);

                                                        var isOutOfLimit =
                                                        TestAssignmentService.IsResultOutOfLimit(assignment);
                                                    }

                                                    <MudGrid Class="mb-2">

                                                        <MudItem xs="12">

                                                            <MudText Typo="Typo.subtitle2" Class="mb-2">
                                                                نتایج ثبت‌شده
                                                            </MudText>

                                                            @if (assignment.TestResultSetId.HasValue &&
                                                                                                            assignment.TestResultSetId.Value != Guid.Empty)
                                                            {
                                                                var resultItems =
                                                                SelectedResultSetItems
                                                                .OrderBy(x => x.DisplayOrder)
                                                                .ToList();

                                                                <MudTable Items="resultItems"
                                                                          Dense="true"
                                                                          Hover="true"
                                                                          Bordered="true"
                                                                          Striped="true">

                                                                    <HeaderContent>
                                                                        <MudTh>ردیف</MudTh>
                                                                        <MudTh>جزء نتیجه</MudTh>
                                                                        <MudTh>نتیجه</MudTh>
                                                                        <MudTh>واحد</MudTh>
                                                                        <MudTh>LOD</MudTh>
                                                                        <MudTh>LOQ</MudTh>
                                                                        <MudTh>حد پایین</MudTh>
                                                                        <MudTh>حد بالا</MudTh>
                                                                        <MudTh>وضعیت</MudTh>
                                                                    </HeaderContent>

                                                                    <RowTemplate Context="resultItem">

                                                                        @{
                                                                            var resultValue =
                                                                            SelectedResultValues
                                                                            .FirstOrDefault(x =>
                                                                            x.TestResultSetItemId == resultItem.Id);

                                                                            var value =
                                                                            resultValue?.Value;

                                                                            decimal parsedValue;

                                                                            var isNumeric =
                                                                            decimal.TryParse(
                                                                            value,
                                                                            out parsedValue);

                                                                            var isOutOfLimit =
                                                                            isNumeric &&
                                                                            (
                                                                            (resultItem.MinValue.HasValue &&
                                                                            parsedValue < resultItem.MinValue.Value)
                                                                            ||
                                                                            (resultItem.MaxValue.HasValue &&
                                                                            parsedValue > resultItem.MaxValue.Value)
                                                                            );
                                                                        }

                                                                        <MudTd DataLabel="ردیف">
                                                                            @resultItem.DisplayOrder
                                                                        </MudTd>

                                                                        <MudTd DataLabel="جزء نتیجه">
                                                                            <b>
                                                                                @(resultItem.Name ?? resultItem.Code ?? "-")
                                                                            </b>
                                                                        </MudTd>

                                                                        <MudTd DataLabel="نتیجه">
                                                                            <b>@(value ?? "-")</b>
                                                                        </MudTd>

                                                                        <MudTd DataLabel="واحد">
                                                                            @(resultItem.Unit ?? "-")
                                                                        </MudTd>

                                                                        <MudTd DataLabel="LOD">
                                                                            @(resultItem.LOD?.ToString() ?? "-")
                                                                        </MudTd>

                                                                        <MudTd DataLabel="LOQ">
                                                                            @(resultItem.LOQ?.ToString() ?? "-")
                                                                        </MudTd>

                                                                        <MudTd DataLabel="حد پایین">
                                                                            @(resultItem.MinValue?.ToString() ?? "-")
                                                                        </MudTd>

                                                                        <MudTd DataLabel="حد بالا">
                                                                            @(resultItem.MaxValue?.ToString() ?? "-")
                                                                        </MudTd>

                                                                        <MudTd DataLabel="وضعیت">

                                                                            @if (string.IsNullOrWhiteSpace(value))
                                                                            {
                                                                                <MudChip T="string"
                                                                                         Size="Size.Small"
                                                                                         Color="Color.Warning">
                                                                                    بدون نتیجه
                                                                                </MudChip>
                                                                            }
                                                                            else if (isOutOfLimit)
                                                                            {
                                                                                <MudChip T="string"
                                                                                         Size="Size.Small"
                                                                                         Color="Color.Error">
                                                                                    خارج از محدوده
                                                                                </MudChip>
                                                                            }
                                                                            else
                                                                            {
                                                                                <MudChip T="string"
                                                                                         Size="Size.Small"
                                                                                         Color="Color.Success">
                                                                                    در محدوده
                                                                                </MudChip>
                                                                            }

                                                                        </MudTd>

                                                                    </RowTemplate>

                                                                </MudTable>
                                                            }
                                                            else
                                                            {
                                                                <MudText Typo="Typo.body2">
                                                                    نتیجه:
                                                                    <b>@(assignment.Result ?? "-")</b>
                                                                </MudText>
                                                            }

                                                        </MudItem>
                                                        <MudItem xs="12" md="4">
                                                            <MudText Typo="Typo.body2">
                                                                وضعیت:
                                                            </MudText>

                                                            @if (string.IsNullOrWhiteSpace(assignment.Result))
                                                            {
                                                                <MudChip T="string"
                                                                         Size="Size.Small"
                                                                         Color="Color.Default">
                                                                    بدون نتیجه
                                                                </MudChip>
                                                            }
                                                            else if (referenceLimit is null &&
                                                            assignment.SelectedLimitRule is null)
                                                            {
                                                                <MudChip T="string"
                                                                         Size="Size.Small"
                                                                         Color="Color.Default">
                                                                    حد مجاز تعریف نشده
                                                                </MudChip>
                                                            }
                                                            else if (isOutOfLimit)
                                                            {
                                                                <MudChip T="string"
                                                                         Size="Size.Small"
                                                                         Color="Color.Error">
                                                                    خارج از محدوده مجاز
                                                                </MudChip>
                                                            }
                                                            else
                                                            {
                                                                <MudChip T="string"
                                                                         Size="Size.Small"
                                                                         Color="Color.Success">
                                                                    در محدوده مجاز
                                                                </MudChip>
                                                            }
                                                        </MudItem>
                                                        <MudItem xs="12" md="4">
                                                            <MudText Typo="Typo.body2">
                                                                حدود مجاز:
                                                            </MudText>

                                                            @if (assignment.SelectedLimitRule is not null)
                                                            {
                                                                var rule = assignment.SelectedLimitRule;

                                                                <MudText Typo="Typo.body2">
                                                                    @switch (rule.LimitType)
                                                                    {
                                                                        case LimitType.Maximum:
                                                                            <span>
                                                                                حداکثر:
                                                                                <b>@(rule.UpperValue?.ToString() ?? "-")</b>
                                                                            </span>
                                                                            break;

                                                                        case LimitType.Minimum:
                                                                            <span>
                                                                                حداقل:
                                                                                <b>@(rule.LowerValue?.ToString() ?? "-")</b>
                                                                            </span>
                                                                            break;

                                                                        case LimitType.Range:
                                                                            <span>
                                                                                <b>@(rule.LowerValue?.ToString() ?? "-")</b>
                                                                                تا
                                                                                <b>@(rule.UpperValue?.ToString() ?? "-")</b>
                                                                            </span>

                                                                            @if (!rule.LowerInclusive || !rule.UpperInclusive)
                                                                            {
                                                                                <span>
                                                                                    (حدود غیرشامل)
                                                                                </span>
                                                                            }
                                                                            break;

                                                                        case LimitType.Exact:
                                                                            <span>
                                                                                مقدار دقیق:
                                                                                <b>@(rule.LowerValue?.ToString() ?? "-")</b>
                                                                            </span>
                                                                            break;

                                                                        default:
                                                                            <span>تعریف نشده</span>
                                                                            break;
                                                                    }

                                                                    @(assignment.Unit ?? "")
                                                                </MudText>
                                                            }
                                                            else if (referenceLimit is not null)
                                                            {
                                                                <MudText Typo="Typo.body2">
                                                                    @if (referenceLimit.MinValue.HasValue &&
                                                                                                                        referenceLimit.MaxValue.HasValue)
                                                                    {
                                                                        <span>
                                                                            <b>@referenceLimit.MinValue</b>
                                                                            تا
                                                                            <b>@referenceLimit.MaxValue</b>
                                                                        </span>
                                                                    }
                                                                    else if (referenceLimit.MinValue.HasValue)
                                                                    {
                                                                        <span>
                                                                            حداقل:
                                                                            <b>@referenceLimit.MinValue</b>
                                                                        </span>
                                                                    }
                                                                    else if (referenceLimit.MaxValue.HasValue)
                                                                    {
                                                                        <span>
                                                                            حداکثر:
                                                                            <b>@referenceLimit.MaxValue</b>
                                                                        </span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span>تعریف نشده</span>
                                                                    }

                                                                    @(referenceLimit.Unit ?? assignment.Unit ?? "")
                                                                </MudText>
                                                            }
                                                            else
                                                            {
                                                                <MudText Typo="Typo.body2">
                                                                    تعریف نشده
                                                                </MudText>
                                                            }
                                                        </MudItem>
                                                        
                                                        <MudItem xs="12" md="4">
                                                            <MudText Typo="Typo.body2">
                                                                LOD:
                                                                <b>@(assignment.Test?.LOD?.ToString() ?? "-")</b>
                                                            </MudText>
                                                        </MudItem>

                                                        <MudItem xs="12" md="4">
                                                            <MudText Typo="Typo.body2">
                                                                LOQ:
                                                                <b>@(assignment.Test?.LOQ?.ToString() ?? "-")</b>
                                                            </MudText>
                                                        </MudItem>

                                                        

                                                        <MudItem xs="12" md="4">
                                                            <MudText Typo="Typo.body2">
                                                                واحد:
                                                                <b>@(referenceLimit?.Unit ?? assignment.Unit ?? "-")</b>
                                                            </MudText>
