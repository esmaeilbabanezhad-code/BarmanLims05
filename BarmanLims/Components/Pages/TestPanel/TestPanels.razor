@page "/testpanels"

@using MudBlazor
@using Barman.Domain.Entities
@using Barman.Application.DTOs.Test

@inject Barman.Application.Interfaces.ITestPanelService TestPanelService
@inject Barman.Application.Interfaces.ITestPanelItemService TestPanelItemService
@inject Barman.Application.Interfaces.ITestService TestService

<PageTitle>Test Panels</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-4">

    <MudPaper Class="pa-4">

        <div class="d-flex justify-space-between align-center">

            <MudText Typo="Typo.h5">
                Test Panels
            </MudText>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="NewPanel">
                New Panel
            </MudButton>

        </div>

        <MudDivider Class="my-3" />

        @if (PanelList == null)
        {
            <MudProgressCircular Indeterminate="true"
                                  Color="Color.Primary" />
        }
        else
        {
            <MudTable Items="PanelList"
                      Hover="true"
                      Dense="true"
                      Striped="true">

                <HeaderContent>
                    <MudTh>Code</MudTh>
                    <MudTh>Name</MudTh>
                    <MudTh>Description</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Tests</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>

                <RowTemplate>

                    <MudTd>
                        @context.Code
                    </MudTd>

                    <MudTd>
                        @context.Name
                    </MudTd>

                    <MudTd>
                        @context.Description
                    </MudTd>

                    <MudTd>

                        @if (context.IsActive)
                        {
                            <MudChip T="string"
                                     Color="Color.Success">
                                Active
                            </MudChip>
                        }
                        else
                        {
                            <MudChip T="string"
                                     Color="Color.Error">
                                Inactive
                            </MudChip>
                        }

                    </MudTd>

                    <MudTd>
                        <MudButton Size="Size.Small"
                                   Variant="Variant.Outlined"
                                   Color="Color.Info"
                                   OnClick="@(() => ManageTests(context))">
                            Manage Tests
                        </MudButton>
                    </MudTd>

                    <MudTd>

                        <MudButton Size="Size.Small"
                                   Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   OnClick="@(() => Edit(context))">
                            Edit
                        </MudButton>

                        @if (context.IsActive)
                        {
                            <MudButton Size="Size.Small"
                                       Variant="Variant.Text"
                                       Color="Color.Warning"
                                       OnClick="@(() => Deactivate(context.Id))">
                                Disable
                            </MudButton>
                        }
                        else
                        {
                            <MudButton Size="Size.Small"
                                       Variant="Variant.Text"
                                       Color="Color.Success"
                                       OnClick="@(() => Activate(context.Id))">
                                Activate
                            </MudButton>
                        }

                        <MudButton Size="Size.Small"
                                   Variant="Variant.Text"
                                   Color="Color.Error"
                                   OnClick="@(() => Delete(context.Id))">
                            Delete
                        </MudButton>

                    </MudTd>

                </RowTemplate>

            </MudTable>
        }

        <MudDialog @bind-Visible="DialogVisible">

            <DialogContent>

                <MudTextField Label="Code"
                              @bind-Value="CurrentPanel.Code"
                              Required="true" />

                <MudTextField Label="Name"
                              @bind-Value="CurrentPanel.Name"
                              Required="true" />

                <MudTextField Label="Description"
                              Lines="3"
                              @bind-Value="CurrentPanel.Description" />

            </DialogContent>

            <DialogActions>

                <MudButton Color="Color.Primary"
                           OnClick="SavePanel">
                    Save
                </MudButton>

                <MudButton Color="Color.Secondary"
                           OnClick="CloseDialog">
                    Cancel
                </MudButton>

            </DialogActions>

        </MudDialog>

        <MudDialog @bind-Visible="TestDialogVisible">

            <DialogContent>

                <MudText Typo="Typo.h6">
                    @SelectedPanel?.Code - @SelectedPanel?.Name
                </MudText>

                <MudDivider Class="my-3" />

                @if (PanelItems == null)
                {
                    <MudProgressCircular Indeterminate="true"
                                          Color="Color.Primary" />
                }
                else
                {
                    @if (PanelItems.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info">
                            No tests have been added to this panel.
                        </MudAlert>
                    }
                    else
                    {
                        <MudTable Items="PanelItems"
                                  Dense="true"
                                  Hover="true"
                                  Striped="true">

                            <HeaderContent>
                                <MudTh>Order</MudTh>
                                <MudTh>Code</MudTh>
                                <MudTh>Test</MudTh>
                                <MudTh></MudTh>
                            </HeaderContent>

                            <RowTemplate>
                                <MudTd>
                                    <MudNumericField T="int"
                                                     Value="@context.SortOrder"
                                                     ValueChanged="@((int value) => ChangeSortOrder(context, value))"
                                                     Min="0"
                                                     Immediate="true"
                                                     Style="width:90px;" />
                                </MudTd>

                                <MudTd>
                                    @context.Test?.Code
                                </MudTd>

                                <MudTd>
                                    @context.Test?.Name
                                </MudTd>

                                <MudTd>
                                    <MudButton Size="Size.Small"
                                               Variant="Variant.Text"
                                               Color="Color.Error"
                                               OnClick="@(() => RemoveTest(context.Id))">
                                        Remove
                                    </MudButton>
                                </MudTd>
                            </RowTemplate>

                        </MudTable>
                    }

                    <MudDivider Class="my-3" />

                    <MudText Typo="Typo.subtitle1">
                        افزودن آزمون به Panel
                    </MudText>

                    @if (!string.IsNullOrWhiteSpace(TestErrorMessage))
                    {
                        <MudAlert Severity="Severity.Error"
                                  Dense="true"
                                  Class="mt-2">
                            @TestErrorMessage
                        </MudAlert>
                    }

                    <MudTextField T="string"
                                  @bind-Value="PanelTestSearchText"
                                  Immediate="true"
                                  Label="جستجوی آزمون"
                                  Placeholder="بخشی از کد یا نام آزمون..."
                                  Variant="Variant.Outlined"
                                  Clearable="true"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Class="mt-2" />

                    <MudPaper Outlined="true"
                              Class="pa-2 mt-2"
                              Style="max-height:300px; overflow-y:auto;">

                        @foreach (var test in GetFilteredAvailablePanelTests())
                        {
                            <MudCheckBox T="bool"
                                         Value="@SelectedPanelTestIds.Contains(test.Id)"
                                         ValueChanged="@((bool value) =>
                                                                  TogglePanelTest(test.Id, value))"
                                 Dense="true">

                                @test.DisplayName

                            </MudCheckBox>
                                        }

                    </MudPaper>

                    <MudText Typo="Typo.caption" Class="mt-1">
                        تعداد آزمون‌های انتخاب‌شده:
                        <b>@SelectedPanelTestIds.Count</b>
                    </MudText>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Class="mt-2"
                               Disabled="@(SelectedPanelTestIds.Count == 0)"
                               OnClick="AddSelectedTests">

                        افزودن آزمون‌های انتخاب‌شده

                    </MudButton>

                
                }

            </DialogContent>

            <DialogActions>

                <MudButton Color="Color.Secondary"
                           OnClick="CloseTestDialog">
                    Close
                </MudButton>

            </DialogActions>

        </MudDialog>

    </MudPaper>

</MudContainer>

@code {

    private List<TestPanel>? PanelList;

    private TestPanel CurrentPanel = new();

    private bool DialogVisible;

    private bool IsEdit;

    private bool TestDialogVisible;

    private TestPanel? SelectedPanel;

    private List<TestPanelItem>? PanelItems;

    private List<TestLookupDto> AvailableTests = new();

    private Guid SelectedTestId = Guid.Empty;

    private string PanelTestSearchText = "";

    private HashSet<Guid> SelectedPanelTestIds = new();

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        PanelList =
            await TestPanelService.GetAllAsync();
    }

    private void NewPanel()
    {
        CurrentPanel = new TestPanel();

        IsEdit = false;

        DialogVisible = true;
    }

    private void Edit(TestPanel panel)
    {
        CurrentPanel = new TestPanel
        {
            Id = panel.Id,
            Code = panel.Code,
            Name = panel.Name,
            Description = panel.Description,
            IsActive = panel.IsActive
        };

        IsEdit = true;

        DialogVisible = true;
    }

    private async Task SavePanel()
    {
        if (IsEdit)
        {
            await TestPanelService.UpdateAsync(CurrentPanel);
        }
        else
        {
            await TestPanelService.CreateAsync(CurrentPanel);
        }

        DialogVisible = false;

        await Load();
    }

    private void CloseDialog()
    {
        DialogVisible = false;
    }

    private async Task ManageTests(TestPanel panel)
    {
        SelectedPanel = panel;

        SelectedTestId = Guid.Empty;

        SelectedPanelTestIds.Clear();
        PanelTestSearchText = "";

        PanelItems =
            await TestPanelItemService.GetByPanelIdAsync(panel.Id);

        var allTests =
            await TestService.GetReceptionLookupAsync();

        var existingTestIds =
            PanelItems
                .Select(x => x.TestId)
                .ToHashSet();

        AvailableTests =
            allTests
                .Where(x => !existingTestIds.Contains(x.Id))
                .OrderBy(x => x.Code)
                .ToList();

        TestDialogVisible = true;
    }

    private Task<IEnumerable<TestLookupDto>> SearchTests(
    string? value,
    CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(
                AvailableTests.AsEnumerable());

        var search = value.Trim();

        var result = AvailableTests
            .Where(x =>
                x.Code.StartsWith(
                    search,
                    StringComparison.OrdinalIgnoreCase)
                ||
                x.Name.StartsWith(
                    search,
                    StringComparison.OrdinalIgnoreCase)
                ||
                x.Code.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase)
                ||
                x.Name.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase))
            .OrderBy(x =>
                !x.Code.StartsWith(
                    search,
                    StringComparison.OrdinalIgnoreCase))
            .ThenBy(x =>
                !x.Name.StartsWith(
                    search,
                    StringComparison.OrdinalIgnoreCase))
            .ThenBy(x => x.Code)
            .Take(50);

        return Task.FromResult(result);
    }

    private void OnTestSelected(TestLookupDto? test)
    {
        SelectedTestId = test?.Id ?? Guid.Empty;
    }
    private IEnumerable<TestLookupDto> GetFilteredAvailablePanelTests()
    {
        if (string.IsNullOrWhiteSpace(PanelTestSearchText))
            return AvailableTests;

        var search = PanelTestSearchText.Trim();

        return AvailableTests
            .Where(x =>
                x.Code.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase)
                ||
                x.Name.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase))
            .OrderBy(x => x.Code);
    }

    private void TogglePanelTest(Guid testId, bool selected)
    {
        if (selected)
            SelectedPanelTestIds.Add(testId);
        else
            SelectedPanelTestIds.Remove(testId);
    }

    private async Task AddSelectedTests()
    {
        TestErrorMessage = null;

        if (SelectedPanel == null ||
            SelectedPanelTestIds.Count == 0)
            return;

        var nextSortOrder =
            PanelItems == null || PanelItems.Count == 0
                ? 1
                : PanelItems.Max(x => x.SortOrder) + 1;

        try
        {
            foreach (var testId in SelectedPanelTestIds)
            {
                await TestPanelItemService.AddAsync(
                    SelectedPanel.Id,
                    testId,
                    nextSortOrder);

                nextSortOrder++;
            }

            PanelItems =
                await TestPanelItemService.GetByPanelIdAsync(
                    SelectedPanel.Id);

            var existingTestIds =
                PanelItems
                    .Select(x => x.TestId)
                    .ToHashSet();

            AvailableTests =
                (await TestService.GetReceptionLookupAsync())
                    .Where(x => !existingTestIds.Contains(x.Id))
                    .OrderBy(x => x.Code)
                    .ToList();

            SelectedPanelTestIds.Clear();
        }
        catch (InvalidOperationException ex)
        {
            TestErrorMessage = ex.Message;
        }
    }
    private void CloseTestDialog()
    {
        TestDialogVisible = false;

        SelectedPanel = null;

        PanelItems = null;

        AvailableTests = new();

        SelectedTestId = Guid.Empty;

        SelectedPanelTestIds.Clear();
        PanelTestSearchText = "";

        TestErrorMessage = null;
    }

    private string? TestErrorMessage;

    private async Task AddTest()
    {
        TestErrorMessage = null;

        if (SelectedPanel == null ||
            SelectedTestId == Guid.Empty)
            return;

        var existingItem =
            PanelItems?
                .FirstOrDefault(x => x.TestId == SelectedTestId);

        if (existingItem != null)
        {
            TestErrorMessage =
                "این آزمون قبلاً به این Panel اضافه شده است.";

            SelectedTestId = Guid.Empty;

            return;
        }

        var nextSortOrder =
            PanelItems == null || PanelItems.Count == 0
                ? 1
                : PanelItems.Max(x => x.SortOrder) + 1;

        try
        {
            await TestPanelItemService.AddAsync(
                SelectedPanel.Id,
                SelectedTestId,
                nextSortOrder);

            PanelItems =
                await TestPanelItemService.GetByPanelIdAsync(
                    SelectedPanel.Id);

            var existingTestIds =
                PanelItems
                    .Select(x => x.TestId)
                    .ToHashSet();

            AvailableTests =
                (await TestService.GetReceptionLookupAsync())
                    .Where(x => !existingTestIds.Contains(x.Id))
                    .OrderBy(x => x.Code)
                    .ToList();

            SelectedTestId = Guid.Empty;
        }
        catch (InvalidOperationException ex)
        {
            TestErrorMessage = ex.Message;
        }
    }

    private async Task RemoveTest(Guid id)
    {
        await TestPanelItemService.DeleteAsync(id);

        if (SelectedPanel != null)
        {
            PanelItems =
                await TestPanelItemService.GetByPanelIdAsync(
                    SelectedPanel.Id);

            var allTests =
                await TestService.GetAllAsync();

            var existingTestIds =
                PanelItems
                    .Select(x => x.TestId)
                    .ToHashSet();

            AvailableTests =
                allTests
                    .Where(x => !existingTestIds.Contains(x.Id))
                    .OrderBy(x => x.Code)
                    .ToList();
        }
    }

    private async Task ChangeSortOrder(
        TestPanelItem item,
        int value)
    {
        if (value < 0)
            return;

        if (item.SortOrder == value)
            return;

        var success =
            await TestPanelItemService.UpdateSortOrderAsync(
                item.Id,
                value);

        if (success && SelectedPanel != null)
        {
            PanelItems =
                await TestPanelItemService.GetByPanelIdAsync(
                    SelectedPanel.Id);
        }
    }

    private async Task Activate(Guid id)
    {
        await TestPanelService.ActivateAsync(id);

        await Load();
    }

    private async Task Deactivate(Guid id)
    {
        await TestPanelService.DeactivateAsync(id);

        await Load();
    }

    private async Task Delete(Guid id)
    {
        await TestPanelService.DeleteAsync(id);

        await Load();
    }
}
