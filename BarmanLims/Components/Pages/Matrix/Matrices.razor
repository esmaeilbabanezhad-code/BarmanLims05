@page "/matrices"

@using MudBlazor
@using Barman.Application.Interfaces
@using Barman.Application.DTOs.Matrix
@using Barman.Domain.Entities

@inject IMatrixService MatrixService
@inject ISampleCategoryService SampleCategoryService
@inject INumberSequenceService NumberSequenceService

<MudPaper Class="pa-4">

    <div class="d-flex justify-space-between">

        <MudText Typo="Typo.h5">
            Matrix List
        </MudText>

        <div>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="NewMatrix">
                New
            </MudButton>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       Class="ms-2"
                       OnClick="ShowDeleted">
                Deleted Items
            </MudButton>
        </div>

    </div>

    <MudDivider Class="my-3" />
    <MudTextField T="string"
                  @bind-Value="MatrixSearchText"
                  Label="جستجوی ماتریس"
                  Placeholder="کد، نام، دسته‌بندی نمونه یا توضیحات..."
                  Variant="Variant.Outlined"
                  Clearable="true"
                  Immediate="true"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Class="mb-3" />
    @if (!ShowDeletedItems)
    {
     <MudTable Items="FilteredMatrices"
                  Hover="true"
                  Dense="true">

            <HeaderContent>

    <MudTh>
        <MudTableSortLabel T="Matrix"
                           SortBy="@(x => x.Code)">
            Code
        </MudTableSortLabel>
    </MudTh>

    <MudTh>
        <MudTableSortLabel T="Matrix"
                           SortBy="@(x => x.Name)">
            Name
        </MudTableSortLabel>
    </MudTh>

    <MudTh>
        <MudTableSortLabel T="Matrix"
                           SortBy="@(x => x.SampleCategory!.Name)">
            Sample Category
        </MudTableSortLabel>
    </MudTh>

    <MudTh>
        <MudTableSortLabel T="Matrix"
                           SortBy="@(x => x.Description)">
            Description
        </MudTableSortLabel>
    </MudTh>

    <MudTh>
        <MudTableSortLabel T="Matrix"
                           SortBy="@(x => x.IsActive)">
            Status
        </MudTableSortLabel>
    </MudTh>

    <MudTh>
        Action
    </MudTh>

</HeaderContent>

            <RowTemplate>

                <MudTd>@context.Code</MudTd>

                <MudTd>@context.Name</MudTd>

                <MudTd>
                    @context.SampleCategory?.Name
                </MudTd>

                <MudTd>
                    @context.Description
                </MudTd>

                <MudTd>
                    @if (context.IsActive)
                    {
                        <MudChip T="string"
                                 Color="Color.Success">
                            Active
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string"
                                 Color="Color.Error">
                            Inactive
                        </MudChip>
                    }
                </MudTd>

                <MudTd>

                    <MudButton Size="Size.Small"
                               Variant="Variant.Outlined"
                               Color="Color.Primary"
                               OnClick="@(() => Edit(context))">
                        Edit
                    </MudButton>

                    @if (context.IsActive)
                    {
                        <MudButton Size="Size.Small"
                                   Variant="Variant.Text"
                                   Color="Color.Warning"
                                   Class="ms-2"
                                   OnClick="@(() => Deactivate(context.Id))">
                            Disable
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Size="Size.Small"
                                   Variant="Variant.Text"
                                   Color="Color.Success"
                                   Class="ms-2"
                                   OnClick="@(() => Activate(context.Id))">
                            Activate
                        </MudButton>
                    }

                    <MudButton Size="Size.Small"
                               Variant="Variant.Text"
                               Color="Color.Error"
                               Class="ms-2"
                               OnClick="@(() => Delete(context.Id))">
                        Delete
                    </MudButton>

                </MudTd>

            </RowTemplate>

      </MudTable>
    }
    else
    {
        <div class="d-flex justify-space-between mb-3">

            <MudText Typo="Typo.h6">
                Deleted Matrices
            </MudText>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       OnClick="ShowMainList">
                Back to Matrix List
            </MudButton>

        </div>

        <MudTable Items="DeletedMatrixList"
                  Hover="true"
                  Dense="true">

            <HeaderContent>

                <MudTh>
                    <MudTableSortLabel T="Matrix"
                                       SortBy="@(x => x.Code)">
                        Code
                    </MudTableSortLabel>
                </MudTh>

                <MudTh>
                    <MudTableSortLabel T="Matrix"
                                       SortBy="@(x => x.Name)">
                        Name
                    </MudTableSortLabel>
                </MudTh>

                <MudTh>
                    <MudTableSortLabel T="Matrix"
                                       SortBy="@(x => x.SampleCategory!.Name)">
                        Sample Category
                    </MudTableSortLabel>
                </MudTh>

                <MudTh>
                    <MudTableSortLabel T="Matrix"
                                       SortBy="@(x => x.Description)">
                        Description
                    </MudTableSortLabel>
                </MudTh>

                <MudTh>
                    Action
                </MudTh>

            </HeaderContent>

            <RowTemplate>

                <MudTd>@context.Code</MudTd>

                <MudTd>@context.Name</MudTd>

                <MudTd>
                    @context.SampleCategory?.Name
                </MudTd>

                <MudTd>
                    @context.Description
                </MudTd>

                <MudTd>

                    <MudButton Size="Size.Small"
                               Variant="Variant.Outlined"
                               Color="Color.Success"
                               OnClick="@(() => Restore(context.Id))">
                        Restore
                    </MudButton>

                </MudTd>

            </RowTemplate>

        </MudTable>
    }

    <MudDialog @bind-Visible="DialogVisible">

        <DialogContent>

            <MudTextField Label="Code"
                          @bind-Value="CurrentMatrix.Code"
                          ReadOnly="true" />

            <MudTextField Label="Name"
                          @bind-Value="CurrentMatrix.Name" />

            <MudSelect T="Guid"
                       Label="Sample Category"
                       @bind-Value="CurrentMatrix.SampleCategoryId">

                @foreach (var category in Categories)
                {
                    <MudSelectItem T="Guid"
                                   Value="@category.Id">
                        @category.Name
                    </MudSelectItem>
                }

            </MudSelect>

            <MudTextField Label="Description"
                          Lines="3"
                          @bind-Value="CurrentMatrix.Description" />

        </DialogContent>

        <DialogActions>

            <MudButton Color="Color.Primary"
                       OnClick="SaveMatrix">
                Save
            </MudButton>

            <MudButton Color="Color.Secondary"
                       OnClick="CloseDialog">
                Cancel
            </MudButton>

        </DialogActions>

    </MudDialog>

</MudPaper>

@code {

    private List<Matrix> MatrixList = new();

    private List<Matrix> DeletedMatrixList = new();

    private List<SampleCategory> Categories = new();

    private Matrix CurrentMatrix = new();

    private bool DialogVisible;

    private bool IsEdit;

    private bool ShowDeletedItems;


    protected override async Task OnInitializedAsync()
    {
        await Load();
    }


    private async Task Load()
    {
        MatrixList =
            (await MatrixService.GetAllAsync())
            .Where(x => !x.IsDeleted)
            .OrderBy(x => x.Name)
            .ToList();

        Categories =
            await SampleCategoryService.GetAllAsync();
    }


    private async Task ShowDeleted()
    {
        DeletedMatrixList =
            await MatrixService.GetDeletedAsync();

        ShowDeletedItems = true;
    }


    private async Task ShowMainList()
    {
        ShowDeletedItems = false;

        await Load();
    }


    private async Task NewMatrix()
    {
        try
        {
            var code =
                await NumberSequenceService
                    .GetNextCodeAsync("Matrix");

            CurrentMatrix = new Matrix
            {
                Code = code,
                IsActive = true,
                IsDeleted = false,
                SampleCategoryId =
                    Categories.FirstOrDefault()?.Id
                    ?? Guid.Empty
            };

            IsEdit = false;

            DialogVisible = true;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"خطا در تولید کد Matrix: {ex.Message}");
        }
    }


    private void Edit(Matrix matrix)
    {
        CurrentMatrix = new Matrix
        {
            Id = matrix.Id,
            Code = matrix.Code,
            Name = matrix.Name,
            Description = matrix.Description,
            SampleCategoryId = matrix.SampleCategoryId,
            IsActive = matrix.IsActive,
            IsDeleted = matrix.IsDeleted
        };

        IsEdit = true;

        DialogVisible = true;
    }


    private async Task SaveMatrix()
    {
        if (IsEdit)
        {
            await MatrixService.UpdateAsync(
                CurrentMatrix.Id,
                new UpdateMatrixDto
                {
                    Code = CurrentMatrix.Code,
                    Name = CurrentMatrix.Name,
                    Description = CurrentMatrix.Description,
                    SampleCategoryId = CurrentMatrix.SampleCategoryId,
                    IsActive = CurrentMatrix.IsActive
                });
        }
        else
        {
            await MatrixService.CreateAsync(
                new CreateMatrixDto
                {
                    Code = CurrentMatrix.Code,
                    Name = CurrentMatrix.Name,
                    Description = CurrentMatrix.Description,
                    SampleCategoryId = CurrentMatrix.SampleCategoryId
                });
        }

        DialogVisible = false;

        await Load();
    }


    private async Task Activate(Guid id)
    {
        await MatrixService.ActivateAsync(id);

        await Load();
    }


    private async Task Deactivate(Guid id)
    {
        await MatrixService.DeactivateAsync(id);

        await Load();
    }


    private async Task Delete(Guid id)
    {
        await MatrixService.DeleteAsync(id);

        await Load();
    }


    private async Task Restore(Guid id)
    {
        await MatrixService.RestoreAsync(id);

        DeletedMatrixList =
            await MatrixService.GetDeletedAsync();

        await Load();
    }


    private void CloseDialog()
    {
        DialogVisible = false;
    }
    private string MatrixSearchText = "";
    private IEnumerable<Matrix> FilteredMatrices =>
    string.IsNullOrWhiteSpace(MatrixSearchText)
        ? MatrixList
        : MatrixList.Where(x =>
            (x.Code ?? "").Contains(MatrixSearchText.Trim(), StringComparison.OrdinalIgnoreCase) ||
            (x.Name ?? "").Contains(MatrixSearchText.Trim(), StringComparison.OrdinalIgnoreCase) ||
            (x.SampleCategory?.Name ?? "").Contains(MatrixSearchText.Trim(), StringComparison.OrdinalIgnoreCase) ||
            (x.Description ?? "").Contains(MatrixSearchText.Trim(), StringComparison.OrdinalIgnoreCase));
}