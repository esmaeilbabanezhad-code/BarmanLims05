@page "/technical-manager-scopes"

@using Barman.Application.Interfaces
@using Barman.Domain.Entities

@inject ITechnicalManagerScopeService TechnicalManagerScopeService

<PageTitle>Technical Manager Scopes</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-4">

    <MudPaper Class="pa-5">

        <MudText Typo="Typo.h5" Class="mb-4">
            Technical Manager Scopes
        </MudText>

        @if (!showForm)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="ShowAddForm">
                Add Scope
            </MudButton>
        }

        @if (showForm)
        {
            <MudPaper Outlined="true" Class="pa-4 mt-4">

                <MudText Typo="Typo.h6" Class="mb-4">
                    @(EditingId == Guid.Empty
                        ? "Add Technical Manager Scope"
                        : "Edit Technical Manager Scope")
                </MudText>

                <MudGrid>

                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="Code"
                                      Label="Code"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      FullWidth="true" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="Name"
                                      Label="Name"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      FullWidth="true" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudNumericField T="int"
                                         @bind-Value="Priority"
                                         Label="Priority"
                                         Variant="Variant.Outlined"
                                         Min="0"
                                         FullWidth="true" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudCheckBox @bind-Value="IsActive"
                                     Label="Active" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField @bind-Value="Description"
                                      Label="Description"
                                      Variant="Variant.Outlined"
                                      Lines="3"
                                      FullWidth="true" />
                    </MudItem>

                </MudGrid>

                @if (!string.IsNullOrWhiteSpace(formMessage))
                {
                    <MudAlert Severity="@formMessageSeverity"
                              Class="mt-4">
                        @formMessage
                    </MudAlert>
                }

                <div class="mt-4">

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="SaveScope"
                               Disabled="@isSaving">
                        @(isSaving ? "Saving..." : "Save")
                    </MudButton>

                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               Class="mr-2"
                               OnClick="CancelForm"
                               Disabled="@isSaving">
                        Cancel
                    </MudButton>

                </div>

            </MudPaper>
        }

    </MudPaper>

    <MudPaper Class="pa-5 mt-5">

        <MudText Typo="Typo.h6" Class="mb-3">
            Scope List
        </MudText>

        @if (isLoading)
        {
            <MudProgressLinear Indeterminate="true"
                               Color="Color.Primary"
                               Class="mb-4" />
        }

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <MudAlert Severity="Severity.Error"
                      Class="mb-4">
                @errorMessage
            </MudAlert>
        }

        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="LoadScopes"
                   Disabled="@isLoading">
            Refresh
        </MudButton>

        <MudTable Items="scopes"
                  Dense="true"
                  Hover="true"
                  Bordered="true"
                  Striped="true"
                  Class="mt-4">

            <HeaderContent>

                <MudTh>Code</MudTh>
                <MudTh>Name</MudTh>
                <MudTh>Priority</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Actions</MudTh>

            </HeaderContent>

            <RowTemplate>

                <MudTd DataLabel="Code">
                    @context.Code
                </MudTd>

                <MudTd DataLabel="Name">
                    @context.Name
                </MudTd>

                <MudTd DataLabel="Priority">
                    @context.Priority
                </MudTd>

                <MudTd DataLabel="Status">

                    @if (context.IsActive)
                    {
                        <MudChip T="string"
                                 Color="Color.Success"
                                 Size="Size.Small">
                            Active
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string"
                                 Color="Color.Default"
                                 Size="Size.Small">
                            Inactive
                        </MudChip>
                    }

                </MudTd>

                <MudTd DataLabel="Actions">

                    <MudButton Size="Size.Small"
                               Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Edit"
                               OnClick="@(() => EditScope(context))">
                        Edit
                    </MudButton>

                    @if (context.IsActive)
                    {
                        <MudButton Size="Size.Small"
                                   Variant="Variant.Outlined"
                                   Color="Color.Warning"
                                   Class="mr-2"
                                   OnClick="@(() => DeactivateScope(context.Id))"
                                   Disabled="@isSaving">
                            Deactivate
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Size="Size.Small"
                                   Variant="Variant.Outlined"
                                   Color="Color.Success"
                                   Class="mr-2"
                                   OnClick="@(() => ActivateScope(context.Id))"
                                   Disabled="@isSaving">
                            Activate
                        </MudButton>
                    }

                </MudTd>

            </RowTemplate>

            <NoRecordsContent>

                <MudText Class="pa-4">
                    No technical manager scope has been registered.
                </MudText>

            </NoRecordsContent>

        </MudTable>

    </MudPaper>

</MudContainer>

@code {

    private List<TechnicalManagerScope> scopes = new();

    private bool isLoading = true;
    private bool isSaving = false;

    private bool showForm = false;
    private Guid EditingId = Guid.Empty;

    private string? errorMessage;
    private string? formMessage;

    private Severity formMessageSeverity = Severity.Info;

    private string Code = "";
    private string Name = "";
    private string? Description;

    private int Priority = 100;
    private bool IsActive = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadScopes();
    }

    private async Task LoadScopes()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            scopes =
                await TechnicalManagerScopeService
                    .GetAllAsync();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Error loading technical manager scopes: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowAddForm()
    {
        EditingId = Guid.Empty;

        ClearForm();

        showForm = true;

        formMessage = null;
    }

    private void CancelForm()
    {
        showForm = false;

        ClearForm();

        formMessage = null;
    }

    private void ClearForm()
    {
        EditingId = Guid.Empty;

        Code = "";
        Name = "";
        Description = null;

        Priority = 100;
        IsActive = true;
    }

    private void EditScope(
        TechnicalManagerScope scope)
    {
        EditingId = scope.Id;

        Code = scope.Code;
        Name = scope.Name;
        Description = scope.Description;

        Priority = scope.Priority;
        IsActive = scope.IsActive;

        formMessage = null;

        showForm = true;
    }

    private async Task SaveScope()
    {
        formMessage = null;

        if (string.IsNullOrWhiteSpace(Code))
        {
            formMessage = "Code is required.";
            formMessageSeverity = Severity.Error;
            return;
        }

        if (string.IsNullOrWhiteSpace(Name))
        {
            formMessage = "Name is required.";
            formMessageSeverity = Severity.Error;
            return;
        }

        try
        {
            isSaving = true;

            if (EditingId == Guid.Empty)
            {
                var scope = new TechnicalManagerScope
                {
                    Code = Code.Trim(),
                    Name = Name.Trim(),
                    Description =
                        string.IsNullOrWhiteSpace(Description)
                            ? null
                            : Description.Trim(),
                    Priority = Priority,
                    IsActive = IsActive
                };

                await TechnicalManagerScopeService
                    .AddAsync(scope);

                formMessage =
                    "Technical manager scope created successfully.";
            }
            else
            {
                var scope =
                    await TechnicalManagerScopeService
                        .GetByIdAsync(EditingId);

                if (scope is null)
                {
                    formMessage =
                        "Technical manager scope was not found.";
                    formMessageSeverity = Severity.Error;
                    return;
                }

                scope.Code = Code.Trim();
                scope.Name = Name.Trim();
                scope.Description =
                    string.IsNullOrWhiteSpace(Description)
                        ? null
                        : Description.Trim();
                scope.Priority = Priority;
                scope.IsActive = IsActive;

                await TechnicalManagerScopeService
                    .UpdateAsync(scope);

                formMessage =
                    "Technical manager scope updated successfully.";
            }

            formMessageSeverity = Severity.Success;

            await LoadScopes();

            ClearForm();

            showForm = false;
        }
        catch (Exception ex)
        {
            formMessage =
                $"Error saving technical manager scope: {ex.Message}";

            formMessageSeverity = Severity.Error;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ActivateScope(Guid id)
    {
        try
        {
            isSaving = true;

            await TechnicalManagerScopeService
                .ActivateAsync(id);

            await LoadScopes();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Error activating scope: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeactivateScope(Guid id)
    {
        try
        {
            isSaving = true;

            await TechnicalManagerScopeService
                .DeactivateAsync(id);

            await LoadScopes();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Error deactivating scope: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
}
