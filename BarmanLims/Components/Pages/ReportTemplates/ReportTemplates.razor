private bool ShowCloneDialog;
private ReportTemplate? CloneSource;
private string CloneCode = "";
private string CloneName = "";
private string? CloneError;

private void OpenCloneTemplate(ReportTemplate template)
{
    CloneSource = template;

    CloneCode = "";
    CloneName = $"{template.Name} - کپی";

    CloneError = null;
    ShowCloneDialog = true;
}

private void CloseCloneDialog()
{
    ShowCloneDialog = false;
    CloneSource = null;
    CloneCode = "";
    CloneName = "";
    CloneError = null;
}

private async Task CloneTemplate()
{
    try
    {
        CloneError = null;

        if (CloneSource is null)
        {
            CloneError = "قالب مبنا انتخاب نشده است.";
            return;
        }

        if (string.IsNullOrWhiteSpace(CloneCode))
        {
            CloneError = "کد قالب جدید الزامی است.";
            return;
        }

        if (string.IsNullOrWhiteSpace(CloneName))
        {
            CloneError = "نام قالب جدید الزامی است.";
            return;
        }

        await ReportTemplateService.CloneAsync(
            CloneSource.Id,
            CloneCode.Trim(),
            CloneName.Trim());

        CloseCloneDialog();

        await LoadTemplates();
    }
    catch (Exception ex)
    {
        CloneError = ex.Message;
    }
}

private bool ShowFieldPicker;
private Guid FieldPickerSectionId;

private void OpenFieldPicker()
{
    if (SelectedTemplate is null)
        return;

    if (FieldModel.ReportTemplateSectionId == Guid.Empty)
        return;

    FieldPickerSectionId =
        FieldModel.ReportTemplateSectionId;

    ShowFieldPicker = true;
}
private async Task CloseFieldPicker()
{
    ShowFieldPicker = false;

    if (FieldPickerSectionId != Guid.Empty)
    {
        Fields =
            await ReportTemplateFieldService
                .GetBySectionIdAsync(FieldPickerSectionId);

        StateHasChanged();
    }
}

private async Task SaveFieldPicker()
{
    ShowFieldPicker = false;

    if (FieldPickerSectionId != Guid.Empty)
    {
        Fields =
            await ReportTemplateFieldService
                .GetBySectionIdAsync(FieldPickerSectionId);

        StateHasChanged();
    }
}

