        }

        Fields = await ReportTemplateFieldService
            .GetBySectionIdAsync(FieldModel.ReportTemplateSectionId);

        FieldModel = new ReportTemplateField
        {
            ReportTemplateSectionId = FieldModel.ReportTemplateSectionId,
            DisplayOrder = Fields.Count + 1,
            IsVisible = true
        };

        IsFieldEditMode = false;
