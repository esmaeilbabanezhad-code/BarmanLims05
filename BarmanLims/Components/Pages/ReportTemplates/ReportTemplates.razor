private IReadOnlyList<ReportFieldDefinition> GetAvailableReportFields()
{
    if (string.IsNullOrWhiteSpace(FieldModel.Source))
        return Array.Empty<ReportFieldDefinition>();

    return FieldModel.Source switch
    {
        "Report" =>
            ReportFieldCatalog.All
                .Where(x => x.Group == "گزارش")
                .ToList(),

        "Laboratory" =>
            ReportFieldCatalog.All
                .Where(x => x.Group == "آزمایشگاه")
                .ToList(),

        "Reception" =>
            ReportFieldCatalog.All
                .Where(x => x.Group == "پذیرش")
                .ToList(),

        "Customer" =>
            ReportFieldCatalog.All
                .Where(x => x.Group == "مشتری")
                .ToList(),

        "Sample" =>
            ReportFieldCatalog.All
                .Where(x => x.Group == "نمونه")
                .ToList(),

        "Test" =>
            ReportFieldCatalog.All
                .Where(x => x.Group == "آزمون")
                .ToList(),

        "Result" =>
            ReportFieldCatalog.All
                .Where(x => x.Group == "نتایج")
                .ToList(),

        "Limit" =>
            ReportFieldCatalog.All
                .Where(x => x.Group == "حدود مجاز")
                .ToList(),

        "Signature" =>
            ReportFieldCatalog.All
                .Where(x => x.Group == "امضاها")
                .ToList(),

        "CustomField" =>
            ReportFieldCatalog.All
                .Where(x => x.Group == "فیلدهای سفارشی")
                .ToList(),

        _ => Array.Empty<ReportFieldDefinition>()
    };
}

private async Task SaveField()
{
    try
    {
        FieldError = null;
        if (string.IsNullOrWhiteSpace(FieldModel.FieldCode))
{
    FieldError = "انتخاب FieldCode الزامی است.";
    return;
}

var fieldDefinition = ReportFieldCatalog.Find(FieldModel.FieldCode);

if (fieldDefinition is null)
{
    FieldError = "FieldCode انتخاب‌شده معتبر نیست.";
    return;
}

if (string.IsNullOrWhiteSpace(FieldModel.Caption))
{
    FieldModel.Caption = fieldDefinition.Caption;
}
        if (string.IsNullOrWhiteSpace(FieldModel.FieldCode))
        {
            FieldError = "کد فیلد الزامی است.";
            return;
        }
        if (string.IsNullOrWhiteSpace(FieldModel.Source))
{
    FieldError = "انتخاب منبع اطلاعات الزامی است.";
    return;
}
        if (string.IsNullOrWhiteSpace(FieldModel.Caption))
        {
            FieldError = "عنوان فیلد الزامی است.";
            return;
        }

        if (IsFieldEditMode)
        {
