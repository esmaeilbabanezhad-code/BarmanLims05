                                    <td>@field.DisplayOrder</td>
                                    <td>@field.Format</td>
                                    <td>@field.Width</td>

                                    <td>
                                        @if (field.IsVisible)
                                        {
                                            <span class="badge bg-success">
                                                بله
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                خیر
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <button class="btn btn-sm btn-outline-primary me-1"
                                                @onclick="() =>
                                                    OpenEditField(field)">
                                            ویرایش
                                        </button>

                                        <button class="btn btn-sm btn-outline-danger"
                                                @onclick="() =>
                                                    DeleteField(field)">
                                            حذف
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>

                </div>

                <div class="modal-footer">

                    <button class="btn btn-secondary"
                            @onclick="CloseFields">
                        بستن
                    </button>

                </div>

            </div>
        </div>
    </div>
}

@if (ShowFieldPicker && FieldPickerSectionId != Guid.Empty)
{
    <ReportFieldPicker
        SectionId="FieldPickerSectionId"
        OnSaved="SaveFieldPicker"
        OnCancelled="CloseFieldPicker" />
}

@code {

    private ReportTemplate? SelectedTemplate;

private List<ReportTemplateSection> Sections = new();

private ReportTemplateSection? SelectedSection;

private ReportTemplateSection SectionModel = new();

private List<ReportTemplateField> Fields = new();

private ReportTemplateField FieldModel = new();

private bool ShowSectionsDialog;
private bool ShowFieldDialog;

private bool IsSectionEditMode;
private bool IsFieldEditMode;

private string? SectionError;
private string? FieldError;

    private List<ReportTemplate> Templates = new();

    private ReportTemplate EditModel = new();

    private bool IsLoading;
    private bool ShowDialog;
    private bool IsEditMode;

    private string? ErrorMessage;
    private string? DialogError;

    protected override async Task OnInitializedAsync()
    {
        await LoadTemplates();
    }

    private async Task LoadTemplates()
    {
        try
        {
            IsLoading = true;
            ErrorMessage = null;

            Templates = await ReportTemplateService.GetAllAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void OpenCreateDialog()
    {
        DialogError = null;
        IsEditMode = false;

        EditModel = new ReportTemplate
        {
            Code = "",
            Name = "",
            ReportType = "",
            Authority = "",
            Version = "1.0",
            IsActive = true
        };

        ShowDialog = true;
    }

    private void OpenEditDialog(ReportTemplate template)
    {
        DialogError = null;
        IsEditMode = true;

        EditModel = new ReportTemplate
        {
            Id = template.Id,
            Code = template.Code,
            Name = template.Name,
            ReportType = template.ReportType,
            Authority = template.Authority,
            Version = template.Version,
            IsActive = template.IsActive,
            Description = template.Description
        };

        ShowDialog = true;
    }

    private void CloseDialog()
    {
        ShowDialog = false;
        DialogError = null;
    }

    private async Task SaveTemplate()
    {
        try
        {
            DialogError = null;

            if (string.IsNullOrWhiteSpace(EditModel.Code))
            {
                DialogError = "کد قالب الزامی است.";
                return;
            }

            if (string.IsNullOrWhiteSpace(EditModel.Name))
            {
                DialogError = "نام قالب الزامی است.";
                return;
            }

            if (IsEditMode)
            {
                var success = await ReportTemplateService
                    .UpdateAsync(EditModel);

                if (!success)
                {
                    DialogError = "قالب موردنظر پیدا نشد.";
                    return;
                }
            }
            else
            {
                await ReportTemplateService
                    .CreateAsync(EditModel);
            }

            CloseDialog();
            await LoadTemplates();
        }
        catch (Exception ex)
        {
            DialogError = ex.Message;
        }
    }

    private async Task DeleteTemplate(ReportTemplate template)
    {
        try
        {
            ErrorMessage = null;

            var success = await ReportTemplateService
                .DeleteAsync(template.Id);

            if (!success)
            {
                ErrorMessage = "قالب موردنظر پیدا نشد.";
                return;
            }

            await LoadTemplates();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }
    private async Task OpenSections(ReportTemplate template)
{
    SelectedTemplate = template;

    SectionError = null;
    FieldError = null;

    Sections = await ReportTemplateSectionService
        .GetByTemplateIdAsync(template.Id);

    ShowSectionsDialog = true;
}

private void CloseSections()
{
    ShowSectionsDialog = false;
    ShowFieldDialog = false;
    SelectedTemplate = null;
}

private void OpenCreateSection()
{
    SectionError = null;
    IsSectionEditMode = false;

    SectionModel = new ReportTemplateSection
    {
        ReportTemplateId = SelectedTemplate!.Id,
        Code = "",
        Name = "",
        SectionType = "Standard",
        Position = "Body",
        Layout = "Stack",
        DisplayOrder = Sections.Count + 1,
        IsVisible = true
    };
}

private void OpenEditSection(ReportTemplateSection section)
{
    SectionError = null;
    IsSectionEditMode = true;

    SectionModel = new ReportTemplateSection
    {
        Id = section.Id,
        ReportTemplateId = section.ReportTemplateId,
        Code = section.Code,
        Name = section.Name,
        SectionType = section.SectionType,
        Position = section.Position,
        Layout = section.Layout,
        DisplayOrder = section.DisplayOrder,
        IsVisible = section.IsVisible
    };
}


private string GenerateSectionCode(string sectionType)
{
    var prefix = sectionType switch
    {
        "Results" => "RESULTS",
        "Signature" => "SIGNATURES",
        "Text" => "TEXT",
        "Custom" => "CUSTOM",
        _ => "SECTION"
    };

    var number = 1;

    while (Sections.Any(x =>
        string.Equals(
            x.Code,
            $"{prefix}_{number:000}",
            StringComparison.OrdinalIgnoreCase)))
    {
        number++;
    }

    return $"{prefix}_{number:000}";
}


private async Task SaveSection()
{
    try
    {
        SectionError = null;

        if (SelectedTemplate is null)
        {
            SectionError = "قالب گزارش انتخاب نشده است.";
            return;
        }

        if (string.IsNullOrWhiteSpace(SectionModel.Name))
        {
            SectionError = "نام بخش الزامی است.";
            return;
        }

        if (string.IsNullOrWhiteSpace(SectionModel.SectionType))
        {
            SectionError = "نوع بخش را انتخاب کنید.";
            return;
        }

        if (string.IsNullOrWhiteSpace(SectionModel.Position))
        {
            SectionError = "محل قرارگیری را انتخاب کنید.";
            return;
        }

        if (string.IsNullOrWhiteSpace(SectionModel.Layout))
        {
            SectionError = "نوع چیدمان را انتخاب کنید.";
            return;
        }

        SectionModel.ReportTemplateId = SelectedTemplate.Id;

        if (!IsSectionEditMode &&
            string.IsNullOrWhiteSpace(SectionModel.Code))
        {
            SectionModel.Code = GenerateSectionCode(
                SectionModel.SectionType);
        }

        if (IsSectionEditMode)
        {
            var success = await ReportTemplateSectionService
                .UpdateAsync(SectionModel);

            if (!success)
            {
                SectionError = "بخش موردنظر پیدا نشد.";
                return;
            }
        }
        else
        {
            await ReportTemplateSectionService
                .CreateAsync(SectionModel);
        }

        Sections = await ReportTemplateSectionService
            .GetByTemplateIdAsync(SelectedTemplate.Id);

        SectionModel = new ReportTemplateSection
        {
            ReportTemplateId = SelectedTemplate.Id,
            SectionType = "Standard",
            Position = "Body",
            Layout = "Stack",
            DisplayOrder = Sections.Count + 1,
            IsVisible = true
        };

        IsSectionEditMode = false;
    }
    catch (Exception ex)
    {
        SectionError = ex.Message;
    }
}



