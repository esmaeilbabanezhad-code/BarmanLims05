                                <th>کد</th>
                                <th>عنوان</th>
                                <th>ترتیب</th>
                                <th>Format</th>
                                <th>Width</th>
                                <th>نمایش</th>
                                <th>عملیات</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var field in Fields)
