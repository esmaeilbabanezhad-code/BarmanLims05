@using Microsoft.AspNetCore.Components

<MudDialog>
    <DialogContent>

        <MudAlert Severity="Severity.Warning"
                  Variant="Variant.Outlined"
                  Class="mb-4">

            توجه: پس از تأیید، تعرفه‌های قبلی حفظ می‌شوند
            و تعرفه‌های جدید از تاریخ تعیین‌شده فعال خواهند شد.

        </MudAlert>

        <MudStack Spacing="2">

            <MudText>
                تعداد تعرفه‌های مشمول:
                <b>@Count</b>
            </MudText>

            <MudText>
                درصد تغییر:
                <b>
                    @(Percentage > 0 ? "+" : "")
                    @Percentage.ToString("0.##")%
                </b>
            </MudText>

            <MudText>
                تاریخ اجرای تغییر:
                <b>
                    @FormatPersianDate(EffectiveDate)
                </b>
            </MudText>

            <MudDivider Class="my-2" />

            <MudText Typo="Typo.body2">
                عدد مثبت به معنی افزایش تعرفه و عدد منفی
                به معنی کاهش تعرفه است.
            </MudText>

            <MudText Typo="Typo.body2">
                آیا از اعمال این تغییرات اطمینان دارید؟
            </MudText>

        </MudStack>

    </DialogContent>

    <DialogActions>

        <MudButton Variant="Variant.Text"
                   OnClick="Cancel">
            انصراف
        </MudButton>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Warning"
                   OnClick="Confirm">
            تأیید و اعمال
        </MudButton>

    </DialogActions>
</MudDialog>

@code {

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public int Count { get; set; }

    [Parameter]
    public decimal Percentage { get; set; }

    [Parameter]
    public DateTime? EffectiveDate { get; set; }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private void Confirm()
    {
        MudDialog.Close(
            DialogResult.Ok(true));
    }

    private static string FormatPersianDate(DateTime? date)
    {
        if (!date.HasValue)
            return "—";

        var calendar =
            new System.Globalization.PersianCalendar();

        var year =
            calendar.GetYear(date.Value);

        var month =
            calendar.GetMonth(date.Value);

        var day =
            calendar.GetDayOfMonth(date.Value);

        return $"{year:0000}/{month:00}/{day:00}";
    }
}