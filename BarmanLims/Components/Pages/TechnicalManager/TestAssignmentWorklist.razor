    private void OnDisplayGroupDepartmentChanged(
    AssignmentDisplayGroup group,
    Guid? departmentId)
    {
        group.DepartmentId = departmentId;

        foreach (var assignment in group.Assignments)
        {
            assignment.DepartmentId = departmentId;
        }
    }
    private async Task AssignDisplayGroupToDepartment(
    AssignmentDisplayGroup group)
    {
        try
        {
            ErrorMessage = "";

            var assignmentsWithoutDepartment =
                group.Assignments
                    .Where(x =>
                        !x.DepartmentId.HasValue ||
                        x.DepartmentId == Guid.Empty)
                    .ToList();

            if (assignmentsWithoutDepartment.Count > 0)
            {
                ErrorMessage =
                    $"ابتدا بخش {assignmentsWithoutDepartment.Count} آزمون را مشخص کنید.";

                return;
            }

            foreach (var assignment in group.Assignments)
            {
                await TestAssignmentService
                    .AssignToDepartmentAsync(
                        assignment.Id,
                        assignment.DepartmentId);
            }

            await ReloadAssignments();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }

    private async Task AssignSelectedDisplayGroupsByTestDepartment()
    {
        if (SelectedDisplayGroupKeys.Count == 0)
        {
            ErrorMessage = "حداقل یک نمونه را انتخاب کنید.";
            return;
        }

        try
        {
            ErrorMessage = "";

            var selectedGroups = DisplayGroups
                .Where(group =>
                    SelectedDisplayGroupKeys.Contains(
                        GetDisplayGroupKey(group)))
                .ToList();

            var incompleteSamples = selectedGroups
                .Where(group =>
                    group.Assignments.Any(x =>
                        !x.DepartmentId.HasValue ||
                        x.DepartmentId == Guid.Empty))
                .ToList();

            var completeGroups = selectedGroups
                .Except(incompleteSamples)
                .ToList();

            foreach (var group in completeGroups)
            {
                foreach (var assignment in group.Assignments)
                {
                    await TestAssignmentService
                        .AssignToDepartmentAsync(
                            assignment.Id,
                            assignment.DepartmentId);
                }
            }

            SelectedDisplayGroupKeys.Clear();

            await ReloadAssignments();
            StateHasChanged();

            if (incompleteSamples.Count > 0)
            {
                ErrorMessage =
                    $"{incompleteSamples.Count} نمونه به دلیل داشتن آزمون بدون بخش ارجاع نشد.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }

    private async Task AssignSelectedDisplayGroupsToDefaultDepartments()
    {
        if (SelectedDisplayGroupKeys.Count == 0)
        {
            ErrorMessage = "حداقل یک نمونه را انتخاب کنید.";
            return;
        }

        try
        {
            ErrorMessage = "";

            var selectedGroups =
                DisplayGroups
                    .Where(group =>
                        SelectedDisplayGroupKeys.Contains(
                            GetDisplayGroupKey(group)))
                    .ToList();

            var assignmentIds =
                selectedGroups
                    .SelectMany(group => group.Assignments)
                    .Select(assignment => assignment.Id)
                    .Where(id => id != Guid.Empty)
                    .Distinct()
                    .ToList();

            if (assignmentIds.Count == 0)
            {
                ErrorMessage =
                    "هیچ آزمونی برای ارجاع انتخاب نشده است.";

                return;
            }

            await TestAssignmentService
                .AssignToDefaultDepartmentsAsync(
                    assignmentIds);

            SelectedDisplayGroupKeys.Clear();

            var employeeId = CurrentUserService.EmployeeId;

            if (!employeeId.HasValue || employeeId.Value == Guid.Empty)
            {
                throw new InvalidOperationException(
                    "کاربر جاری به یک کارمند معتبر متصل نیست.");
            }

            Assignments =
                await TestAssignmentService
                    .GetPendingForTechnicalManagerAsync(
                        employeeId.Value);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }
    private async Task OpenResultApproval(
    TestAssignment assignment)
    {
        SelectedResultApproval = assignment;

