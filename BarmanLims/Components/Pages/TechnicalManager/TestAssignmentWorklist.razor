    private async Task ApproveSelectedResultAsync()
    {
        if (SelectedResultApproval is null)
            return;

        try
        {
            ErrorMessage = "";

            await TestAssignmentService
                .ApproveResultByTechManagerAsync(
                    SelectedResultApproval.Id);

            PendingResultApprovals.Remove(
                SelectedResultApproval);

            SelectedResultApproval = null;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }
    private async Task RejectSelectedResultAsync()
    {
        if (SelectedResultApproval is null)
            return;
        if (string.IsNullOrWhiteSpace(RejectReason))
        {
            ErrorMessage = "دلیل رد نتیجه را وارد کنید.";
            return;
        }

        try
        {
            ErrorMessage = "";

            await TestAssignmentService
                .RejectResultByTechnicalManagerAsync(
                    SelectedResultApproval.Id,
                    RejectReason);

            PendingResultApprovals.Remove(
                SelectedResultApproval);

            SelectedResultApproval = null;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }
    private bool ShowCorrectionDialog;
    private AssignmentDisplayGroup? CorrectionGroup;
    private string CorrectionReason = "";

    private async Task OpenCorrectionDialog(
    AssignmentDisplayGroup group)
    {
        if (group.Assignments.Count == 0)
        {
            ErrorMessage = "برای این نمونه آزمونی پیدا نشد.";
            return;
        }

        var parameters = new DialogParameters
        {
            ["SampleCode"] = group.SampleCode
        };

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialog =
            await DialogService.ShowAsync<ReceptionCorrectionDialog>(
                "درخواست اصلاح پذیرش",
                parameters,
                options);

        var result =
            await dialog.Result;

        if (result.Canceled)
            return;

        var reason = result.Data?.ToString();

        if (string.IsNullOrWhiteSpace(reason))
        {
            ErrorMessage = "دلیل درخواست اصلاح باید مشخص شود.";
            return;
        }

        try
        {
            ErrorMessage = "";

            var assignment =
                group.Assignments.FirstOrDefault();

            if (assignment is null ||
                assignment.Sample is null)
            {
                ErrorMessage = "اطلاعات نمونه پیدا نشد.";
                return;
            }

            await TestAssignmentService
                .RequestReceptionCorrectionAsync(
                    assignment.Sample.ReceptionId,
                    group.SampleId,
                    reason);

            await ReloadAssignments();

            StateHasChanged();
        }
        catch (Exception ex)
        {
            ErrorMessage =
                $"خطا در ثبت درخواست اصلاح پذیرش: {ex.Message}";
        }
    }

    private void CloseCorrectionDialog()
    {
        ShowCorrectionDialog = false;
        CorrectionGroup = null;
        CorrectionReason = "";
    }
    private async Task RequestCorrectionAsync()
    {
        if (CorrectionGroup is null)
            return;

        if (string.IsNullOrWhiteSpace(CorrectionReason))
            return;

        try
        {
            ErrorMessage = "";

            var assignment = CorrectionGroup.Assignments.FirstOrDefault();

            if (assignment is null || assignment.Sample is null)
            {
                ErrorMessage = "نمونه انتخاب‌شده معتبر نیست.";
                return;
            }

            await TestAssignmentService.RequestReceptionCorrectionAsync(
                assignment.Sample.ReceptionId,
                CorrectionGroup.SampleId,
                CorrectionReason);

            CloseCorrectionDialog();

            await ReloadAssignments();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"خطا در ثبت درخواست اصلاح: {ex.Message}";
        }
    }
    
    private class AssignmentDisplayGroup
    {
        public Guid SampleId { get; set; }

        public Guid? DepartmentId { get; set; }

        public string SampleCode { get; set; } = "";

        public string SampleName { get; set; } = "";

        public List<TestAssignment> Assignments { get; set; } = new();

        public int AssignmentCount =>
            Assignments.Count;

        public int DepartmentStatusSortValue =>
            Assignments.Any(x =>
                !x.DepartmentId.HasValue ||
                x.DepartmentId == Guid.Empty)
                    ? 0
                    : 1;

        public string SortDisplayName
        {
            get
            {
                var names = Assignments
                    .Select(x => x.Test?.Name)
                    .Where(x => !string.IsNullOrWhiteSpace(x))
                    .Distinct()
                    .ToList();

                return string.Join("، ", names);
            }
        }
    }

    private class ResultApprovalStatusInfo
    {
        public Guid AssignmentId { get; set; }

        public ResultSetStatus Status { get; set; }

        public int ResultCount { get; set; }

        public int RequiredResultCount { get; set; }

        public int OutOfLimitCount { get; set; }

        public bool HasAnyLimit { get; set; }
    }
