@page "/roles"

@using Barman.Domain.Entities
@using Barman.Application.Interfaces.Repositories
@using Barman.Application.Interfaces

@inject IRoleService RoleService
@inject IRolePermissionService RolePermissionService


<PageTitle>مدیریت نقش‌ها</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-4">

    <MudPaper Class="pa-5">

        <MudText Typo="Typo.h5" Class="mb-4">
            مدیریت نقش‌ها
        </MudText>

        <MudGrid>

            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="Code"
                              Label="کد نقش"
                              Variant="Variant.Outlined"
                              Required="true" />
            </MudItem>

            <MudItem xs="12" sm="8">
                <MudTextField @bind-Value="Name"
                              Label="نام نقش"
                              Variant="Variant.Outlined"
                              Required="true" />
            </MudItem>

            <MudItem xs="12">
                <MudTextField @bind-Value="Description"
                              Label="توضیحات"
                              Variant="Variant.Outlined" />
            </MudItem>

        </MudGrid>

        <MudButton Class="mt-4"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="SaveAsync">

            @(EditingId == Guid.Empty ? "افزودن نقش" : "ذخیره تغییرات")

        </MudButton>
        <MudButton Class="mt-4 ml-2"
                   Variant="Variant.Outlined"
                   Color="Color.Warning"
                   OnClick="ShowDeletedItems">

            موارد حذف‌شده

        </MudButton>
        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <MudAlert Severity="@MessageSeverity"
                      Class="mt-4">

                @Message

            </MudAlert>
        }

    </MudPaper>


    <MudPaper Class="pa-5 mt-5">

        <MudText Typo="Typo.h6" Class="mb-3">
            نقش‌های سیستم
        </MudText>

        <MudTable Items="RoleList"
                  Dense="true"
                  Hover="true"
                  Bordered="true">

            <HeaderContent>
                <MudTh>کد</MudTh>
                <MudTh>نام نقش</MudTh>
                <MudTh>توضیحات</MudTh>
                <MudTh>وضعیت</MudTh>
                <MudTh>عملیات</MudTh>
            </HeaderContent>

            <RowTemplate>

                <MudTd>@context.Code</MudTd>

                <MudTd>@context.Name</MudTd>

                <MudTd>
                    @(context.Description ?? "-")
                </MudTd>

                <MudTd>

                    @if (context.IsActive)
                    {
                        <MudChip T="string"
                                 Color="Color.Success"
                                 Size="Size.Small">
                            فعال
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string"
                                 Color="Color.Error"
                                 Size="Size.Small">
                            غیرفعال
                        </MudChip>
                    }

                </MudTd>
                <MudButton Size="Size.Small"
                           Variant="Variant.Text"
                           Color="Color.Error"
                           OnClick="@(() => Delete(context.Id))">

                    حذف

                </MudButton>
                <MudTd>

                    <MudButton Size="Size.Small"
                               Variant="Variant.Outlined"
                               Color="Color.Primary"
                               OnClick="@(() => Edit(context))">

                        ویرایش

                    </MudButton>
                    <MudButton Size="Size.Small"
                               Variant="Variant.Outlined"
                               Color="Color.Info"
                               OnClick="@(() => OpenPermissions(context))">

                        دسترسی‌ها

                    </MudButton>


                </MudTd>
                @if (context.IsActive)
                {
                    <MudButton Size="Size.Small"
                               Variant="Variant.Text"
                               Color="Color.Warning"
                               OnClick="@(() => Deactivate(context.Id))">

                        غیرفعال

                    </MudButton>
                }
                else
                {
                    <MudButton Size="Size.Small"
                               Variant="Variant.Text"
                               Color="Color.Success"
                               OnClick="@(() => Activate(context.Id))">

                        فعال

                    </MudButton>
                }
            </RowTemplate>

        </MudTable>
        @if (DeletedDialogVisible)
        {
            <MudDialog @bind-Visible="DeletedDialogVisible">

                <DialogContent>

                    <MudText Typo="Typo.h6" Class="mb-3">
                        نقش‌های حذف‌شده
                    </MudText>

                    <MudTable Items="DeletedRoleList"
                              Dense="true"
                              Hover="true"
                              Bordered="true">

                        <HeaderContent>
                            <MudTh>کد</MudTh>
                            <MudTh>نام نقش</MudTh>
                            <MudTh>توضیحات</MudTh>
                            <MudTh>عملیات</MudTh>
                        </HeaderContent>

                        <RowTemplate>

                            <MudTd>@context.Code</MudTd>

                            <MudTd>@context.Name</MudTd>

                            <MudTd>
                                @(context.Description ?? "-")
                            </MudTd>

                            <MudTd>

                                <MudButton Size="Size.Small"
                                           Variant="Variant.Text"
                                           Color="Color.Success"
                                           OnClick="@(() => Restore(context.Id))">

                                    بازیابی

                                </MudButton>

                            </MudTd>

                        </RowTemplate>

                    </MudTable>

                </DialogContent>

                <DialogActions>

                    <MudButton Color="Color.Secondary"
                               OnClick="ClosePermissionDialog">

                        بستن

                    </MudButton>

                </DialogActions>

            </MudDialog>
        }
    </MudPaper>

</MudContainer>

<MudDialog @bind-Visible="PermissionDialogVisible">

    <DialogContent>

        <MudText Typo="Typo.h6" Class="mb-4">
            مدیریت دسترسی‌های نقش
        </MudText>

        @if (PermissionRole is not null)
        {
            <MudText Typo="Typo.subtitle1" Class="mb-3">
                نقش:
                <b>@PermissionRole.Name</b>
            </MudText>
        }

        <MudTable Items="PermissionList"
                  Dense="true"
                  Hover="true"
                  Bordered="true">

            <HeaderContent>
                <MudTh>کد</MudTh>
                <MudTh>دسترسی</MudTh>
                <MudTh>فعال</MudTh>
            </HeaderContent>

            <RowTemplate>

                <MudTd>
                    @context.Code
                </MudTd>

                <MudTd>
                    @context.Name
                </MudTd>

                <MudTd>

                    <MudCheckBox T="bool"
                                 Value="@SelectedPermissionIds.Contains(context.Id)"
                                 ValueChanged="@((bool value) => TogglePermission(context.Id, value))" />

                </MudTd>

            </RowTemplate>

        </MudTable>

    </DialogContent>

    <DialogActions>

        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="SavePermissionsAsync">

            ذخیره دسترسی‌ها

        </MudButton>

        <MudButton Color="Color.Secondary"
                   OnClick="ClosePermissionDialog">

            بستن

        </MudButton>

    </DialogActions>

</MudDialog>

@code {

    private List<Role> RoleList = new();

    private List<Role> DeletedRoleList = new();

    private bool DeletedDialogVisible;

    private bool PermissionDialogVisible;

    private Role? PermissionRole;

    private List<Permission> PermissionList = new();

    private HashSet<Guid> SelectedPermissionIds = new();

    private Guid EditingId = Guid.Empty;

    private string Code = "";
    private string Name = "";
    private string? Description;

    private string? Message;
    private Severity MessageSeverity = Severity.Info;


    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }


    private async Task LoadAsync()
    {
        RoleList = await RoleService.GetAllAsync();
    }


    private async Task SaveAsync()
    {
        Message = null;

        if (string.IsNullOrWhiteSpace(Code) ||
            string.IsNullOrWhiteSpace(Name))
        {
            Message = "کد و نام نقش الزامی است.";
            MessageSeverity = Severity.Error;
            return;
        }

        var duplicate = RoleList.Any(x =>
            x.Code.Equals(
                Code.Trim(),
                StringComparison.OrdinalIgnoreCase)
            && x.Id != EditingId);

        if (duplicate)
        {
            Message = "این کد نقش قبلاً ثبت شده است.";
            MessageSeverity = Severity.Error;
            return;
        }

        if (EditingId == Guid.Empty)
        {
            await RoleService.CreateAsync(new Role
            {
                Code = Code.Trim(),
                Name = Name.Trim(),
                Description = string.IsNullOrWhiteSpace(Description)
                    ? null
                    : Description.Trim()
            });
        }
        else
        {
            var role =
                await RoleService.GetByIdAsync(EditingId);

            if (role is null)
            {
                Message = "نقش پیدا نشد.";
                MessageSeverity = Severity.Error;
                return;
            }

            role.Code = Code.Trim();
            role.Name = Name.Trim();
            role.Description =
                string.IsNullOrWhiteSpace(Description)
                    ? null
                    : Description.Trim();

            await RoleService.UpdateAsync(role);
        }

        

        ClearForm();
        await LoadAsync();

        Message = "نقش با موفقیت ذخیره شد.";
        MessageSeverity = Severity.Success;
    }


    private void Edit(Role role)
    {
        EditingId = role.Id;
        Code = role.Code;
        Name = role.Name;
        Description = role.Description;
        Message = null;
    }


    private void ClearForm()
    {
        EditingId = Guid.Empty;
        Code = "";
        Name = "";
        Description = null;
    }
    private async Task Activate(Guid id)
    {
        await RoleService.ActivateAsync(id);
        await LoadAsync();
    }

    private async Task Deactivate(Guid id)
    {
        await RoleService.DeactivateAsync(id);
        await LoadAsync();
    }
    private async Task Delete(Guid id)
    {
        await RoleService.DeleteAsync(id);
        await LoadAsync();
    }
    private async Task ShowDeletedItems()
    {
        DeletedRoleList =
            await RoleService.GetDeletedAsync();

        DeletedDialogVisible = true;
    }
    private async Task Restore(Guid id)
    {
        await RoleService.RestoreAsync(id);

        await LoadAsync();

        DeletedRoleList =
            await RoleService.GetDeletedAsync();
    }


    private void CloseDeletedDialog()
    {
        DeletedDialogVisible = false;
    }

    private async Task OpenPermissions(Role role)
    {
        PermissionRole = role;

        PermissionList =
          (await RolePermissionService.GetAllPermissionsAsync())
             .OrderBy(x => x.Code)
             .ToList();

        var rolePermissions =
            await RolePermissionService.GetByRoleIdAsync(role.Id);

        SelectedPermissionIds =
            rolePermissions
                .Select(x => x.Id)
                .ToHashSet();

        PermissionDialogVisible = true;
    }
    private void TogglePermission(Guid permissionId, bool value)
    {
        if (value)
        {
            SelectedPermissionIds.Add(permissionId);
        }
        else
        {
            SelectedPermissionIds.Remove(permissionId);
        }
    }

    private async Task SavePermissionsAsync()
    {
        if (PermissionRole is null)
            return;

        await RolePermissionService.SavePermissionsAsync(
            PermissionRole.Id,
            SelectedPermissionIds);

        PermissionDialogVisible = false;

        await InvokeAsync(StateHasChanged);
    }

    private async Task ClosePermissionDialog()
    {
        PermissionDialogVisible = false;

        await InvokeAsync(StateHasChanged);
    }
}
