@page "/roles"

@using Barman.Domain.Entities
@using Barman.Application.Interfaces.Repositories

@inject IGenericRepository<Role> RoleRepository
@inject Barman.Application.Interfaces.IUnitOfWork UnitOfWork

<PageTitle>مدیریت نقش‌ها</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-4">

    <MudPaper Class="pa-5">

        <MudText Typo="Typo.h5" Class="mb-4">
            مدیریت نقش‌ها
        </MudText>

        <MudGrid>

            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="Code"
                              Label="کد نقش"
                              Variant="Variant.Outlined"
                              Required="true" />
            </MudItem>

            <MudItem xs="12" sm="8">
                <MudTextField @bind-Value="Name"
                              Label="نام نقش"
                              Variant="Variant.Outlined"
                              Required="true" />
            </MudItem>

            <MudItem xs="12">
                <MudTextField @bind-Value="Description"
                              Label="توضیحات"
                              Variant="Variant.Outlined" />
            </MudItem>

        </MudGrid>

        <MudButton Class="mt-4"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="SaveAsync">

            @(EditingId == Guid.Empty ? "افزودن نقش" : "ذخیره تغییرات")

        </MudButton>

        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <MudAlert Severity="@MessageSeverity"
                      Class="mt-4">

                @Message

            </MudAlert>
        }

    </MudPaper>


    <MudPaper Class="pa-5 mt-5">

        <MudText Typo="Typo.h6" Class="mb-3">
            نقش‌های سیستم
        </MudText>

        <MudTable Items="RoleList"
                  Dense="true"
                  Hover="true"
                  Bordered="true">

            <HeaderContent>
                <MudTh>کد</MudTh>
                <MudTh>نام نقش</MudTh>
                <MudTh>توضیحات</MudTh>
                <MudTh>عملیات</MudTh>
            </HeaderContent>

            <RowTemplate>

                <MudTd>@context.Code</MudTd>

                <MudTd>@context.Name</MudTd>

                <MudTd>
                    @(context.Description ?? "-")
                </MudTd>

                <MudTd>

                    <MudButton Size="Size.Small"
                               Variant="Variant.Outlined"
                               Color="Color.Primary"
                               OnClick="@(() => Edit(context))">

                        ویرایش

                    </MudButton>

                </MudTd>

            </RowTemplate>

        </MudTable>

    </MudPaper>

</MudContainer>


@code {

    private List<Role> RoleList = new();

    private Guid EditingId = Guid.Empty;

    private string Code = "";
    private string Name = "";
    private string? Description;

    private string? Message;
    private Severity MessageSeverity = Severity.Info;


    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }


    private async Task LoadAsync()
    {
        RoleList = await RoleRepository.GetAllAsync();
    }


    private async Task SaveAsync()
    {
        Message = null;

        if (string.IsNullOrWhiteSpace(Code) ||
            string.IsNullOrWhiteSpace(Name))
        {
            Message = "کد و نام نقش الزامی است.";
            MessageSeverity = Severity.Error;
            return;
        }

        var duplicate = RoleList.Any(x =>
            x.Code.Equals(
                Code.Trim(),
                StringComparison.OrdinalIgnoreCase)
            && x.Id != EditingId);

        if (duplicate)
        {
            Message = "این کد نقش قبلاً ثبت شده است.";
            MessageSeverity = Severity.Error;
            return;
        }

        if (EditingId == Guid.Empty)
        {
            await RoleRepository.AddAsync(new Role
            {
                Code = Code.Trim(),
                Name = Name.Trim(),
                Description = string.IsNullOrWhiteSpace(Description)
                    ? null
                    : Description.Trim()
            });
        }
        else
        {
            var role =
                await RoleRepository.GetByIdAsync(EditingId);

            if (role is null)
            {
                Message = "نقش پیدا نشد.";
                MessageSeverity = Severity.Error;
                return;
            }

            role.Code = Code.Trim();
            role.Name = Name.Trim();
            role.Description =
                string.IsNullOrWhiteSpace(Description)
                    ? null
                    : Description.Trim();

            RoleRepository.Update(role);
        }

        await UnitOfWork.SaveChangesAsync();

        ClearForm();
        await LoadAsync();

        Message = "نقش با موفقیت ذخیره شد.";
        MessageSeverity = Severity.Success;
    }


    private void Edit(Role role)
    {
        EditingId = role.Id;
        Code = role.Code;
        Name = role.Name;
        Description = role.Description;
        Message = null;
    }


    private void ClearForm()
    {
        EditingId = Guid.Empty;
        Code = "";
        Name = "";
        Description = null;
    }
}