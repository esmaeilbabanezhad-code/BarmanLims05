@page "/standard-samples"

@using MudBlazor
@using Barman.Application.Interfaces
@using Barman.Application.DTOs.StandardSample
@using Barman.Domain.Entities

@inject IStandardSampleService StandardSampleService
@inject IMatrixService MatrixService
@inject ISampleCategoryService SampleCategoryService
@inject INumberSequenceService NumberSequenceService

<MudPaper Class="pa-4">

    <div class="d-flex justify-space-between">

        <MudText Typo="Typo.h5">
            Standard Sample List
        </MudText>

        <div>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="NewStandardSample">
                New
            </MudButton>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       Class="ms-2"
                       OnClick="ShowDeleted">
                Deleted Items
            </MudButton>
        </div>

    </div>

    <MudDivider Class="my-3" />

    @if (!ShowDeletedItems)
    {
        <MudTable Items="StandardSampleList"
                  Hover="true"
                  Dense="true">

            <HeaderContent>
                <MudTh>Code</MudTh>
                <MudTh>Name</MudTh>
                <MudTh>Sample Category</MudTh>
                <MudTh>Matrix</MudTh>
                <MudTh>Description</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Action</MudTh>
            </HeaderContent>

            <RowTemplate>

                <MudTd>@context.Code</MudTd>

                <MudTd>@context.Name</MudTd>

                <MudTd>
                    @context.SampleCategory?.Name
                </MudTd>

                <MudTd>
                    @context.Matrix?.Name
                </MudTd>

                <MudTd>
                    @context.Description
                </MudTd>

                <MudTd>
                    @if (context.IsActive)
                    {
                        <MudChip T="string"
                                 Color="Color.Success">
                            Active
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string"
                                 Color="Color.Error">
                            Inactive
                        </MudChip>
                    }
                </MudTd>

                <MudTd>

                    <MudButton Size="Size.Small"
                               Variant="Variant.Outlined"
                               Color="Color.Primary"
                               OnClick="@(() => Edit(context))">
                        Edit
                    </MudButton>

                    @if (context.IsActive)
                    {
                        <MudButton Size="Size.Small"
                                   Variant="Variant.Text"
                                   Color="Color.Warning"
                                   Class="ms-2"
                                   OnClick="@(() => Deactivate(context.Id))">
                            Disable
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Size="Size.Small"
                                   Variant="Variant.Text"
                                   Color="Color.Success"
                                   Class="ms-2"
                                   OnClick="@(() => Activate(context.Id))">
                            Activate
                        </MudButton>
                    }

                    <MudButton Size="Size.Small"
                               Variant="Variant.Text"
                               Color="Color.Error"
                               Class="ms-2"
                               OnClick="@(() => Delete(context.Id))">
                        Delete
                    </MudButton>

                </MudTd>

            </RowTemplate>

        </MudTable>
    }
    else
    {
        <div class="d-flex justify-space-between mb-3">

            <MudText Typo="Typo.h6">
                Deleted Standard Samples
            </MudText>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       OnClick="ShowMainList">
                Back to Standard Sample List
            </MudButton>

        </div>

        <MudTable Items="DeletedStandardSampleList"
                  Hover="true"
                  Dense="true">

            <HeaderContent>
                <MudTh>Code</MudTh>
                <MudTh>Name</MudTh>
                <MudTh>Sample Category</MudTh>
                <MudTh>Matrix</MudTh>
                <MudTh>Description</MudTh>
                <MudTh>Action</MudTh>
            </HeaderContent>

            <RowTemplate>

                <MudTd>@context.Code</MudTd>

                <MudTd>@context.Name</MudTd>

                <MudTd>
                    @context.SampleCategory?.Name
                </MudTd>

                <MudTd>
                    @context.Matrix?.Name
                </MudTd>

                <MudTd>
                    @context.Description
                </MudTd>

                <MudTd>

                    <MudButton Size="Size.Small"
                               Variant="Variant.Outlined"
                               Color="Color.Success"
                               OnClick="@(() => Restore(context.Id))">
                        Restore
                    </MudButton>

                </MudTd>

            </RowTemplate>

        </MudTable>
    }

    <MudDialog @bind-Visible="DialogVisible">

        <DialogContent>

            <MudTextField Label="Code"
                          @bind-Value="CurrentStandardSample.Code"
                          ReadOnly="true" />

            <MudTextField Label="Name"
                          @bind-Value="CurrentStandardSample.Name" />

            <MudSelect T="Guid"
                       Label="Sample Category"
                       @bind-Value="CurrentStandardSample.SampleCategoryId">

                @foreach (var category in Categories)
                {
                    <MudSelectItem T="Guid"
                                   Value="@category.Id">
                        @category.Name
                    </MudSelectItem>
                }

            </MudSelect>

            <MudSelect T="Guid"
                       Label="Matrix"
                       @bind-Value="CurrentStandardSample.MatrixId">

                @foreach (var matrix in Matrices
                                .Where(x => x.SampleCategoryId ==
                                CurrentStandardSample.SampleCategoryId)
                                .OrderBy(x => x.Name))
                {
                    <MudSelectItem T="Guid"
                                   Value="@matrix.Id">
                        @matrix.Name
                    </MudSelectItem>
                }

            </MudSelect>

            <MudTextField Label="Description"
                          Lines="3"
                          @bind-Value="CurrentStandardSample.Description" />

        </DialogContent>

        <DialogActions>

            <MudButton Color="Color.Primary"
                       OnClick="SaveStandardSample">
                Save
            </MudButton>

            <MudButton Color="Color.Secondary"
                       OnClick="CloseDialog">
                Cancel
            </MudButton>

        </DialogActions>

    </MudDialog>

</MudPaper>

@code {

    private List<StandardSample> StandardSampleList = new();

    private List<StandardSample> DeletedStandardSampleList = new();

    private List<SampleCategory> Categories = new();

    private List<Matrix> Matrices = new();

    private StandardSample CurrentStandardSample = new();

    private bool DialogVisible;

    private bool IsEdit;

    private bool ShowDeletedItems;


    protected override async Task OnInitializedAsync()
    {
        await Load();
    }


    private async Task Load()
    {
        StandardSampleList =
            (await StandardSampleService.GetAllAsync())
            .Where(x => !x.IsDeleted)
            .OrderBy(x => x.Name)
            .ToList();

        Categories =
            await SampleCategoryService.GetAllAsync();

        Matrices =
            (await MatrixService.GetAllAsync())
            .Where(x => !x.IsDeleted)
            .OrderBy(x => x.Name)
            .ToList();
    }


    private async Task ShowDeleted()
    {
        DeletedStandardSampleList =
            await StandardSampleService.GetAllAsync();

        DeletedStandardSampleList =
            DeletedStandardSampleList
                .Where(x => x.IsDeleted)
                .ToList();

        ShowDeletedItems = true;
    }


    private async Task ShowMainList()
    {
        ShowDeletedItems = false;

        await Load();
    }


    private async Task NewStandardSample()
    {
        try
        {
            var code =
                await NumberSequenceService
                    .GetNextCodeAsync("StandardSample");

            CurrentStandardSample = new StandardSample
            {
                Code = code,
                IsActive = true,
                IsDeleted = false,
                SampleCategoryId =
                    Categories.FirstOrDefault()?.Id
                    ?? Guid.Empty,
                MatrixId = Guid.Empty
            };

            IsEdit = false;

            DialogVisible = true;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"خطا در تولید کد StandardSample: {ex.Message}");
        }
    }


    private void Edit(StandardSample standardSample)
    {
        CurrentStandardSample = new StandardSample
        {
            Id = standardSample.Id,
            Code = standardSample.Code,
            Name = standardSample.Name,
            Description = standardSample.Description,
            SampleCategoryId = standardSample.SampleCategoryId,
            MatrixId = standardSample.MatrixId,
            IsActive = standardSample.IsActive,
            IsDeleted = standardSample.IsDeleted
        };

        IsEdit = true;

        DialogVisible = true;
    }


    private async Task SaveStandardSample()
    {
        if (IsEdit)
        {
            await StandardSampleService.UpdateAsync(
                CurrentStandardSample.Id,
                new UpdateStandardSampleDto
                {
                    Code = CurrentStandardSample.Code,
                    Name = CurrentStandardSample.Name,
                    Description = CurrentStandardSample.Description,
                    SampleCategoryId =
                        CurrentStandardSample.SampleCategoryId,
                    MatrixId =
                        CurrentStandardSample.MatrixId
                });
        }
        else
        {
            await StandardSampleService.CreateAsync(
                new CreateStandardSampleDto
                {
                    Code = CurrentStandardSample.Code,
                    Name = CurrentStandardSample.Name,
                    Description = CurrentStandardSample.Description,
                    SampleCategoryId =
                        CurrentStandardSample.SampleCategoryId,
                    MatrixId =
                        CurrentStandardSample.MatrixId
                });
        }

        DialogVisible = false;

        await Load();
    }


    private async Task Activate(Guid id)
    {
        var item =
            await StandardSampleService.GetByIdAsync(id);

        if (item == null)
            return;

        item.IsActive = true;

        await StandardSampleService.UpdateAsync(
            id,
            new UpdateStandardSampleDto
            {
                Code = item.Code,
                Name = item.Name,
                Description = item.Description,
                SampleCategoryId = item.SampleCategoryId,
                MatrixId = item.MatrixId
            });

        await Load();
    }


    private async Task Deactivate(Guid id)
    {
        await StandardSampleService.DeleteAsync(id);

        await Load();
    }


    private async Task Delete(Guid id)
    {
        await StandardSampleService.DeleteAsync(id);

        await Load();
    }


    private async Task Restore(Guid id)
    {
        await StandardSampleService.RestoreAsync(id);

        await Load();
    }


    private void CloseDialog()
    {
        DialogVisible = false;
    }
}