@page "/samplecategories"

@using MudBlazor
@using Barman.Application.DTOs.SampleCategory
@using Barman.Application.Interfaces
@using Barman.Domain.Entities

@inject ISampleCategoryService SampleCategoryService

<MudPaper Class="pa-4">

    <div class="d-flex justify-space-between">

        <MudText Typo="Typo.h5">
            Sample Category List
        </MudText>

        <MudButton Variant="Variant.Outlined"
                   Color="Color.Secondary"
                   OnClick="ShowDeletedItems">
            Deleted Items
        </MudButton>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="NewSampleCategory">
            New
        </MudButton>

    </div>

    <MudDivider Class="my-3" />

    <MudTable Items="SampleCategoryList"
              Hover="true"
              Dense="true">

        <HeaderContent>

            <MudTh>Code</MudTh>
            <MudTh>Name</MudTh>
            <MudTh>Description</MudTh>
            <MudTh>Status</MudTh>
            <MudTh></MudTh>

        </HeaderContent>

        <RowTemplate>

            <MudTd>
                @context.Code
            </MudTd>

            <MudTd>
                @context.Name
            </MudTd>

            <MudTd>
                @context.Description
            </MudTd>

            <MudTd>

                @if (context.IsActive)
                {
                    <MudChip T="string"
                             Color="Color.Success">
                        Active
                    </MudChip>
                }
                else
                {
                    <MudChip T="string"
                             Color="Color.Error">
                        Inactive
                    </MudChip>
                }

            </MudTd>

            <MudTd>

                <MudButton Size="Size.Small"
                           Variant="Variant.Outlined"
                           Color="Color.Primary"
                           OnClick="@(() => Edit(context))">

                    Edit

                </MudButton>

                @if (context.IsActive)
                {
                    <MudButton Size="Size.Small"
                               Variant="Variant.Text"
                               Color="Color.Warning"
                               OnClick="@(() => Deactivate(context.Id))">

                        Disable

                    </MudButton>
                }
                else
                {
                    <MudButton Size="Size.Small"
                               Variant="Variant.Text"
                               Color="Color.Success"
                               OnClick="@(() => Activate(context.Id))">

                        Activate

                    </MudButton>
                }

                <MudButton Size="Size.Small"
                           Variant="Variant.Text"
                           Color="Color.Error"
                           OnClick="@(() => Delete(context.Id))">

                    Delete

                </MudButton>

            </MudTd>

        </RowTemplate>

    </MudTable>


    <MudDialog @bind-Visible="DialogVisible">

        <DialogContent>

            <MudTextField Label="Code"
                          @bind-Value="CurrentCategory.Code" />

            <MudTextField Label="Name"
                          @bind-Value="CurrentCategory.Name" />

            <MudTextField Label="Description"
                          Lines="3"
                          @bind-Value="CurrentCategory.Description" />

        </DialogContent>

        <DialogActions>

            <MudButton Color="Color.Primary"
                       OnClick="SaveSampleCategory">

                Save

            </MudButton>

            <MudButton Color="Color.Secondary"
                       OnClick="CloseDialog">

                Cancel

            </MudButton>

        </DialogActions>

    </MudDialog>

    <MudDialog @bind-Visible="DeletedDialogVisible">

        <DialogContent>

            <MudText Typo="Typo.h6" Class="mb-3">
                Deleted Sample Categories
            </MudText>

            <MudTable Items="DeletedSampleCategoryList"
                      Hover="true"
                      Dense="true">

                <HeaderContent>
                    <MudTh>Code</MudTh>
                    <MudTh>Name</MudTh>
                    <MudTh>Description</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>

                <RowTemplate>

                    <MudTd>@context.Code</MudTd>

                    <MudTd>@context.Name</MudTd>

                    <MudTd>@context.Description</MudTd>

                    <MudTd>

                        <MudButton Size="Size.Small"
                                   Variant="Variant.Text"
                                   Color="Color.Success"
                                   OnClick="@(() => Restore(context.Id))">
                            Restore
                        </MudButton>

                    </MudTd>

                </RowTemplate>

            </MudTable>

        </DialogContent>

        <DialogActions>

            <MudButton Color="Color.Secondary"
                       OnClick="CloseDeletedDialog">
                Close
            </MudButton>

        </DialogActions>

    </MudDialog>

</MudPaper>


@code {

    private List<SampleCategory> SampleCategoryList = new();

    private SampleCategory CurrentCategory = new();

    private bool DialogVisible;

    private bool IsEdit;

    private List<SampleCategory> DeletedSampleCategoryList = new();

    private bool DeletedDialogVisible;


    protected override async Task OnInitializedAsync()
    {
        await Load();
    }


    private async Task Load()
    {
        SampleCategoryList =
            (await SampleCategoryService.GetAllAsync())
            .Where(x => !x.IsDeleted)
            .OrderBy(x => x.Name)
            .ToList();
    }


    private void NewSampleCategory()
    {
        CurrentCategory = new SampleCategory
        {
            IsActive = true,
            IsDeleted = false
        };

        IsEdit = false;

        DialogVisible = true;
    }


    private void Edit(SampleCategory category)
    {
        CurrentCategory = new SampleCategory
        {
            Id = category.Id,
            Code = category.Code,
            Name = category.Name,
            Description = category.Description,
            IsActive = category.IsActive,
            IsDeleted = category.IsDeleted
        };

        IsEdit = true;

        DialogVisible = true;
    }


    private async Task SaveSampleCategory()
    {
        if (IsEdit)
        {
            await SampleCategoryService.UpdateAsync(
                CurrentCategory.Id,
                new UpdateSampleCategoryDto
                {
                    Code = CurrentCategory.Code,
                    Name = CurrentCategory.Name,
                    Description = CurrentCategory.Description,
                    IsActive = CurrentCategory.IsActive
                });
        }
        else
        {
            await SampleCategoryService.CreateAsync(
                new CreateSampleCategoryDto
                {
                    Code = CurrentCategory.Code,
                    Name = CurrentCategory.Name,
                    Description = CurrentCategory.Description
                });
        }

        DialogVisible = false;

        await Load();
    }


    private async Task Activate(Guid id)
    {
        await SampleCategoryService.ActivateAsync(id);

        await Load();
    }


    private async Task Deactivate(Guid id)
    {
        await SampleCategoryService.DeactivateAsync(id);

        await Load();
    }


    private async Task Delete(Guid id)
    {
        await SampleCategoryService.DeleteAsync(id);

        await Load();
    }


    private void CloseDialog()
    {
        DialogVisible = false;
    }

    private async Task ShowDeletedItems()
    {
        DeletedSampleCategoryList =
            await SampleCategoryService.GetDeletedAsync();

        DeletedDialogVisible = true;
    }

    private async Task Restore(Guid id)
    {
        await SampleCategoryService.RestoreAsync(id);

        await Load();

        DeletedSampleCategoryList =
            await SampleCategoryService.GetDeletedAsync();
    }

    private void CloseDeletedDialog()
    {
        DeletedDialogVisible = false;
    }
}