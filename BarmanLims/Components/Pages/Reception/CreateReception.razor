@page "/reception/create"

@using MudBlazor
@using Barman.Application.DTOs.Reception
@using Barman.Application.DTOs.Customer
@using Barman.Application.DTOs.SampleCategory
@using Barman.Domain.Entities
@using Barman.Application.DTOs.Test
@using Barman.Application.Interfaces
@using Barman.Application.DTOs.CustomField
@using BarmanLims.Components.Authorization
@attribute [RequirePermission("Reception.View")]

@inject Barman.Application.Interfaces.ITestPanelService TestPanelService
@inject Barman.Application.Interfaces.IReceptionService ReceptionService
@inject Barman.Application.Interfaces.ICustomerService CustomerService
@inject Barman.Application.Interfaces.IMatrixService MatrixService
@inject Barman.Application.Interfaces.ISampleCategoryService SampleCategoryService
@inject Barman.Application.Interfaces.ITestService TestService
@inject Barman.Application.Interfaces.IStandardSampleService StandardSampleService
@inject Barman.Application.Interfaces.IDefaultTestSetService DefaultTestSetService
@inject Barman.Application.Interfaces.ICustomFieldService CustomFieldService
@inject NavigationManager NavigationManager
@inject ITestPanelService TestPanelService


<PageTitle>ثبت پذیرش</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="pa-4">

    <MudPaper Class="pa-6">

        <MudText Typo="Typo.h5">
            ثبت پذیرش
        </MudText>

        <MudDivider Class="my-4" />

        @* ============================= *@
        @* Customer                       *@
        @* ============================= *@

        <MudAutocomplete T="CustomerLookupDto"
                         Label="مشتری"
                         Variant="Variant.Outlined"
                         Dense="true"
                         Clearable="true"
                         SearchFunc="SearchCustomers"
                         ToStringFunc="@(x => x?.DisplayName ?? "")"
                         Value="SelectedCustomer"
                         ValueChanged="OnCustomerSelected"
                         ResetValueOnEmptyText="true"
                         CoerceText="true"
                         CoerceValue="true"
                         Disabled="@IsSaving" />
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.PersonAdd"
                   OnClick="OpenQuickCustomerDialog"
                   Disabled="@IsSaving">

            مشتری جدید

        </MudButton>
        @if (SelectedCustomerId != Guid.Empty)
        {
            <MudAutocomplete T="ReceptionHistoryLookupDto"
                             Label="استفاده از پذیرش قبلی"
                             Variant="Variant.Outlined"
                             Dense="true"
                             Clearable="true"
                             SearchFunc="SearchPreviousReceptions"
                             ToStringFunc="@(x => x == null
                                                      ? ""
                                                      : $"{x.ReceptionNumber} - {x.ReceptionDate:yyyy/MM/dd}")"
                         Value="SelectedPreviousReception"
                         ValueChanged="OnPreviousReceptionSelected"
                         ResetValueOnEmptyText="true"
                         CoerceText="true"
                         CoerceValue="true"
                         Disabled="@IsSaving"
                         Class="mt-3" />
                }
        @if (SelectedPreviousReception != null)
        {
            <MudPaper Class="pa-4 mt-3" Outlined="true">

                <MudText Typo="Typo.subtitle1" Class="mb-3">
                    نمونه‌های پذیرش @SelectedPreviousReception.ReceptionNumber
                </MudText>

                <MudSelect T="ReceptionHistorySampleDto"
                           Label="انتخاب نمونه"
                           Variant="Variant.Outlined"
                           Dense="true"
                           Clearable="true"
                           Value="SelectedPreviousSample"
                           ValueChanged="OnPreviousSampleSelected"
                           Disabled="@IsSaving">

                @foreach (var previousSample in SelectedPreviousReception.Samples)
                    {
                        <MudSelectItem T="ReceptionHistorySampleDto"
                                       Value="previousSample">
                            @previousSample.SampleName
                            (@previousSample.SampleCode)
                        </MudSelectItem>
                    }

                </MudSelect>

            </MudPaper>
        }
        @if (SelectedPreviousSample != null)
        {
            <MudPaper Class="pa-4 mt-3" Outlined="true">

                <MudText Typo="Typo.subtitle1" Class="mb-3">
                    آزمون‌های نمونه قبلی
                </MudText>

                @foreach (var panelGroup in SelectedPreviousSample.Tests
                            .Where(x => x.TestPanelId.HasValue)
                            .GroupBy(x => x.TestPanelId))
                {
                    var panel = panelGroup.First();

                    <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">
                        Panel: @panel.TestPanelName
                        (@panel.TestPanelCode)
                    </MudText>

                    @foreach (var test in panelGroup)
                    {
                        <MudCheckBox T="bool"
                                     Label="@($"{test.TestName} ({test.TestCode})")"
                                     Value="@SelectedPreviousTestIds.Contains(test.TestId)"
                                     ValueChanged="@(checkedValue =>
                                                                  {
                                                                      if (checkedValue)
                                                                          SelectedPreviousTestIds.Add(test.TestId);
                                                                      else
                                                                          SelectedPreviousTestIds.Remove(test.TestId);
                                                                  })"
                         Disabled="@IsSaving" />
                        }
                }

                @* آزمون‌های مستقل *@

                @foreach (var test in SelectedPreviousSample.Tests
                            .Where(x => !x.TestPanelId.HasValue))
                {
                    <MudCheckBox T="bool"
                                 Label="@($"آزمون مستقل: {test.TestName} ({test.TestCode})")"
                                 Value="@SelectedPreviousTestIds.Contains(test.TestId)"
                                 ValueChanged="@(checkedValue =>
                                                          {
                                                              if (checkedValue)
                                                                  SelectedPreviousTestIds.Add(test.TestId);
                                                              else
                                                                  SelectedPreviousTestIds.Remove(test.TestId);
                                                          })"
                         Disabled="@IsSaving" />
                        }

            </MudPaper>
        }
        <MudDatePicker Label="تاریخ پذیرش"
                       Variant="Variant.Outlined"
                       @bind-Date="ReceptionDate"
                       Disabled="@IsSaving"
                       Class="mt-3" />

        <MudCheckBox @bind-Value="IsUrgent"
                     Label="فوری"
                     Class="mt-3"
                     Disabled="@IsSaving" />

        <MudTextField T="string"
                      Label="توضیحات پذیرش"
                      Variant="Variant.Outlined"
                      Lines="3"
                      @bind-Value="Description"
                      Class="mt-3"
                      Disabled="@IsSaving" />

        <MudDivider Class="my-5" />

        @* ============================= *@
        @* Samples                        *@
        @* ============================= *@

        <div class="d-flex justify-space-between align-center">

            <MudText Typo="Typo.h6">
                نمونه‌ها
            </MudText>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="AddSample"
                       Disabled="@IsSaving">

                افزودن نمونه

            </MudButton>

        </div>

        @if (Samples.Count == 0)
        {
            <MudAlert Severity="Severity.Info"
                      Class="mt-4">

                حداقل یک نمونه برای پذیرش اضافه کنید.

            </MudAlert>
        }
        else
        {
            @foreach (var sample in Samples)
            {
                var index = Samples.IndexOf(sample) + 1;

                <MudPaper Class="pa-4 mt-4"
                          Outlined="true">

                    <div class="d-flex justify-space-between align-center">

                        <MudText Typo="Typo.subtitle1">
                            نمونه @index
                        </MudText>

                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Disabled="@IsSaving"
                                       OnClick="@(() => RemoveSample(sample))" />

                    </div>

                    <MudDivider Class="my-3" />

                    <MudGrid>

                        @* ============================= *@
                        @* Sample Name                    *@
                        @* ============================= *@

                        <MudItem xs="12">

                            <MudTextField T="string"
                                          Label="نام نمونه"
                                          Variant="Variant.Outlined"
                                          Required="true"
                                          @bind-Value="sample.SampleName"
                                          Disabled="@IsSaving" />

                        </MudItem>

                        @* ============================= *@
                        @* Sample Product Information    *@
                        @* ============================= *@

                        <MudItem xs="12">

                            <MudTextField T="string"
                                          Label="نام نمونه از دید مشتری"
                                          Variant="Variant.Outlined"
                                          @bind-Value="sample.CustomerSampleName"
                                          Disabled="@IsSaving" />

                        </MudItem>

                        <MudItem xs="12" sm="6">

                            <BarmanDateInput Label="تاریخ تولید"
                                             @bind-Value="sample.ProductionDate"
                                             Disabled="@IsSaving" />

                        </MudItem>

                        <MudItem xs="12" sm="6">

                            <BarmanDateInput Label="تاریخ انقضا"
                                             @bind-Value="sample.ExpiryDate"
                                             Disabled="@IsSaving" />

                        </MudItem>

                        <MudItem xs="12" sm="6">

                            <MudTextField T="string"
                                          Label="شماره Batch / Lot"
                                          Variant="Variant.Outlined"
                                          @bind-Value="sample.BatchLotNumber"
                                          Disabled="@IsSaving" />

                        </MudItem>

                        <MudItem xs="12" sm="6">

                            <MudTextField T="string"
                                          Label="شماره کوتاژ"
                                          Variant="Variant.Outlined"
                                          @bind-Value="sample.QuotaNumber"
                                          Disabled="@IsSaving" />

                        </MudItem>

                        <MudItem xs="12" sm="6">

                            <MudTextField T="string"
                                          Label="شماره محموله"
                                          Variant="Variant.Outlined"
                                          @bind-Value="sample.ShipmentNumber"
                                          Disabled="@IsSaving" />

                        </MudItem>

                        @* ============================= *@
                        @* Sample Category               *@
                        @* ============================= *@

                        <MudItem xs="12" sm="6">

                            <MudSelect T="Guid?"
                                       Label="دسته‌بندی نمونه"
                                       Variant="Variant.Outlined"
                                       Required="true"
                                       @bind-Value="sample.SampleCategoryId"
                                       @bind-Value:after="@(() => OnSampleCategoryChanged(sample))"
                                       Disabled="@IsSaving">

                                @foreach (var category in SampleCategories)
                                {
                                    <MudSelectItem T="Guid?" Value="@category.Id">
                                        @category.Code - @category.Name
                                    </MudSelectItem>
                                }

                            </MudSelect>

                        </MudItem>


                        @* ============================= *@
                        @* Matrix                         *@
                        @* ============================= *@

                        <MudItem xs="12" sm="6">

                            <MudSelect T="Guid?"
                                       Label="ماتریس"
                                       Variant="Variant.Outlined"
                                       @bind-Value="sample.MatrixId"
                                       @bind-Value:after="@(() => OnMatrixChanged(sample))"
                                       Disabled="@IsSaving">

                                @foreach (var matrix in SampleMatrices[sample])
                                {
                                    <MudSelectItem T="Guid?" Value="@matrix.Id">
                                        @matrix.Name
                                    </MudSelectItem>
                                }

                            </MudSelect>

                        </MudItem>

                        @* ============================= *@
                        @* Standard Sample                *@
                        @* ============================= *@

                        <MudItem xs="12" sm="6">

                            <MudAutocomplete T="StandardSample"
                                             Label="Standard Sample"
                                             Variant="Variant.Outlined"
                                             Value="@(StandardSamples.FirstOrDefault(x => x.Id == sample.StandardSampleId))"
                                             ValueChanged="@((StandardSample? value) => OnStandardSampleSelected(sample, value))"
                                             SearchFunc="@((string value, CancellationToken token) => SearchStandardSamples(value, token))"
                                             ToStringFunc="@(x => x == null ? "" : $"{x.Code} - {x.Name}")"
                                             Clearable="true"
                                             Disabled="@IsSaving" />

                        </MudItem>

                        @* ============================= *@
                        @* Sample Quantity Information   *@
                        @* ============================= *@

                        <MudItem xs="12" sm="4">

                            <MudTextField T="decimal?"
                                          Label="مقدار"
                                          Variant="Variant.Outlined"
                                          InputType="InputType.Number"
                                          @bind-Value="sample.Quantity"
                                          Disabled="@IsSaving" />

                        </MudItem>

                        <MudItem xs="12" sm="4">

                            <MudTextField T="string"
                                          Label="واحد"
                                          Variant="Variant.Outlined"
                                          @bind-Value="sample.Unit"
                                          Disabled="@IsSaving" />

                        </MudItem>

                        <MudItem xs="12" sm="4">

                            <MudTextField T="string"
                                          Label="نوع ظرف"
                                          Variant="Variant.Outlined"
                                          @bind-Value="sample.ContainerType"
                                          Disabled="@IsSaving" />

                        </MudItem>

                        @* ============================= *@
                        @* Sample Description             *@
                        @* ============================= *@

                        <MudItem xs="12">

                            <MudTextField T="string"
                                          Label="توضیحات نمونه"
                                          Variant="Variant.Outlined"
                                          Lines="2"
                                          @bind-Value="sample.Description"
                                          Disabled="@IsSaving" />

                        </MudItem>

                        @* ============================= *@
                        @* Custom Fields                 *@
                        @* ============================= *@

                        @if (SampleCustomFields.TryGetValue(sample, out var customFields))
                        {
                            @if (customFields.Count > 0)
                            {
                                <MudGrid>
                                    @foreach (var field in customFields)
                                    {
                                        <MudItem xs="12" sm="6">
                                            @if (field.IsAdHoc)
                                            {
                                                <MudTextField T="string"
                                                              Label="عنوان فیلد"
                                                              Variant="Variant.Outlined"
                                                              @bind-Value="field.Title"
                                                              Immediate="true"
                                                              Disabled="@IsSaving"
                                                              FullWidth="true" />
                                            }
                                            else
                                            {
                                                <MudTextField T="string"
                                                              Label="@field.Title"
                                                              Variant="Variant.Outlined"
                                                              @bind-Value="field.Value"
                                                              Required="@field.IsRequired"
                                                              Disabled="@IsSaving"
                                                              Immediate="true"
                                                              FullWidth="true" />
                                            }
                                        </MudItem>

                                        @if (field.IsAdHoc)
                                        {
                                            <MudItem xs="12" sm="6">
                                                <MudStack Row="true"
                                                          AlignItems="AlignItems.Center"
                                                          Spacing="1">

                                                    <MudTextField T="string"
                                                                  Label="مقدار"
                                                                  Variant="Variant.Outlined"
                                                                  @bind-Value="field.Value"
                                                                  Immediate="true"
                                                                  Disabled="@IsSaving"
                                                                  FullWidth="true" />

                                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                                   Color="Color.Error"
                                                                   Disabled="@IsSaving"
                                                                   OnClick="@(() => RemoveAdHocCustomField(sample, field))" />
                                                </MudStack>
                                            </MudItem>
                                        }
                                    }
                                </MudGrid>
                            }
                        }
                        
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   Class="mt-3"
                                   Disabled="@IsSaving"
                                   OnClick="@(() => AddAdHocCustomField(sample))">
                            افزودن فیلد سفارشی
                        </MudButton>
                        }
                        @* ============================= *@
                        @* Tests                         *@
                        @* ============================= *@

                        <MudItem xs="12">

                            <MudText Typo="Typo.subtitle1" Class="mb-2">
                                انتخاب آزمون
                            </MudText>

                            <MudStack Spacing="2">


                                <!-- Test Panels -->

                                <MudText Typo="Typo.subtitle1" Class="mb-2">
                                    افزودن آزمون از Test Panel
                                </MudText>

                                <MudTextField T="string"
                                              @bind-Value="TestPanelSearchText"
                                              Immediate="true"
                                              Label="جستجوی Test Panel"
                                              Placeholder="بخشی از نام یا کد Panel..."
                                              Variant="Variant.Outlined"
                                              Clearable="true"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Search"
                                              Disabled="@IsSaving" />

                                <MudPaper Outlined="true"
                                          Class="pa-2 mt-2"
                                          Style="max-height:220px; overflow-y:auto;">

                                    @foreach (var panel in GetFilteredTestPanels())
                                    {
                                        <MudCheckBox T="bool"
                                                     Value="@SelectedTestPanelIds.Contains(panel.Id)"
                                                     ValueChanged="@((bool value) =>
                                                                              ToggleTestPanel(panel.Id, value))"
                                         Dense="true"
                                         Disabled="@IsSaving">

                                            @panel.Code - @panel.Name

                                        </MudCheckBox>
                                                        }

                                </MudPaper>

                                <MudText Typo="Typo.caption" Class="mt-1">
                                    تعداد Panelهای انتخاب‌شده:
                                    <b>@SelectedTestPanelIds.Count</b>
                                </MudText>

                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           Class="mt-2"
                                           Disabled="@(SelectedTestPanelIds.Count == 0 || IsSaving)"
                                           OnClick="@(() => AddSelectedPanelTests(sample))">

                                    افزودن آزمون‌های Panelهای انتخاب‌شده

                                </MudButton>

                                @* ========================================================= *@
                                @* افزودن آزمون از پذیرش قبلی                               *@
                                @* ========================================================= *@

                                @if (SelectedPreviousSample != null)
                                {
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Secondary"
                                               Class="mt-2"
                                               Disabled="@(SelectedPreviousTestIds.Count == 0 || IsSaving)"
                                               OnClick="@(() => AddSelectedPreviousTests(sample))">

                                        افزودن آزمون‌های انتخاب‌شده از پذیرش قبلی
                                        (@SelectedPreviousTestIds.Count)

                                    </MudButton>
                                }
                                <!-- آزمون‌های موجود -->
                                <MudText Typo="Typo.subtitle1" Class="mb-2">
                                    آزمون‌ها
                                </MudText>

                                <MudTextField T="string"
                                              @bind-Value="TestSearchText"
                                              Immediate="true"
                                              Label="جستجوی آزمون"
                                              Placeholder="بخشی از نام یا کد آزمون..."
                                              Variant="Variant.Outlined"
                                              Clearable="true"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Search"
                                              Disabled="@IsSaving" />

                                <MudPaper Outlined="true"
                                          Class="pa-2 mt-2"
                                          Style="max-height:300px; overflow-y:auto;">

                                    @foreach (var test in GetFilteredTests())
                                    {
                                        <MudCheckBox T="bool"
                                                     Value="@SelectedTests[sample].Contains(test.Id)"
                                                     ValueChanged="@(value => ToggleTest(sample, test.Id, value))"
                                                     Disabled="@IsSaving"
                                                     Dense="true">

                                            @test.DisplayName

                                        </MudCheckBox>
                                    }

                                </MudPaper>

                                <MudText Typo="Typo.caption" Class="mt-1">
                                    تعداد آزمون‌های انتخاب‌شده:
                                    <b>@SelectedTests[sample].Count</b>
                                </MudText>

                                <MudText Typo="Typo.caption">
                                    تعداد آزمون‌های انتخاب‌شده:
                                    <b>@SelectedTests[sample].Count</b>
                                </MudText>

                            </MudStack>

                        </MudItem>


                    </MudGrid>

                </MudPaper>
            }
        }

        @* ============================= *@
        @* Save                            *@
        @* ============================= *@

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Large"
                   FullWidth="true"
                   Class="mt-5"
                   Disabled="@IsSaving"
                   OnClick="Save">

            @if (IsSaving)
            {
                <MudProgressCircular Size="Size.Small"
                                     Indeterminate="true"
                                     Class="me-2" />

                <span>در حال ثبت...</span>
            }
            else
            {
                <span>ثبت پذیرش</span>
            }

        </MudButton>

        @* ============================= *@
        @* Result                          *@
        @* ============================= *@

        @if (!string.IsNullOrWhiteSpace(Result))
        {
            <MudAlert Severity="@ResultSeverity"
                      Class="mt-4">

                @Result

            </MudAlert>
        }

    </MudPaper>

</MudContainer>

@* ========================================================= *@
@* Quick Create Customer Dialog                           *@
@* ========================================================= *@

<MudDialog @bind-Visible="QuickCustomerDialogVisible"
           Options="new DialogOptions
           {
               MaxWidth = MaxWidth.Medium,
               FullWidth = true,
               CloseOnEscapeKey = true
           }">

    <DialogContent>

        <MudText Typo="Typo.h6"
                 Class="mb-4">

            ایجاد سریع مشتری

        </MudText>

        <MudGrid Spacing="2">

            @* نام مشتری *@

            <MudItem xs="12" sm="6">

                <MudTextField T="string"
                              Label="نام مشتری"
                              Variant="Variant.Outlined"
                              @bind-Value="QuickCustomer.DisplayName"
                              Required="true"
                              Immediate="true" />

            </MudItem>


            @* کد مشتری *@

            <MudItem xs="12" sm="6">

                <MudTextField T="string"
                              Label="کد مشتری"
                              Variant="Variant.Outlined"
                              @bind-Value="QuickCustomer.Code" />

            </MudItem>


            @* نام حقوقی *@

            <MudItem xs="12" sm="6">

                <MudTextField T="string"
                              Label="نام حقوقی"
                              Variant="Variant.Outlined"
                              @bind-Value="QuickCustomer.LegalName" />

            </MudItem>


            @* شناسه ملی *@

            <MudItem xs="12" sm="6">

                <MudTextField T="string"
                              Label="شناسه ملی"
                              Variant="Variant.Outlined"
                              @bind-Value="QuickCustomer.NationalId" />

            </MudItem>


            @* کد اقتصادی *@

            <MudItem xs="12" sm="6">

                <MudTextField T="string"
                              Label="کد اقتصادی"
                              Variant="Variant.Outlined"
                              @bind-Value="QuickCustomer.EconomicCode" />

            </MudItem>


            @* تلفن *@

            <MudItem xs="12" sm="6">

                <MudTextField T="string"
                              Label="تلفن"
                              Variant="Variant.Outlined"
                              @bind-Value="QuickCustomer.Phone" />

            </MudItem>


            @* موبایل *@

            <MudItem xs="12" sm="6">

                <MudTextField T="string"
                              Label="موبایل"
                              Variant="Variant.Outlined"
                              @bind-Value="QuickCustomer.Mobile" />

            </MudItem>


            @* شهر *@

            <MudItem xs="12" sm="6">

                <MudTextField T="string"
                              Label="شهر"
                              Variant="Variant.Outlined"
                              @bind-Value="QuickCustomer.City" />

            </MudItem>


            @* توضیحات *@

            <MudItem xs="12">

                <MudTextField T="string"
                              Label="توضیحات"
                              Variant="Variant.Outlined"
                              Lines="2"
                              @bind-Value="QuickCustomer.Description" />

            </MudItem>

        </MudGrid>

    </DialogContent>


    <DialogActions>

        <MudButton Variant="Variant.Text"
                   OnClick="CloseQuickCustomerDialog">

            انصراف

        </MudButton>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="SaveQuickCustomer">

            ذخیره و انتخاب مشتری

        </MudButton>

    </DialogActions>

</MudDialog>
@code
{
    // =========================================================
    // Reception
    // =========================================================

    private Guid SelectedCustomerId;

    private CustomerLookupDto? SelectedCustomer;

    private bool IsUrgent;

    private bool QuickCustomerDialogVisible;

    private Customer QuickCustomer = new();

    private string? Description;

    private void OpenQuickCustomerDialog()
    {
        QuickCustomer = new Customer();

        QuickCustomerDialogVisible = true;
    }

    private void CloseQuickCustomerDialog()
    {
        QuickCustomerDialogVisible = false;
    }

    private async Task SaveQuickCustomer()
    {
        if (string.IsNullOrWhiteSpace(QuickCustomer.DisplayName))
        {
            return;
        }

        await CustomerService.CreateAsync(QuickCustomer);

        QuickCustomerDialogVisible = false;

        Customers =
            await CustomerService.GetLookupWithDefaultPanelAsync();

        var createdCustomer =
            Customers.FirstOrDefault(x =>
                x.DisplayName == QuickCustomer.DisplayName);

        if (createdCustomer != null)
        {
            SelectedCustomer = createdCustomer;

            SelectedCustomerId =
                createdCustomer.Id;

            await OnCustomerChanged();
        }
    }

    
    // =========================================================
    // State
    // =========================================================

    private bool IsSaving;

    private DateTime? ReceptionDate = DateTime.Now;

    // =========================================================
    // Previous Reception History
    // =========================================================

    private List<ReceptionHistoryLookupDto> PreviousReceptions = new();

    private ReceptionHistoryLookupDto? SelectedPreviousReception;

    private ReceptionHistorySampleDto? SelectedPreviousSample;

    private HashSet<Guid> SelectedPreviousTestIds = new();

    // =========================================================
    // Result
    // =========================================================

    private string Result = "";

    private Severity ResultSeverity = Severity.Info;


    // =========================================================
    // Master Data
    // =========================================================

    private List<CustomerLookupDto> Customers = new();


    private List<SampleCategory> SampleCategories = new();



    private List<Matrix> Matrices = new();

    private List<StandardSample> StandardSamples = new();

    private Dictionary<CreateReceptionSampleDto, List<Matrix>> SampleMatrices
    = new();

    private List<TestLookupDto> Tests = new();

    private List<TestPanel> TestPanels = new();

    private string TestSearchText = "";

    private string TestPanelSearchText = "";

    private HashSet<Guid> SelectedTestPanelIds = new();

    private Guid? SelectedTestPanelId;

    private bool ShowAllTests = false;

    // =========================================================
    // Samples
    // =========================================================

    private List<CreateReceptionSampleDto> Samples = new();

    private Dictionary<CreateReceptionSampleDto, List<CustomFieldValueDto>> SampleCustomFields
    = new();

    private Dictionary<CreateReceptionSampleDto, HashSet<Guid>> SelectedTests
        = new();

    private Dictionary<CreateReceptionSampleDto, HashSet<Guid>> DefaultSelectedTests
    = new();

    private Dictionary<CreateReceptionSampleDto, Dictionary<Guid, Guid>>
    SelectedTestPanels = new();

    // =========================================================
    // Initialization
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Result = "";

            // -----------------------------
            // Customers
            // -----------------------------

            Customers =
              await CustomerService.GetLookupWithDefaultPanelAsync();

            // -----------------------------
            // Active Sample Categories
            // -----------------------------

            var allSampleCategories =
                await SampleCategoryService.GetAllAsync();

            SampleCategories =
                allSampleCategories
                    .Where(x =>
                        x.IsActive &&
                        !x.IsDeleted)
                    .OrderBy(x => x.Name)
                    .ToList();
            // -----------------------------
            // Active Matrices
            // -----------------------------

            var allMatrices =
                await MatrixService.GetAllAsync();

            Matrices =
                allMatrices
                    .Where(x =>
                        x.IsActive &&
                        !x.IsDeleted)
                    .OrderBy(x => x.Name)
                    .ToList();

            // -----------------------------
            // Active Standard Samples
            // -----------------------------

            var allStandardSamples =
                await StandardSampleService.GetAllAsync();

            StandardSamples =
                allStandardSamples
                    .Where(x =>
                        x.IsActive &&
                        !x.IsDeleted)
                    .OrderBy(x => x.Name)
                    .ToList();

            // -----------------------------
            // Active Reception Tests
            // -----------------------------

            Tests =
                await TestService.GetReceptionLookupAsync();


            // -----------------------------
            // Initialization Result
            // -----------------------------

            Result =
                $"مشتری: {Customers.Count} | " +
                $"ماتریس فعال: {Matrices.Count} | " +
                $"آزمون فعال: {Tests.Count}";

            ResultSeverity = Severity.Info;
        }
        catch (Exception ex)
        {
            Result =
                $"خطا در بارگذاری اطلاعات پذیرش: {ex.Message}";

            ResultSeverity = Severity.Error;
        }
        TestPanels = await TestPanelService.GetAllAsync();
    }


    // =========================================================
    // Add Sample
    // =========================================================

    private async Task AddSample()
    {
        var sample = new CreateReceptionSampleDto
        {
            SampleName = "",
            SampleCategoryId = null,
            MatrixId = null
        };

        Samples.Add(sample);

        SampleCustomFields[sample] = new List<CustomFieldValueDto>();

        SelectedTests[sample] =
            new HashSet<Guid>();

        DefaultSelectedTests[sample] =
            new HashSet<Guid>();

        SelectedTestPanels[sample] =
            new Dictionary<Guid, Guid>();

        SampleMatrices[sample] =
            new List<Matrix>();

        await ApplyDefaultTestPanel(sample);

        Result = "";
    }
    private void AddAdHocCustomField(
    CreateReceptionSampleDto sample)
    {
        if (!SampleCustomFields.ContainsKey(sample))
        {
            SampleCustomFields[sample] =
                new List<CustomFieldValueDto>();
        }

        SampleCustomFields[sample].Add(
            new CustomFieldValueDto
            {
                Id = null,
                DefinitionId = null,
                Title = "",
                DataType = "Text",
                IsRequired = false,
                Value = "",
                IsAdHoc = true,
                DisplayOrder =
                    SampleCustomFields[sample].Count
            });
    }
    private void RemoveAdHocCustomField(
    CreateReceptionSampleDto sample,
    CustomFieldValueDto field)
    {
        if (!SampleCustomFields.TryGetValue(sample, out var fields))
            return;

        fields.Remove(field);
    }

    private async Task LoadCustomFieldsAsync(
    CreateReceptionSampleDto sample)
    {
        if (sample == null)
            return;

        var definitions =
            await CustomFieldService.GetDefinitionsAsync(
                SelectedCustomerId == Guid.Empty
                    ? null
                    : SelectedCustomerId,
                sample.SampleCategoryId,
                sample.MatrixId);

        var fields = definitions
            .Where(x => x.IsActive && !x.IsDeleted)
            .OrderBy(x => x.DisplayOrder)
            .ThenBy(x => x.Title)
            .Select(x => new CustomFieldValueDto
            {
                Id = null,
                DefinitionId = x.Id,
                Title = x.Title,
                DataType = x.DataType,
                IsRequired = x.IsRequired,
                Value = null,
                IsAdHoc = false,
                DisplayOrder = x.DisplayOrder
            })
            .ToList();

        SampleCustomFields[sample] = fields;
    }

    private IEnumerable<StandardSample> GetStandardSamples(
    CreateReceptionSampleDto sample)
    {
        if (sample.MatrixId == null)
            return Enumerable.Empty<StandardSample>();

        return StandardSamples
            .Where(x => x.MatrixId == sample.MatrixId)
            .OrderBy(x => x.Name);
    }
    private Task<IEnumerable<CustomerLookupDto>> SearchCustomers(
    string? value,
    CancellationToken cancellationToken)
    {
        IEnumerable<CustomerLookupDto> result = Customers;

        if (!string.IsNullOrWhiteSpace(value))
        {
            var search = value.Trim();

            result = Customers
                .Where(x =>
                    (x.DisplayName ?? "")
                        .Contains(
                            search,
                            StringComparison.OrdinalIgnoreCase))
                .Take(50);
        }
        else
        {
            result = Customers.Take(50);
        }

        return Task.FromResult(result);
    }
    private async Task OnCustomerChanged()
    {
        foreach (var sample in Samples)
        {
            await ApplyDefaultTestPanel(sample);
            await LoadCustomFieldsAsync(sample);
        }

        StateHasChanged();
    }

    private async Task OnCustomerSelected(
    CustomerLookupDto? customer)
    {
        SelectedCustomer = customer;

        SelectedCustomerId =
            customer?.Id ?? Guid.Empty;

        await OnCustomerChanged();
        await LoadPreviousReceptionsAsync();
    }

    private async Task LoadPreviousReceptionsAsync()
    {
        PreviousReceptions.Clear();

        SelectedPreviousReception = null;
        SelectedPreviousSample = null;

        if (SelectedCustomerId == Guid.Empty)
            return;

        PreviousReceptions =
            await ReceptionService.GetHistoryByCustomerIdAsync(
                SelectedCustomerId);
    }
    private Task<IEnumerable<ReceptionHistoryLookupDto>> SearchPreviousReceptions(
    string? value,
    CancellationToken cancellationToken)
    {
        IEnumerable<ReceptionHistoryLookupDto> result =
            PreviousReceptions;

        if (!string.IsNullOrWhiteSpace(value))
        {
            var search = value.Trim();

            result = PreviousReceptions
                .Where(x =>
                    x.ReceptionNumber.Contains(
                        search,
                        StringComparison.OrdinalIgnoreCase)
                    ||
                    x.Samples.Any(s =>
                        (!string.IsNullOrWhiteSpace(s.SampleName) &&
                         s.SampleName.Contains(
                             search,
                             StringComparison.OrdinalIgnoreCase))
                        ||
                        (!string.IsNullOrWhiteSpace(s.SampleCode) &&
                         s.SampleCode.Contains(
                             search,
                             StringComparison.OrdinalIgnoreCase))
                    ));
        }

        return Task.FromResult(
            result.Take(50));
    }
    private async Task OnPreviousReceptionSelected(
    ReceptionHistoryLookupDto? reception)
    {
        SelectedPreviousReception = reception;

        SelectedPreviousSample = null;

        SelectedPreviousTestIds.Clear();

        await InvokeAsync(StateHasChanged);
    }
    private async Task OnPreviousSampleSelected(
    ReceptionHistorySampleDto? sample)
    {
        SelectedPreviousSample = sample;

        SelectedPreviousTestIds.Clear();

        if (sample != null)
        {
            foreach (var test in sample.Tests)
            {
                if (test.TestId != Guid.Empty)
                {
                    SelectedPreviousTestIds.Add(test.TestId);
                }
            }
        }

        await InvokeAsync(StateHasChanged);
    }
    private async Task AddSelectedPreviousTests(
    CreateReceptionSampleDto sample)
    {
        if (SelectedPreviousSample == null)
            return;

        if (!SelectedTests.ContainsKey(sample))
            SelectedTests[sample] = new HashSet<Guid>();

        if (!SelectedTestPanels.ContainsKey(sample))
            SelectedTestPanels[sample] = new Dictionary<Guid, Guid>();

        foreach (var previousTest in SelectedPreviousSample.Tests)
        {
            if (!SelectedPreviousTestIds.Contains(previousTest.TestId))
                continue;

            if (previousTest.TestId == Guid.Empty)
                continue;

            SelectedTests[sample].Add(previousTest.TestId);

            if (previousTest.TestPanelId.HasValue &&
                previousTest.TestPanelId.Value != Guid.Empty)
            {
                SelectedTestPanels[sample][previousTest.TestId] =
                    previousTest.TestPanelId.Value;
            }
        }

        await InvokeAsync(StateHasChanged);
    }
    private async Task OnSampleCategoryChanged(
    CreateReceptionSampleDto sample)
    {
        // ماتریس قبلی دیگر معتبر نیست
        sample.MatrixId = null;

        // اگر دسته‌بندی انتخاب نشده باشد
        if (!sample.SampleCategoryId.HasValue ||
            sample.SampleCategoryId.Value == Guid.Empty)
        {
            SampleMatrices[sample] = new List<Matrix>();
            SampleCustomFields[sample] =
               new List<CustomFieldValueDto>();
            return;
        }

        // دریافت ماتریس‌های مربوط به همین دسته‌بندی
        var matrices = await MatrixService.GetBySampleCategoryIdAsync(
            sample.SampleCategoryId.Value);

        // فقط ماتریس‌های فعال و حذف‌نشده
        SampleMatrices[sample] = matrices
            .Where(x => x.IsActive && !x.IsDeleted)
            .OrderBy(x => x.Name)
            .ToList();

        await LoadCustomFieldsAsync(sample);

        await InvokeAsync(StateHasChanged);
    }
    private async Task ApplyDefaultTestPanel(
    CreateReceptionSampleDto sample)
    {
        if (!SelectedTests.ContainsKey(sample))
        {
            SelectedTests[sample] =
                new HashSet<Guid>();
        }

        if (!DefaultSelectedTests.ContainsKey(sample))
        {
            DefaultSelectedTests[sample] =
                new HashSet<Guid>();
        }

        // =========================================================
        // حذف فقط Defaultهای قبلی
        // انتخاب‌های دستی کاربر باقی می‌مانند
        // =========================================================

        foreach (var testId in DefaultSelectedTests[sample])
        {
            SelectedTests[sample].Remove(testId);
        }

        DefaultSelectedTests[sample].Clear();

        // =========================================================
        // پیدا کردن مشتری
        // =========================================================

        var customer = Customers
            .FirstOrDefault(x =>
                x.Id == SelectedCustomerId);

        if (customer?.DefaultTestPanelId == null)
            return;

        // =========================================================
        // دریافت Default Test Panel مشتری
        // =========================================================

        var panel =
            await TestPanelService.GetByIdAsync(
                customer.DefaultTestPanelId.Value);

        if (panel == null)
            return;

        // =========================================================
        // آزمون‌های Panel
        // =========================================================

        var testIds =
            panel.Items
                .Where(x =>
                    x.IsActive &&
                    !x.IsDeleted)
                .Select(x => x.TestId)
                .Where(x => x != Guid.Empty)
                .Distinct();

        // =========================================================
        // اعمال Defaultهای جدید
        // =========================================================

        foreach (var testId in testIds)
        {
            if (testId == Guid.Empty)
                continue;

            SelectedTests[sample].Add(testId);

            SelectedTestPanels[sample][testId] =
                 customer.DefaultTestPanelId.Value;
        }
    }
    private async Task SelectTestPanelAsync(
    Guid? panelId,
    CreateReceptionSampleDto sample)
    {
        if (!panelId.HasValue || panelId.Value == Guid.Empty)
            return;

        var panel =
            await TestPanelService.GetByIdAsync(panelId.Value);

        if (panel == null)
            return;

        var testIds = panel.Items
            .Where(x => x.IsActive && !x.IsDeleted)
            .Select(x => x.TestId)
            .Distinct();

        if (!SelectedTests.ContainsKey(sample))
        {
            SelectedTests[sample] = new HashSet<Guid>();
        }

        foreach (var testId in testIds)
        {
            if (testId == Guid.Empty)
                continue;

            SelectedTests[sample].Add(testId);

            SelectedTestPanels[sample][testId] =
                panelId.Value;
        }

        SelectedTestPanelId = null;

        await InvokeAsync(StateHasChanged);
    }
