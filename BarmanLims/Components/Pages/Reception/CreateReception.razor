@page "/reception/create"

@using MudBlazor
@using Barman.Application.DTOs.Reception
@using Barman.Application.DTOs.Customer
@using Barman.Domain.Entities
@using Barman.Application.DTOs.Test
@using Barman.Application.Interfaces

@inject Barman.Application.Interfaces.ITestPanelService TestPanelService
@inject Barman.Application.Interfaces.IReceptionService ReceptionService
@inject Barman.Application.Interfaces.ICustomerService CustomerService
@inject Barman.Application.Interfaces.IMatrixService MatrixService
@inject Barman.Application.Interfaces.ITestService TestService
@inject NavigationManager NavigationManager
@inject ITestPanelService TestPanelService


<PageTitle>ثبت پذیرش</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="pa-4">

    <MudPaper Class="pa-6">

        <MudText Typo="Typo.h5">
            ثبت پذیرش
        </MudText>

        <MudDivider Class="my-4" />

        @* ============================= *@
        @* Customer                       *@
        @* ============================= *@

        <MudSelect T="Guid"
                   Label="مشتری"
                   Variant="Variant.Outlined"
                   @bind-Value="SelectedCustomerId"
                   @bind-Value:after="OnCustomerChanged"
                   Disabled="@IsSaving">

            @foreach (var customer in Customers)
            {
                <MudSelectItem T="Guid" Value="@customer.Id">
                    @customer.DisplayName
                </MudSelectItem>
            }

        </MudSelect>

        <MudCheckBox @bind-Value="IsUrgent"
                     Label="فوری"
                     Class="mt-3"
                     Disabled="@IsSaving" />

        <MudTextField T="string"
                      Label="توضیحات پذیرش"
                      Variant="Variant.Outlined"
                      Lines="3"
                      @bind-Value="Description"
                      Class="mt-3"
                      Disabled="@IsSaving" />

        <MudDivider Class="my-5" />

        @* ============================= *@
        @* Samples                        *@
        @* ============================= *@

        <div class="d-flex justify-space-between align-center">

            <MudText Typo="Typo.h6">
                نمونه‌ها
            </MudText>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="AddSample"
                       Disabled="@IsSaving">

                افزودن نمونه

            </MudButton>

        </div>

        @if (Samples.Count == 0)
        {
            <MudAlert Severity="Severity.Info"
                      Class="mt-4">

                حداقل یک نمونه برای پذیرش اضافه کنید.

            </MudAlert>
        }
        else
        {
            @foreach (var sample in Samples)
            {
                var index = Samples.IndexOf(sample) + 1;

                <MudPaper Class="pa-4 mt-4"
                          Outlined="true">

                    <div class="d-flex justify-space-between align-center">

                        <MudText Typo="Typo.subtitle1">
                            نمونه @index
                        </MudText>

                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Disabled="@IsSaving"
                                       OnClick="@(() => RemoveSample(sample))" />

                    </div>

                    <MudDivider Class="my-3" />

                    <MudGrid>

                        @* ============================= *@
                        @* Sample Name                    *@
                        @* ============================= *@

                        <MudItem xs="12">

                            <MudTextField T="string"
                                          Label="نام نمونه"
                                          Variant="Variant.Outlined"
                                          Required="true"
                                          @bind-Value="sample.SampleName"
                                          Disabled="@IsSaving" />

                        </MudItem>

                        @* ============================= *@
                        @* Tests                         *@
                        @* ============================= *@

                        <MudItem xs="12">

                            <MudText Typo="Typo.subtitle1" Class="mb-2">
                                انتخاب آزمون
                            </MudText>

                            <MudStack Spacing="2">


                                <!-- Test Panels -->

                                <MudText Typo="Typo.subtitle1" Class="mb-2">
                                    افزودن آزمون از Test Panel
                                </MudText>

                                <MudTextField T="string"
                                              @bind-Value="TestPanelSearchText"
                                              Immediate="true"
                                              Label="جستجوی Test Panel"
                                              Placeholder="بخشی از نام یا کد Panel..."
                                              Variant="Variant.Outlined"
                                              Clearable="true"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Search"
                                              Disabled="@IsSaving" />

                                <MudPaper Outlined="true"
                                          Class="pa-2 mt-2"
                                          Style="max-height:220px; overflow-y:auto;">

                                    @foreach (var panel in GetFilteredTestPanels())
                                    {
                                        <MudCheckBox T="bool"
                                                     Value="@SelectedTestPanelIds.Contains(panel.Id)"
                                                     ValueChanged="@((bool value) =>
                                                                              ToggleTestPanel(panel.Id, value))"
                                         Dense="true"
                                         Disabled="@IsSaving">

                                            @panel.Code - @panel.Name

                                        </MudCheckBox>
                                                        }

                                </MudPaper>

                                <MudText Typo="Typo.caption" Class="mt-1">
                                    تعداد Panelهای انتخاب‌شده:
                                    <b>@SelectedTestPanelIds.Count</b>
                                </MudText>

                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           Class="mt-2"
                                           Disabled="@(SelectedTestPanelIds.Count == 0 || IsSaving)"
                                           OnClick="@(() => AddSelectedPanelTests(sample))">

                                    افزودن آزمون‌های Panelهای انتخاب‌شده

                                </MudButton>

                                <!-- آزمون‌های موجود -->
                                <MudText Typo="Typo.subtitle1" Class="mb-2">
                                    آزمون‌ها
                                </MudText>

                                <MudTextField T="string"
                                              @bind-Value="TestSearchText"
                                              Immediate="true"
                                              Label="جستجوی آزمون"
                                              Placeholder="بخشی از نام یا کد آزمون..."
                                              Variant="Variant.Outlined"
                                              Clearable="true"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Search"
                                              Disabled="@IsSaving" />

                                <MudPaper Outlined="true"
                                          Class="pa-2 mt-2"
                                          Style="max-height:300px; overflow-y:auto;">

                                    @foreach (var test in GetFilteredTests())
                                    {
                                        <MudCheckBox T="bool"
                                                     Value="@SelectedTests[sample].Contains(test.Id)"
                                                     ValueChanged="@(value => ToggleTest(sample, test.Id, value))"
                                                     Disabled="@IsSaving"
                                                     Dense="true">

                                            @test.DisplayName

                                        </MudCheckBox>
                                    }

                                </MudPaper>

                                <MudText Typo="Typo.caption" Class="mt-1">
                                    تعداد آزمون‌های انتخاب‌شده:
                                    <b>@SelectedTests[sample].Count</b>
                                </MudText>

                                <MudText Typo="Typo.caption">
                                    تعداد آزمون‌های انتخاب‌شده:
                                    <b>@SelectedTests[sample].Count</b>
                                </MudText>

                            </MudStack>

                        </MudItem>

                        @* ============================= *@
                        @* Matrix                         *@
                        @* ============================= *@

                        <MudItem xs="12" sm="6">

                            <MudSelect T="string"
                                       Label="ماتریس"
                                       Variant="Variant.Outlined"
                                       @bind-Value="sample.Matrix"
                                       Disabled="@IsSaving">

                                @foreach (var matrix in Matrices)
                                {
                                    <MudSelectItem T="string"
                                                   Value="@matrix.Name">

                                        @matrix.Name

                                    </MudSelectItem>
                                }

                            </MudSelect>

                        </MudItem>

                        @* ============================= *@
                        @* Quantity                       *@
                        @* ============================= *@

                        <MudItem xs="12" sm="6">

                            <MudTextField T="decimal?"
                                          Label="مقدار"
                                          Variant="Variant.Outlined"
                                          InputType="InputType.Number"
                                          @bind-Value="sample.Quantity"
                                          Disabled="@IsSaving" />

                        </MudItem>

                        @* ============================= *@
                        @* Unit                           *@
                        @* ============================= *@

                        <MudItem xs="12" sm="6">

                            <MudTextField T="string"
                                          Label="واحد"
                                          Variant="Variant.Outlined"
                                          @bind-Value="sample.Unit"
                                          Disabled="@IsSaving" />

                        </MudItem>

                        @* ============================= *@
                        @* Container                      *@
                        @* ============================= *@

                        <MudItem xs="12" sm="6">

                            <MudTextField T="string"
                                          Label="نوع ظرف"
                                          Variant="Variant.Outlined"
                                          @bind-Value="sample.ContainerType"
                                          Disabled="@IsSaving" />

                        </MudItem>

                        @* ============================= *@
                        @* Description                    *@
                        @* ============================= *@

                        <MudItem xs="12">

                            <MudTextField T="string"
                                          Label="توضیحات نمونه"
                                          Variant="Variant.Outlined"
                                          Lines="2"
                                          @bind-Value="sample.Description"
                                          Disabled="@IsSaving" />

                        </MudItem>

                    </MudGrid>

                </MudPaper>
            }
        }

        @* ============================= *@
        @* Save                            *@
        @* ============================= *@

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Large"
                   FullWidth="true"
                   Class="mt-5"
                   Disabled="@IsSaving"
                   OnClick="Save">

            @if (IsSaving)
            {
                <MudProgressCircular Size="Size.Small"
                                     Indeterminate="true"
                                     Class="me-2" />

                <span>در حال ثبت...</span>
            }
            else
            {
                <span>ثبت پذیرش</span>
            }

        </MudButton>

        @* ============================= *@
        @* Result                          *@
        @* ============================= *@

        @if (!string.IsNullOrWhiteSpace(Result))
        {
            <MudAlert Severity="@ResultSeverity"
                      Class="mt-4">

                @Result

            </MudAlert>
        }

    </MudPaper>

</MudContainer>


@code
{
    // =========================================================
    // Reception
    // =========================================================

    private Guid SelectedCustomerId;

    private bool IsUrgent;

    private string? Description;


    // =========================================================
    // State
    // =========================================================

    private bool IsSaving;


    // =========================================================
    // Result
    // =========================================================

    private string Result = "";

    private Severity ResultSeverity = Severity.Info;


    // =========================================================
    // Master Data
    // =========================================================

    private List<CustomerLookupDto> Customers = new();

    private List<Matrix> Matrices = new();

    private List<TestLookupDto> Tests = new();

    private List<TestPanel> TestPanels = new();

    private string TestSearchText = "";

    private string TestPanelSearchText = "";

    private HashSet<Guid> SelectedTestPanelIds = new();

    private Guid? SelectedTestPanelId;

    private bool ShowAllTests = false;

    // =========================================================
    // Samples
    // =========================================================

    private List<CreateReceptionSampleDto> Samples = new();

    private Dictionary<CreateReceptionSampleDto, HashSet<Guid>> SelectedTests
        = new();


    // =========================================================
    // Initialization
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Result = "";

            // -----------------------------
            // Customers
            // -----------------------------

            Customers =
              await CustomerService.GetLookupWithDefaultPanelAsync();


            // -----------------------------
            // Active Matrices
            // -----------------------------

            var allMatrices =
                await MatrixService.GetAllAsync();

            Matrices =
                allMatrices
                    .Where(x =>
                        x.IsActive &&
                        !x.IsDeleted)
                    .OrderBy(x => x.Name)
                    .ToList();


            // -----------------------------
            // Active Reception Tests
            // -----------------------------

            Tests =
                await TestService.GetReceptionLookupAsync();


            // -----------------------------
            // Initialization Result
            // -----------------------------

            Result =
                $"مشتری: {Customers.Count} | " +
                $"ماتریس فعال: {Matrices.Count} | " +
                $"آزمون فعال: {Tests.Count}";

            ResultSeverity = Severity.Info;
        }
        catch (Exception ex)
        {
            Result =
                $"خطا در بارگذاری اطلاعات پذیرش: {ex.Message}";

            ResultSeverity = Severity.Error;
        }
        TestPanels = await TestPanelService.GetAllAsync();
    }


    // =========================================================
    // Add Sample
    // =========================================================

    private async Task AddSample()
    {
        var sample = new CreateReceptionSampleDto
        {
            SampleName = "",
            Matrix = ""
        };

        Samples.Add(sample);

        SelectedTests[sample] =
            new HashSet<Guid>();

        await ApplyDefaultTestPanel(sample);

        Result = "";
    }

    private async Task OnCustomerChanged()
    {
        foreach (var sample in Samples)
        {
            await ApplyDefaultTestPanel(sample);
        }

        StateHasChanged();
    }

    private async Task ApplyDefaultTestPanel(
    CreateReceptionSampleDto sample)
    {
        var customer = Customers
            .FirstOrDefault(x => x.Id == SelectedCustomerId);

        if (customer?.DefaultTestPanelId == null)
            return;

        var panel = await TestPanelService.GetByIdAsync(
            customer.DefaultTestPanelId.Value);

        if (panel == null)
            return;

        var testIds = panel.Items
            .Where(x => x.IsActive && !x.IsDeleted)
            .Select(x => x.TestId)
            .Distinct()
            .ToHashSet();

        SelectedTests[sample] = testIds;
    }
    private async Task SelectTestPanelAsync(
    Guid? panelId,
    CreateReceptionSampleDto sample)
    {
        if (!panelId.HasValue || panelId.Value == Guid.Empty)
            return;

        var panel =
            await TestPanelService.GetByIdAsync(panelId.Value);

        if (panel == null)
            return;

        var testIds = panel.Items
            .Where(x => x.IsActive && !x.IsDeleted)
            .Select(x => x.TestId)
            .Distinct();

        if (!SelectedTests.ContainsKey(sample))
        {
            SelectedTests[sample] = new HashSet<Guid>();
        }

        foreach (var testId in testIds)
        {
            SelectedTests[sample].Add(testId);
        }

        SelectedTestPanelId = null;

        await InvokeAsync(StateHasChanged);
    }
    // =========================================================
    // Remove Sample
    // =========================================================

    private void RemoveSample(
        CreateReceptionSampleDto sample)
    {
        Samples.Remove(sample);

        SelectedTests.Remove(sample);

        Result = "";
    }


    // =========================================================
    // Tests Changed
    // =========================================================

    private void OnTestsChanged(
        CreateReceptionSampleDto sample,
        IEnumerable<Guid> values)
    {
        SelectedTests[sample] =
            values.ToHashSet();
    }


    // =========================================================
    // Save Reception
    // =========================================================

    private async Task Save()
    {
        if (IsSaving)
            return;

        try
        {
            Result = "";


            // =================================================
            // Customer validation
            // =================================================

            if (SelectedCustomerId == Guid.Empty)
            {
                Result =
                    "لطفاً مشتری را انتخاب کنید.";

                ResultSeverity =
                    Severity.Warning;

                return;
            }


            // =================================================
            // Sample validation
            // =================================================

            if (Samples.Count == 0)
            {
                Result =
                    "لطفاً حداقل یک نمونه اضافه کنید.";

                ResultSeverity =
                    Severity.Warning;

                return;
            }


            // =================================================
            // Remove empty samples
            // =================================================

            var validSamples =
                Samples
                    .Where(x =>
                        !string.IsNullOrWhiteSpace(
                            x.SampleName))
                    .ToList();


            if (validSamples.Count == 0)
            {
                Result =
                    "لطفاً حداقل نام یک نمونه را وارد کنید.";

                ResultSeverity =
                    Severity.Warning;

                return;
            }


            // =================================================
            // Validate Matrix
            // =================================================

            var sampleWithoutMatrix =
                validSamples.FirstOrDefault(x =>
                    string.IsNullOrWhiteSpace(
                        x.Matrix));


            if (sampleWithoutMatrix != null)
            {
                Result =
                    $"برای نمونه «{sampleWithoutMatrix.SampleName}» " +
                    "لطفاً ماتریس را انتخاب کنید.";

                ResultSeverity =
                    Severity.Warning;

                return;
            }


            // =================================================
            // Start Saving
            // =================================================

            IsSaving = true;


            // =================================================
            // Copy selected tests to DTO
            // =================================================

            foreach (var sample in validSamples)
            {
                if (SelectedTests.TryGetValue(
                        sample,
                        out var selectedTests))
                {
                    sample.TestIds =
                        selectedTests
                            .Where(x =>
                                x != Guid.Empty)
                            .Distinct()
                            .ToList();
                }
                else
                {
                    sample.TestIds =
                        new List<Guid>();
                }
            }


            // =================================================
            // Create Reception DTO
            // =================================================

            var dto =
                new CreateReceptionDto
                {
                    CustomerId =
                        SelectedCustomerId,

                    IsUrgent =
                        IsUrgent,

                    Description =
                        Description,

                    Samples =
                        validSamples
                };


            // =================================================
            // Create Reception
            // =================================================

            var reception =
                await ReceptionService
                    .CreateReceptionAsync(dto);


            // =================================================
            // Success
            // =================================================

            Result =
                $"پذیرش {reception.ReceptionNumber} با موفقیت ثبت شد. " +
                $"تعداد نمونه: {validSamples.Count}";

            ResultSeverity =
                Severity.Success;

            await Task.Delay(300);

            NavigationManager.NavigateTo(
                $"/reception/details/{reception.Id}");


            // =================================================
            // Reset Form
            // =================================================

            SelectedCustomerId =
                Guid.Empty;

            IsUrgent =
                false;

            Description =
                null;

            Samples.Clear();

            SelectedTests.Clear();
        }
        catch (Exception ex)
        {
            Result =
                $"خطا در ثبت پذیرش: {ex.Message}";

            ResultSeverity =
                Severity.Error;
        }
        finally
        {
            IsSaving = false;
        }
    }
    
    private IEnumerable<TestLookupDto> GetFilteredTests()
    {
        if (string.IsNullOrWhiteSpace(TestSearchText))
            return Tests;

        var search = TestSearchText.Trim();

        return Tests.Where(x =>
            (!string.IsNullOrWhiteSpace(x.DisplayName) &&
             x.DisplayName.Contains(
                 search,
                 StringComparison.OrdinalIgnoreCase))
            ||
            (!string.IsNullOrWhiteSpace(x.Code) &&
             x.Code.Contains(
                 search,
                 StringComparison.OrdinalIgnoreCase)));
    }
    private void ToggleTest(
    CreateReceptionSampleDto sample,
    Guid testId,
    bool selected)
    {
        if (!SelectedTests.ContainsKey(sample))
        {
            SelectedTests[sample] = new HashSet<Guid>();
        }

        if (selected)
        {
            SelectedTests[sample].Add(testId);
        }
        else
        {
            SelectedTests[sample].Remove(testId);
        }
    }
    private IEnumerable<TestPanel> GetFilteredTestPanels()
    {
        var panels = TestPanels
            .Where(x => x.IsActive && !x.IsDeleted);

        if (string.IsNullOrWhiteSpace(TestPanelSearchText))
            return panels.OrderBy(x => x.Name);

        var search = TestPanelSearchText.Trim();

        return panels
            .Where(x =>
                (!string.IsNullOrWhiteSpace(x.Name) &&
                 x.Name.Contains(
                     search,
                     StringComparison.OrdinalIgnoreCase))
                ||
                (!string.IsNullOrWhiteSpace(x.Code) &&
                 x.Code.Contains(
                     search,
                     StringComparison.OrdinalIgnoreCase)))
            .OrderBy(x => x.Name);
    }

    private void ToggleTestPanel(Guid panelId, bool selected)
    {
        if (selected)
            SelectedTestPanelIds.Add(panelId);
        else
            SelectedTestPanelIds.Remove(panelId);
    }

    private async Task AddSelectedPanelTests(
        CreateReceptionSampleDto sample)
    {
        if (SelectedTestPanelIds.Count == 0)
            return;

        if (!SelectedTests.ContainsKey(sample))
        {
            SelectedTests[sample] = new HashSet<Guid>();
        }

        foreach (var panelId in SelectedTestPanelIds)
        {
            var panel =
                await TestPanelService.GetByIdAsync(panelId);

            if (panel == null)
                continue;

            var testIds = panel.Items
                .Where(x => x.IsActive && !x.IsDeleted)
                .Select(x => x.TestId)
                .Distinct();

            foreach (var testId in testIds)
            {
                SelectedTests[sample].Add(testId);
            }
        }

        SelectedTestPanelIds.Clear();
        TestPanelSearchText = "";

        await InvokeAsync(StateHasChanged);
    }
}