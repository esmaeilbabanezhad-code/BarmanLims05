    // =========================================================
    // Save Reception
    // =========================================================

    private async Task Save()
    {
        if (IsSaving)
            return;

        try
        {
            Result = "";


            // =================================================
            // Customer validation
            // =================================================

            if (SelectedCustomerId == Guid.Empty)
            {
                Result =
                    "لطفاً مشتری را انتخاب کنید.";

                ResultSeverity =
                    Severity.Warning;

                return;
            }


            // =================================================
            // Sample validation
            // =================================================

            if (Samples.Count == 0)
            {
                Result =
                    "لطفاً حداقل یک نمونه اضافه کنید.";

                ResultSeverity =
                    Severity.Warning;

                return;
            }


            // =================================================
            // Remove empty samples
            // =================================================

            var validSamples =
                Samples
                    .Where(x =>
                        !string.IsNullOrWhiteSpace(
                            x.SampleName))
                    .ToList();


            if (validSamples.Count == 0)
            {
                Result =
                    "لطفاً حداقل نام یک نمونه را وارد کنید.";

                ResultSeverity =
                    Severity.Warning;

                return;
            }


            // =================================================
            // Validate Matrix
            // =================================================

            var sampleWithoutMatrix =
              validSamples.FirstOrDefault(x =>
              !x.MatrixId.HasValue ||
              x.MatrixId == Guid.Empty);


            if (sampleWithoutMatrix != null)
            {
                Result =
                    $"برای نمونه «{sampleWithoutMatrix.SampleName}» " +
                    "لطفاً ماتریس را انتخاب کنید.";

                ResultSeverity =
                    Severity.Warning;

                return;
            }


            // =================================================
            // Start Saving
            // =================================================

            IsSaving = true;


            // =================================================
            // Copy selected tests to DTO
            // =================================================

            foreach (var sample in validSamples)
            {
                if (SelectedTests.TryGetValue(
                        sample,
                        out var selectedTests))
                {
                    sample.TestIds =
                        selectedTests
                            .Where(x =>
                                x != Guid.Empty)
                            .Distinct()
                            .ToList();
                }
                else
                {
                    sample.TestIds =
                        new List<Guid>();
                }
                if (SelectedTestPanels.TryGetValue(
               sample,
               out var selectedTestPanels))
                {
                    sample.TestPanelIds =
                        selectedTestPanels
                            .Where(x =>
                                x.Key != Guid.Empty &&
                                x.Value != Guid.Empty)
                            .ToDictionary(
                                x => x.Key,
                                x => x.Value);
                }
                else
                {
                    sample.TestPanelIds =
                        new Dictionary<Guid, Guid>();
                }
                if (SampleCustomFields.TryGetValue(
                    sample,
                    out var customFields))
                {
                    sample.CustomFields = customFields;
                }
                else
                {
                    sample.CustomFields =
                        new List<CustomFieldValueDto>();
                }
            }

            foreach (var sample in validSamples)
            {
                Console.WriteLine(
                    $"[SAVE PANEL DEBUG] Sample = {sample.SampleName}");

                Console.WriteLine(
                    $"[SAVE PANEL DEBUG] TestIds = {sample.TestIds.Count}");

                Console.WriteLine(
                    $"[SAVE PANEL DEBUG] TestPanelIds = {sample.TestPanelIds.Count}");

                foreach (var mapping in sample.TestPanelIds)
                {
                    Console.WriteLine(
                        $"[SAVE PANEL DEBUG] TestId = {mapping.Key}, PanelId = {mapping.Value}");
                }
            }
            // =================================================
            // Create Reception DTO
            // =================================================

            var dto =
                new CreateReceptionDto
                {
                    CustomerId =
                        SelectedCustomerId,
                    
                    ReceptionDate =
                         ReceptionDate ?? DateTime.Now,
                    IsUrgent =
                        IsUrgent,

                    Description =
                        Description,

                    Samples =
                        validSamples
                };


            // =================================================
            // Create Reception
            // =================================================

            var reception =
                await ReceptionService
                    .CreateReceptionAsync(dto);


            // =================================================
            // Success
            // =================================================

            Result =
                $"پذیرش {reception.ReceptionNumber} با موفقیت ثبت شد. " +
                $"تعداد نمونه: {validSamples.Count}";

            ResultSeverity =
                Severity.Success;

            await Task.Delay(300);

            NavigationManager.NavigateTo(
                $"/reception/details/{reception.Id}");


            // =================================================
            // Reset Form
            // =================================================

            SelectedCustomerId =
                Guid.Empty;

            IsUrgent =
                false;

            Description =
                null;

            Samples.Clear();

            SelectedTests.Clear();
        }
        catch (Exception ex)
        {
            Result =
                $"خطا در ثبت پذیرش: {ex.Message} " +
                $"جزئیات: {ex.InnerException?.Message}";

            ResultSeverity =
                Severity.Error;
        }
        finally
        {
            IsSaving = false;
        }
    }
    
    private IEnumerable<TestLookupDto> GetFilteredTests()
    {
        if (string.IsNullOrWhiteSpace(TestSearchText))
            return Tests;

        var search = TestSearchText.Trim();

        return Tests.Where(x =>
            (!string.IsNullOrWhiteSpace(x.DisplayName) &&
             x.DisplayName.Contains(
                 search,
                 StringComparison.OrdinalIgnoreCase))
            ||
            (!string.IsNullOrWhiteSpace(x.Code) &&
             x.Code.Contains(
                 search,
                 StringComparison.OrdinalIgnoreCase)));
    }
    private void ToggleTest(
    CreateReceptionSampleDto sample,
    Guid testId,
    bool selected)
    {
        if (!SelectedTests.ContainsKey(sample))
        {
            SelectedTests[sample] =
                new HashSet<Guid>();
        }

        if (!DefaultSelectedTests.ContainsKey(sample))
        {
            DefaultSelectedTests[sample] =
                new HashSet<Guid>();
        }

        if (selected)
        {
            // انتخاب دستی کاربر
            SelectedTests[sample].Add(testId);
        }
        else
        {
            // حذف از انتخاب فعلی
            SelectedTests[sample].Remove(testId);

            // نکته:
            // DefaultSelectedTests را حذف نمی‌کنیم.
            // این مجموعه منشأ Default آزمون را نگه می‌دارد.
        }
    }
    private IEnumerable<TestPanel> GetFilteredTestPanels()
    {
        var panels = TestPanels
            .Where(x => x.IsActive && !x.IsDeleted);

        if (string.IsNullOrWhiteSpace(TestPanelSearchText))
            return panels.OrderBy(x => x.Name);

        var search = TestPanelSearchText.Trim();

        return panels
            .Where(x =>
                (!string.IsNullOrWhiteSpace(x.Name) &&
                 x.Name.Contains(
                     search,
                     StringComparison.OrdinalIgnoreCase))
                ||
                (!string.IsNullOrWhiteSpace(x.Code) &&
                 x.Code.Contains(
                     search,
                     StringComparison.OrdinalIgnoreCase)))
            .OrderBy(x => x.Name);
    }

    private void ToggleTestPanel(Guid panelId, bool selected)
    {
        if (selected)
            SelectedTestPanelIds.Add(panelId);
        else
            SelectedTestPanelIds.Remove(panelId);
    }

    private async Task AddSelectedPanelTests(
    CreateReceptionSampleDto sample)
    {
        if (SelectedTestPanelIds.Count == 0)
            return;

        if (!SelectedTests.ContainsKey(sample))
        {
            SelectedTests[sample] =
                new HashSet<Guid>();
        }

        if (!SelectedTestPanels.ContainsKey(sample))
        {
            SelectedTestPanels[sample] =
                new Dictionary<Guid, Guid>();
        }

        foreach (var panelId in SelectedTestPanelIds)
        {
            var panel =
                await TestPanelService.GetByIdAsync(panelId);

            if (panel == null)
                continue;

            var testIds = panel.Items
                .Where(x => x.IsActive && !x.IsDeleted)
                .Select(x => x.TestId)
                .Distinct();

            foreach (var testId in testIds)
            {
                SelectedTests[sample].Add(testId);

                SelectedTestPanels[sample][testId] =
                    panelId;
            }
        }

        SelectedTestPanelIds.Clear();
        TestPanelSearchText = "";

        await InvokeAsync(StateHasChanged);
    }
    private async Task OnMatrixChanged(
    CreateReceptionSampleDto sample)
    {
        if (!SelectedTests.ContainsKey(sample))
        {
            SelectedTests[sample] =
                new HashSet<Guid>();
        }

        if (!DefaultSelectedTests.ContainsKey(sample))
        {
            DefaultSelectedTests[sample] =
                new HashSet<Guid>();
        }

        // =========================================================
        // حذف فقط آزمون‌های Default قبلی
        // آزمون‌های دستی کاربر باقی می‌مانند
        // =========================================================

        foreach (var testId in DefaultSelectedTests[sample])
        {
            SelectedTests[sample].Remove(testId);
        }

        DefaultSelectedTests[sample].Clear();

        // =========================================================
        // اگر Matrix خالی شد، فقط Defaultهای قبلی حذف شده‌اند
        // =========================================================

        if (!sample.MatrixId.HasValue ||
            sample.MatrixId.Value == Guid.Empty)
        {
            await InvokeAsync(StateHasChanged);
            return;
        }

        // =========================================================
        // Resolve Default Test Set جدید
        // =========================================================

        var defaultTestSet =
            await DefaultTestSetService.ResolveAsync(
                SelectedCustomerId,
                sample.SampleCategoryId,
                sample.MatrixId,
                sample.StandardSampleId);

        if (defaultTestSet == null)
        {
            await InvokeAsync(StateHasChanged);
            return;
        }

        // =========================================================
        // اعمال Default Test Set جدید
        // =========================================================

        foreach (var item in defaultTestSet.Items)
        {
            // -----------------------------------------------------
            // آزمون مستقل
            // -----------------------------------------------------

            if (!item.IsPanel &&
                item.TestId.HasValue &&
                item.TestId.Value != Guid.Empty)
            {
                var testId = item.TestId.Value;

                SelectedTests[sample].Add(testId);

                DefaultSelectedTests[sample].Add(testId);
            }

            // -----------------------------------------------------
            // Test Panel
            // -----------------------------------------------------

            if (item.IsPanel &&
                item.TestPanelId.HasValue &&
                item.TestPanelId.Value != Guid.Empty)
            {
                var panel =
                    await TestPanelService.GetByIdAsync(
                        item.TestPanelId.Value);

                if (panel == null)
                    continue;

                var panelTestIds =
                    panel.Items
                        .Where(x =>
                            x.IsActive &&
                            !x.IsDeleted)
                        .Select(x => x.TestId)
                        .Distinct();

                if (!SelectedTestPanels.ContainsKey(sample))
                {
                    SelectedTestPanels[sample] =
                        new Dictionary<Guid, Guid>();
                }

                foreach (var testId in panelTestIds)
                {
                    if (testId == Guid.Empty)
                        continue;

                    SelectedTests[sample].Add(testId);

                    DefaultSelectedTests[sample].Add(testId);

                    SelectedTestPanels[sample][testId] =
                        item.TestPanelId.Value;
                }
            }
        }
        await LoadCustomFieldsAsync(sample);
        await InvokeAsync(StateHasChanged);
    }
    private async Task OnStandardSampleChanged(
    CreateReceptionSampleDto sample)
    {
        if (!SelectedTests.ContainsKey(sample))
        {
            SelectedTests[sample] =
                new HashSet<Guid>();
        }

        if (!DefaultSelectedTests.ContainsKey(sample))
        {
            DefaultSelectedTests[sample] =
                new HashSet<Guid>();
        }

        // =========================================================
        // حذف فقط آزمون‌های Default قبلی
        // آزمون‌های دستی کاربر باقی می‌مانند
        // =========================================================

        foreach (var testId in DefaultSelectedTests[sample])
        {
            SelectedTests[sample].Remove(testId);
        }

        DefaultSelectedTests[sample].Clear();

        // =========================================================
        // اگر Standard Sample پاک شد
        // =========================================================

        if (!sample.StandardSampleId.HasValue ||
            sample.StandardSampleId.Value == Guid.Empty)
        {
            await InvokeAsync(StateHasChanged);
            return;
        }

        // =========================================================
        // پیدا کردن Standard Sample
        // =========================================================

        var standardSample =
            StandardSamples.FirstOrDefault(
                x => x.Id == sample.StandardSampleId.Value);

        if (standardSample == null)
        {
            await InvokeAsync(StateHasChanged);
            return;
        }

        // =========================================================
        // Resolve Default Test Set
        // =========================================================

        var defaultTestSet =
            await DefaultTestSetService.ResolveAsync(
                SelectedCustomerId,
                standardSample.SampleCategoryId,
                standardSample.MatrixId,
                standardSample.Id);

        if (defaultTestSet == null)
        {
            await InvokeAsync(StateHasChanged);
            return;
        }

        // =========================================================
        // اعمال آزمون‌های Default جدید
        // =========================================================

        foreach (var item in defaultTestSet.Items)
        {
            // -----------------------------------------------------
            // آزمون مستقل
            // -----------------------------------------------------

            if (!item.IsPanel &&
                item.TestId.HasValue &&
                item.TestId.Value != Guid.Empty)
            {
                var testId = item.TestId.Value;

                SelectedTests[sample].Add(testId);

                DefaultSelectedTests[sample].Add(testId);
            }

            // -----------------------------------------------------
            // Test Panel
            // -----------------------------------------------------

            if (item.IsPanel &&
                item.TestPanelId.HasValue &&
                item.TestPanelId.Value != Guid.Empty)
            {
                var panel =
                    await TestPanelService.GetByIdAsync(
                        item.TestPanelId.Value);

                if (panel == null)
                    continue;

                var panelTestIds =
                    panel.Items
                        .Where(x =>
                            x.IsActive &&
                            !x.IsDeleted)
                        .Select(x => x.TestId)
                        .Distinct();

                if (!SelectedTestPanels.ContainsKey(sample))
                {
                    SelectedTestPanels[sample] =
                        new Dictionary<Guid, Guid>();
                }

                foreach (var testId in panelTestIds)
                {
                    if (testId == Guid.Empty)
                        continue;

                    SelectedTests[sample].Add(testId);

                    DefaultSelectedTests[sample].Add(testId);

                    SelectedTestPanels[sample][testId] =
                        item.TestPanelId.Value;
                }
            }
        }

        await InvokeAsync(StateHasChanged);
    }
    private async Task ApplyDefaultTestSetFromStandardSample(
    CreateReceptionSampleDto sample)
    {
        if (!SelectedTests.ContainsKey(sample))
        {
            SelectedTests[sample] =
                new HashSet<Guid>();
        }

        if (!DefaultSelectedTests.ContainsKey(sample))
        {
            DefaultSelectedTests[sample] =
                new HashSet<Guid>();
        }

        // =========================================================
        // حذف فقط Defaultهای قبلی
        // انتخاب‌های دستی کاربر باقی می‌مانند
        // =========================================================

        foreach (var testId in DefaultSelectedTests[sample])
        {
            SelectedTests[sample].Remove(testId);
        }

        DefaultSelectedTests[sample].Clear();

        // =========================================================
        // بررسی Standard Sample
        // =========================================================

        if (!sample.StandardSampleId.HasValue ||
            sample.StandardSampleId.Value == Guid.Empty)
        {
            return;
        }

        var standardSample =
            StandardSamples.FirstOrDefault(
                x => x.Id == sample.StandardSampleId.Value);

        if (standardSample == null)
        {
            return;
        }

        // =========================================================
        // Resolve Default Test Set
        // =========================================================

        var defaultTestSet =
            await DefaultTestSetService.ResolveAsync(
                SelectedCustomerId,
                standardSample.SampleCategoryId,
                standardSample.MatrixId,
                standardSample.Id);

        if (defaultTestSet == null)
        {
            return;
        }

        // =========================================================
        // اعمال Default جدید
        // =========================================================

        foreach (var item in defaultTestSet.Items)
        {
            // -----------------------------------------------------
            // آزمون مستقل
            // -----------------------------------------------------

            if (!item.IsPanel &&
                item.TestId.HasValue &&
                item.TestId.Value != Guid.Empty)
            {
                var testId = item.TestId.Value;

                SelectedTests[sample].Add(testId);

                DefaultSelectedTests[sample].Add(testId);
            }

            // -----------------------------------------------------
            // Test Panel
            // -----------------------------------------------------

            if (item.IsPanel &&
                item.TestPanelId.HasValue &&
                item.TestPanelId.Value != Guid.Empty)
            {
                var panel =
                    await TestPanelService.GetByIdAsync(
                        item.TestPanelId.Value);

                if (panel == null)
                    continue;

                var panelTestIds =
                    panel.Items
                        .Where(x =>
                            x.IsActive &&
                            !x.IsDeleted)
                        .Select(x => x.TestId)
                        .Distinct();

                foreach (var testId in panelTestIds)
                {
                    if (testId == Guid.Empty)
                        continue;

                    SelectedTests[sample].Add(testId);

                    DefaultSelectedTests[sample].Add(testId);
                }
            }
        }
    }
    private Task<IEnumerable<StandardSample>> SearchStandardSamples(
    string? value,
    CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return Task.FromResult(
                StandardSamples
                    .OrderBy(x => x.Name)
                    .AsEnumerable());
        }

        var search = value.Trim();

        var result = StandardSamples
            .Where(x =>
                x.Code.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase)
                ||
                x.Name.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase))
            .OrderBy(x =>
                !x.Code.StartsWith(
                    search,
                    StringComparison.OrdinalIgnoreCase))
            .ThenBy(x =>
                !x.Name.StartsWith(
                    search,
                    StringComparison.OrdinalIgnoreCase))
            .ThenBy(x => x.Name)
            .Take(50);

        return Task.FromResult(result);
    }

    private async Task OnStandardSampleSelected(
        CreateReceptionSampleDto sample,
        StandardSample? standardSample)
    {
        if (standardSample == null)
        {
            sample.StandardSampleId = null;
            return;
        }

        sample.StandardSampleId = standardSample.Id;

        // تعیین خودکار دسته‌بندی
        sample.SampleCategoryId =
            standardSample.SampleCategoryId;

        // تعیین خودکار Matrix
        sample.MatrixId =
            standardSample.MatrixId;

        // اطمینان از وجود Matrix در لیست مربوط به نمونه
        if (sample.SampleCategoryId.HasValue &&
            sample.SampleCategoryId.Value != Guid.Empty)
        {
            var matrices =
                await MatrixService.GetBySampleCategoryIdAsync(
                    sample.SampleCategoryId.Value);

            SampleMatrices[sample] =
                matrices
                    .Where(x =>
                        x.IsActive &&
                        !x.IsDeleted)
                    .OrderBy(x => x.Name)
                    .ToList();
        }

        // انتخاب آزمون‌های Default Test Set
        await ApplyDefaultTestSetFromStandardSample(sample);

        await InvokeAsync(StateHasChanged);
    }
