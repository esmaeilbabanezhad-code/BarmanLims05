@page "/reception/details/{Id:guid}"

@using MudBlazor
@using Barman.Domain.Entities

@inject Barman.Application.Interfaces.IReceptionService ReceptionService
@inject Barman.Application.Services.TestAssignmentService TestAssignmentService

<PageTitle>جزئیات پذیرش</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-4">

    @if (IsLoading)
    {
        <MudPaper Class="pa-6">

            <div class="d-flex justify-center pa-6">

                <MudProgressCircular Indeterminate="true"
                                     Color="Color.Primary" />

            </div>

        </MudPaper>
    }
    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <MudPaper Class="pa-6">

            <MudAlert Severity="Severity.Error">
                @ErrorMessage
            </MudAlert>

        </MudPaper>
    }
    else if (Reception is null)
    {
        <MudPaper Class="pa-6">

            <MudAlert Severity="Severity.Warning">
                پذیرش مورد نظر پیدا نشد.
            </MudAlert>

        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-6">

            @* ========================================================= *@
            @* Header                                                      *@
            @* ========================================================= *@

            <div class="d-flex justify-space-between align-center">

                <div>

                    <MudText Typo="Typo.h5">
                        جزئیات پذیرش
                    </MudText>

                    <MudText Typo="Typo.body2"
                             Color="Color.Secondary"
                             Class="mt-1">

                        @Reception.ReceptionNumber

                    </MudText>

                </div>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="LoadData">

                    بازخوانی

                </MudButton>

            </div>

            <MudDivider Class="my-4" />


            @* ========================================================= *@
            @* Reception information                                       *@
            @* ========================================================= *@

            <MudGrid>

                <MudItem xs="12" sm="6" md="3">

                    <MudText Typo="Typo.caption">
                        شماره پذیرش
                    </MudText>

                    <MudText Typo="Typo.body1">
                        @Reception.ReceptionNumber
                    </MudText>

                </MudItem>


                <MudItem xs="12" sm="6" md="3">

                    <MudText Typo="Typo.caption">
                        مشتری
                    </MudText>

                    <MudText Typo="Typo.body1">
                        @Reception.Customer?.DisplayName
                    </MudText>

                </MudItem>


                <MudItem xs="12" sm="6" md="3">

                    <MudText Typo="Typo.caption">
                        تاریخ پذیرش
                    </MudText>

                    <MudText Typo="Typo.body1">
                        @Reception.ReceptionDate.ToLocalTime().ToString("yyyy/MM/dd HH:mm")
                    </MudText>

                </MudItem>


                <MudItem xs="12" sm="6" md="3">

                    <MudText Typo="Typo.caption">
                        وضعیت
                    </MudText>

                    <MudText Typo="Typo.body1">
                        @Reception.Status
                    </MudText>

                </MudItem>

            </MudGrid>


            @if (Reception.IsUrgent)
            {
                <MudAlert Severity="Severity.Warning"
                          Class="mt-4">

                    این پذیرش فوری است.

                </MudAlert>
            }


            @* ========================================================= *@
            @* Samples                                                     *@
            @* ========================================================= *@

            <MudDivider Class="my-5" />

            <MudText Typo="Typo.h6">
                نمونه‌ها و آزمون‌های متصل
            </MudText>


            @if (Reception.Samples.Count == 0)
            {
                <MudAlert Severity="Severity.Info"
                          Class="mt-4">

                    برای این پذیرش نمونه‌ای ثبت نشده است.

                </MudAlert>
            }
            else
            {
                @foreach (var sample in Reception.Samples.OrderBy(x => x.SampleCode))
                {
                    var assignments =
                    Assignments
                    .Where(x => x.SampleId == sample.Id)
                    .OrderBy(x => x.Test?.Code)
                    .ToList();

                    <MudPaper Class="pa-4 mt-4"
                              Outlined="true">

                        @* ================================================= *@
                        @* Sample header                                        *@
                        @* ================================================= *@

                        <div class="d-flex justify-space-between align-center">

                            <div>

                                <MudText Typo="Typo.subtitle1">

                                    @sample.SampleName

                                </MudText>

                                <MudText Typo="Typo.body2"
                                         Color="Color.Secondary">

                                    کد نمونه:
                                    @sample.SampleCode

                                </MudText>

                            </div>


                            @if (assignments.Count > 0)
                            {
                                <MudChip T="string"
                                         Color="Color.Success"
                                         Size="Size.Small">

                                    @assignments.Count آزمون

                                </MudChip>
                            }
                            else
                            {
                                <MudChip T="string"
                                         Color="Color.Warning"
                                         Size="Size.Small">

                                    بدون آزمون

                                </MudChip>
                            }

                        </div>


                        <MudDivider Class="my-3" />


                        @* ================================================= *@
                        @* Sample information                                   *@
                        @* ================================================= *@

                        <MudGrid>

                            <MudItem xs="12" sm="6" md="3">

                                <MudText Typo="Typo.caption">
                                    ماتریس
                                </MudText>

                                <MudText Typo="Typo.body2">

                                    @(sample.Matrix?.Name ?? "-")

                                </MudText>

                            </MudItem>


                            <MudItem xs="12" sm="6" md="3">

                                <MudText Typo="Typo.caption">
                                    مقدار
                                </MudText>

                                <MudText Typo="Typo.body2">

                                    @(sample.Quantity?.ToString() ?? "-")
                                    @(sample.Unit ?? "")

                                </MudText>

                            </MudItem>


                            <MudItem xs="12" sm="6" md="3">

                                <MudText Typo="Typo.caption">
                                    نوع ظرف
                                </MudText>

                                <MudText Typo="Typo.body2">

                                    @(sample.ContainerType ?? "-")

                                </MudText>

                            </MudItem>


                            <MudItem xs="12" sm="6" md="3">

                                <MudText Typo="Typo.caption">
                                    تعداد آزمون
                                </MudText>

                                <MudText Typo="Typo.body2">

                                    @assignments.Count

                                </MudText>

                            </MudItem>

                        </MudGrid>


                        @* ================================================= *@
                        @* Tests                                                 *@
                        @* ================================================= *@

                        <MudText Typo="Typo.subtitle2"
                                 Class="mt-4 mb-2">

                            آزمون‌های متصل به این نمونه

                        </MudText>


                        @if (assignments.Count == 0)
                        {
                            <MudAlert Severity="Severity.Warning">

                                هیچ TestAssignmentای برای این نمونه در دیتابیس
                                پیدا نشد.

                            </MudAlert>
                        }
                        else
                        {
                            <MudTable Items="assignments"
                                      Dense="true"
                                      Hover="true"
                                      Bordered="true"
                                      Striped="true">

                                <HeaderContent>

                                    <MudTh>
                                        کد آزمون
                                    </MudTh>

                                    <MudTh>
                                        نام آزمون
                                    </MudTh>

                                    <MudTh>
                                        بخش
                                    </MudTh>

                                    <MudTh>
                                        واحد
                                    </MudTh>

                                    <MudTh>
                                        نوع
                                    </MudTh>

                                    <MudTh>
                                        وضعیت نتیجه
                                    </MudTh>

                                </HeaderContent>

                                <RowTemplate>

                                    <MudTd DataLabel="کد آزمون">

                                        @context.Test?.Code

                                    </MudTd>


                                    <MudTd DataLabel="نام آزمون">

                                        @context.Test?.Name

                                    </MudTd>

                                    <MudTd DataLabel="بخش">

                                        <MudSelect T="Guid?"
                                                   Value="@context.DepartmentId"
                                                   ValueChanged="@(value => ChangeDepartment(context, value))"
                                                   Dense="true"
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense"
                                                   Clearable="true">

                                            @foreach (var department in Departments)
                                            {
                                                <MudSelectItem T="Guid?"
                                                               Value="@department.Id">

                                                    @department.Name

                                                </MudSelectItem>
                                            }

                                       </MudSelect>

                                    </MudTd>

                                    <MudTd DataLabel="واحد">

                                        @(context.Unit
                                                                ?? context.Test?.Unit
                                                                ?? "-")

                    </MudTd>


                                    <MudTd DataLabel="نوع">

                        @if (context.Test?.IsQuantitative == true)
                                        {
                                            <MudChip T="string"
                                                     Color="Color.Primary"
                                                     Size="Size.Small">

                                                کمی

                                            </MudChip>
                                        }
                                        else
                                        {
                                            <MudChip T="string"
                                                     Color="Color.Secondary"
                                                     Size="Size.Small">

                                                کیفی

                                            </MudChip>
                                        }

                                    </MudTd>


                                    <MudTd DataLabel="وضعیت نتیجه">

                                        @if (string.IsNullOrWhiteSpace(context.Result))
                                        {
                                            <MudChip T="string"
                                                     Color="Color.Default"
                                                     Size="Size.Small">

                                                نتیجه ثبت نشده

                                            </MudChip>
                                        }
                                        else
                                        {
                                            <MudChip T="string"
                                                     Color="Color.Success"
                                                     Size="Size.Small">

                                                @context.Result

                                            </MudChip>
                                        }

                                    </MudTd>

                                </RowTemplate>

                            </MudTable>
                        }

                    </MudPaper>
                }
            }


            @* ========================================================= *@
            @* Verification message                                       *@
            @* ========================================================= *@

            <MudDivider Class="my-5" />

            @if (Assignments.Count > 0)
            {
                <MudAlert Severity="Severity.Success">

                    <MudText Typo="Typo.body1">

                        اتصال آزمون‌ها به نمونه‌ها از دیتابیس با موفقیت
                        خوانده شد.

                    </MudText>

                    <MudText Typo="Typo.body2" Class="mt-1">

                        تعداد TestAssignment:
                        <b>@Assignments.Count</b>

                    </MudText>

                </MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Warning">

                    برای این پذیرش هیچ TestAssignmentای از دیتابیس خوانده نشد.

                </MudAlert>
            }

        </MudPaper>
    }

</MudContainer>


@code
{
    
    private List<Department> Departments = new();

    [Parameter]
    public Guid Id { get; set; }


    private Reception? Reception;

    private List<TestAssignment> Assignments = new();


    private bool IsLoading;

    private string? ErrorMessage;


    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }


    private async Task LoadData()
    {
        if (Id == Guid.Empty)
        {
            ErrorMessage = "شناسه پذیرش معتبر نیست.";
            return;
        }

        try
        {
            IsLoading = true;
            ErrorMessage = null;

            Reception =
                await ReceptionService.GetByIdAsync(Id);

            if (Reception is null)
            {
                ErrorMessage =
                    "پذیرش مورد نظر پیدا نشد.";

                Assignments.Clear();

                return;
            }

            Assignments =
                await TestAssignmentService
                    .GetByReceptionIdAsync(Id);

            Departments =
await TestAssignmentService
.GetDepartmentsAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage =
                $"خطا در بارگذاری اطلاعات پذیرش: {ex.Message}";

            Assignments.Clear();
        }
        finally
        {
            IsLoading = false;
        }
    }
    private async Task ChangeDepartment(
    TestAssignment assignment,
    Guid? departmentId)
    {
        try
        {
            await TestAssignmentService
                .SetDepartmentAsync(
                    assignment.Id,
                    departmentId);

            assignment.DepartmentId = departmentId;
        }
        catch (Exception ex)
        {
            ErrorMessage =
                $"خطا در ذخیره بخش: {ex.Message}";
        }
    }
}
