@page "/matrices-old"

@using DomainMatrix = Barman.Domain.Entities.Matrix
@using MudBlazor
@using Barman.Application.DTOs.Matrix
@using Barman.Application.DTOs.SampleCategory
@using Barman.Application.Interfaces

@inject IMatrixService MatrixService
@inject ISampleCategoryService SampleCategoryService

<PageTitle>مدیریت ماتریس نمونه‌ها</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-4">

    <MudPaper Class="pa-6">

        <div class="d-flex justify-space-between align-center">

            <MudText Typo="Typo.h5">
                مدیریت ماتریس نمونه‌ها
            </MudText>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenCreate">

                افزودن ماتریس

            </MudButton>

        </div>

        <MudDivider Class="my-4" />

        @if (IsLoading)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else if (!string.IsNullOrWhiteSpace(Result))
        {
            <MudAlert Severity="@ResultSeverity"
                      Class="mb-4">

                @Result

            </MudAlert>
        }

        @if (!IsLoading)
        {
            <MudTable Items="@Matrices"
                      Hover="true"
                      Striped="true"
                      Dense="true">

                <HeaderContent>

                    <MudTh>کد</MudTh>
                    <MudTh>نام ماتریس</MudTh>
                    <MudTh>دسته‌بندی نمونه</MudTh>
                    <MudTh>وضعیت</MudTh>
                    <MudTh>عملیات</MudTh>

                </HeaderContent>

                <RowTemplate>

                    <MudTd DataLabel="کد">
                        @context.Code
                    </MudTd>

                    <MudTd DataLabel="نام ماتریس">
                        @context.Name
                    </MudTd>

                    <MudTd DataLabel="دسته‌بندی نمونه">
                        @context.SampleCategory?.Name
                    </MudTd>

                    <MudTd DataLabel="وضعیت">

                        @if (context.IsActive && !context.IsDeleted)
                        {
                            <MudChip T="string"
                                     Color="Color.Success"
                                     Size="Size.Small">

                                فعال

                            </MudChip>
                        }
                        else
                        {
                            <MudChip T="string"
                                     Color="Color.Default"
                                     Size="Size.Small">

                                غیرفعال

                            </MudChip>
                        }

                    </MudTd>

                    <MudTd DataLabel="عملیات">

                        <MudButton Variant="Variant.Outlined"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Edit"
                                   OnClick="@(() => OpenEdit(context))">

                            ویرایش

                        </MudButton>

                        @if (context.IsActive && !context.IsDeleted)
                        {
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       Class="ms-2"
                                       Disabled="@IsSaving"
                                       OnClick="@(() => Deactivate(context))">

                                غیرفعال کردن

                            </MudButton>
                        }

                    </MudTd>

                </RowTemplate>

            </MudTable>
        }

    </MudPaper>

</MudContainer>


@* ========================================================= *@
@* Dialog افزودن / ویرایش                                   *@
@* ========================================================= *@

@if (ShowDialog)
{
    <MudOverlay Visible="true"
                DarkBackground="true"
                AutoClose="false"
                Class="d-flex align-center justify-center">

        <MudPaper Class="pa-6"
                  Style="width:500px; max-width:90vw;">

            <MudText Typo="Typo.h6">

                @(IsEditMode
                            ? "ویرایش ماتریس"
                            : "افزودن ماتریس")

        </MudText>

            <MudDivider Class="my-3" />

            <MudTextField T="string"
                          Label="کد ماتریس"
                          Variant="Variant.Outlined"
                          @bind-Value="EditModel.Code"
                          Required="true" />

            <MudTextField T="string"
                          Label="نام ماتریس"
                          Variant="Variant.Outlined"
                          Class="mt-3"
                          @bind-Value="EditModel.Name"
                          Required="true" />

            <MudSelect T="Guid"
                       Label="دسته‌بندی نمونه"
                       Variant="Variant.Outlined"
                       Class="mt-3"
                       @bind-Value="EditModel.SampleCategoryId"
                       Required="true">

            @foreach (var category in Categories)
                {
                    <MudSelectItem T="Guid"
                                   Value="@category.Id">

                        @category.Name

                    </MudSelectItem>
                }

            </MudSelect>

            <MudTextField T="string"
                          Label="توضیحات"
                          Variant="Variant.Outlined"
                          Class="mt-3"
                          Lines="3"
                          @bind-Value="EditModel.Description" />

            @if (IsEditMode)
            {
                <MudCheckBox T="bool"
                             Class="mt-3"
                             @bind-Value="EditModel.IsActive"
                             Label="فعال" />
            }

        <div class="d-flex justify-end mt-6">

            <MudButton Variant="Variant.Text"
                       Disabled="@IsSaving"
                       OnClick="CloseDialog">

                انصراف

            </MudButton>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="ms-2"
                       Disabled="@IsSaving"
                       OnClick="SaveMatrix">

                @(IsSaving
                                ? "در حال ذخیره..."
                                : "ذخیره")

            </MudButton>

            </div>

        </MudPaper>

    </MudOverlay>
}


@* ========================================================= *@
@* Dialog فعال‌سازی مجدد                                     *@
@* ========================================================= *@

@if (ShowReactivateDialog)
{
    <MudOverlay Visible="true"
                DarkBackground="true"
                AutoClose="false"
                Class="d-flex align-center justify-center">

        <MudPaper Class="pa-6"
                  Style="width:500px; max-width:90vw;">

            <MudText Typo="Typo.h6">
                فعال‌سازی مجدد ماتریس
            </MudText>

            <MudDivider Class="my-3" />

            <MudAlert Severity="Severity.Warning">

                این ماتریس قبلاً ایجاد شده ولی غیرفعال است.
                <br />
                آیا می‌خواهید آن را مجدداً فعال کنید؟

            </MudAlert>

            <MudText Class="mt-4">
                <b>کد:</b> @ReactivateCode
            </MudText>

            <MudText>
                <b>نام:</b> @ReactivateName
            </MudText>

            <div class="d-flex justify-end mt-6">

                <MudButton Variant="Variant.Text"
                           Disabled="@IsSaving"
                           OnClick="CancelReactivate">

                    انصراف

                </MudButton>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           Class="ms-2"
                           Disabled="@IsSaving"
                           OnClick="ReactivateMatrix">

                    @(IsSaving
                                    ? "در حال فعال‌سازی..."
                                    : "فعال‌سازی مجدد")

            </MudButton>

            </div>

        </MudPaper>

    </MudOverlay>
}


@code
{
    private List<DomainMatrix> Matrices = new();
    private List<SampleCategoryLookupDto> Categories = new();

    private bool IsLoading;
    private bool IsSaving;

    private bool ShowDialog;
    private bool IsEditMode;

    private bool ShowReactivateDialog;

    private string Result = "";
    private Severity ResultSeverity = Severity.Info;

    private Guid EditingId;

    private Guid ReactivateId;
    private string ReactivateName = "";
    private string ReactivateCode = "";

    private EditMatrixModel EditModel = new();


    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }


    private async Task LoadData()
    {
        try
        {
            IsLoading = true;
            Result = "";

            Matrices = await MatrixService.GetAllAsync();

            Categories = await SampleCategoryService.GetLookupAsync();
        }
        catch (Exception ex)
        {
            Result = $"خطا در بارگذاری اطلاعات: {ex.Message}";
            ResultSeverity = Severity.Error;
        }
        finally
        {
            IsLoading = false;
        }
    }


    private void OpenCreate()
    {
        IsEditMode = false;
        EditingId = Guid.Empty;

        EditModel = new EditMatrixModel
        {
            IsActive = true,

            SampleCategoryId =
                Categories.FirstOrDefault()?.Id
                ?? Guid.Empty
        };

        Result = "";
        ShowDialog = true;
    }


    private async Task OpenEdit(DomainMatrix matrix)
    {
        var item = await MatrixService.GetByIdAsync(matrix.Id);

        if (item == null)
        {
            Result = "ماتریس موردنظر پیدا نشد.";
            ResultSeverity = Severity.Warning;
            return;
        }

        IsEditMode = true;
        EditingId = item.Id;

        EditModel = new EditMatrixModel
        {
            Code = item.Code,
            Name = item.Name,
            SampleCategoryId = item.SampleCategoryId,
            Description = item.Description,
            IsActive = item.IsActive
        };

        Result = "";
        ShowDialog = true;
    }


    private void CloseDialog()
    {
        ShowDialog = false;
        IsEditMode = false;
        EditingId = Guid.Empty;
    }


    private void CancelReactivate()
    {
        ShowReactivateDialog = false;

        ReactivateId = Guid.Empty;
        ReactivateCode = "";
        ReactivateName = "";
    }


    private async Task SaveMatrix()
    {
        if (IsSaving)
            return;

        try
        {
            Result = "";

            if (string.IsNullOrWhiteSpace(EditModel.Code))
            {
                Result = "کد ماتریس را وارد کنید.";
                ResultSeverity = Severity.Warning;
                return;
            }

            if (string.IsNullOrWhiteSpace(EditModel.Name))
            {
                Result = "نام ماتریس را وارد کنید.";
                ResultSeverity = Severity.Warning;
                return;
            }

            if (EditModel.SampleCategoryId == Guid.Empty)
            {
                Result = "دسته‌بندی نمونه را انتخاب کنید.";
                ResultSeverity = Severity.Warning;
                return;
            }

            IsSaving = true;

            if (!IsEditMode)
            {
                var code =
                    EditModel.Code.Trim()
                        .ToUpperInvariant();

                var name =
                    EditModel.Name.Trim();

                var existingMatrices =
                    await MatrixService.GetAllAsync();

                var inactiveMatrix =
                    existingMatrices.FirstOrDefault(x =>
                        !x.IsDeleted &&
                        !x.IsActive &&
                        (
                            x.Code.Equals(
                                code,
                                StringComparison.OrdinalIgnoreCase)
                            ||
                            x.Name.Equals(
                                name,
                                StringComparison.OrdinalIgnoreCase)
                        ));

                if (inactiveMatrix != null)
                {
                    ReactivateId = inactiveMatrix.Id;
                    ReactivateCode = inactiveMatrix.Code;
                    ReactivateName = inactiveMatrix.Name;

                    ShowDialog = false;
                    ShowReactivateDialog = true;

                    return;
                }

                var activeMatrix =
                    existingMatrices.FirstOrDefault(x =>
                        !x.IsDeleted &&
                        x.IsActive &&
                        (
                            x.Code.Equals(
                                code,
                                StringComparison.OrdinalIgnoreCase)
                            ||
                            x.Name.Equals(
                                name,
                                StringComparison.OrdinalIgnoreCase)
                        ));

                if (activeMatrix != null)
                {
                    Result =
                        "ماتریس با این کد یا نام قبلاً ایجاد شده و فعال است.";

                    ResultSeverity = Severity.Warning;

                    return;
                }

                var dto =
                    new CreateMatrixDto
                    {
                        Code = code,
                        Name = name,
                        SampleCategoryId =
                            EditModel.SampleCategoryId,
                        Description =
                            string.IsNullOrWhiteSpace(
                                EditModel.Description)
                                ? null
                                : EditModel.Description.Trim()
                    };

                await MatrixService.CreateAsync(dto);

                Result =
                    "ماتریس با موفقیت ایجاد شد.";
            }
            else
            {
                var dto =
                    new UpdateMatrixDto
                    {
                        Code =
                            EditModel.Code.Trim(),

                        Name =
                            EditModel.Name.Trim(),

                        SampleCategoryId =
                            EditModel.SampleCategoryId,

                        Description =
                            string.IsNullOrWhiteSpace(
                                EditModel.Description)
                                ? null
                                : EditModel.Description.Trim(),

                        IsActive =
                            EditModel.IsActive
                    };

                await MatrixService.UpdateAsync(
                    EditingId,
                    dto);

                Result =
                    "ماتریس با موفقیت ویرایش شد.";
            }

            ResultSeverity = Severity.Success;

            ShowDialog = false;
            IsEditMode = false;
            EditingId = Guid.Empty;

            await LoadData();
        }
        catch (Exception ex)
        {
            Result =
                $"خطا در ذخیره ماتریس: {ex.Message}";

            ResultSeverity = Severity.Error;
        }
        finally
        {
            IsSaving = false;
        }
    }


    private async Task Deactivate(DomainMatrix matrix)
    {
        try
        {
            IsSaving = true;

            await MatrixService.DeactivateAsync(matrix.Id);

            Result =
                "ماتریس غیرفعال شد.";

            ResultSeverity =
                Severity.Success;

            await LoadData();
        }
        catch (Exception ex)
        {
            Result =
                $"خطا در غیرفعال کردن ماتریس: {ex.Message}";

            ResultSeverity =
                Severity.Error;
        }
        finally
        {
            IsSaving = false;
        }
    }


    private async Task ReactivateMatrix()
    {
        if (ReactivateId == Guid.Empty)
            return;

        try
        {
            IsSaving = true;

            await MatrixService.ActivateAsync(
                ReactivateId);

            ShowReactivateDialog = false;

            ReactivateId = Guid.Empty;
            ReactivateCode = "";
            ReactivateName = "";

            Result =
                "ماتریس با موفقیت مجدداً فعال شد.";

            ResultSeverity =
                Severity.Success;

            await LoadData();
        }
        catch (Exception ex)
        {
            Result =
                $"خطا در فعال‌سازی مجدد ماتریس: {ex.Message}";

            ResultSeverity =
                Severity.Error;
        }
        finally
        {
            IsSaving = false;
        }
    }


    private class EditMatrixModel
    {
        public string Code { get; set; } = "";

        public string Name { get; set; } = "";

        public Guid SampleCategoryId { get; set; }

        public string? Description { get; set; }

        public bool IsActive { get; set; }
    }
}