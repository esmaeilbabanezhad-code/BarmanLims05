@page "/customers"

@using MudBlazor
@using Barman.Domain.Entities

@inject Barman.Application.Interfaces.ICustomerService CustomerService

<PageTitle>Customers</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-4">

    <MudPaper Class="pa-4">

        <div class="d-flex justify-space-between">

            <MudText Typo="Typo.h5">
                Customers
            </MudText>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="NewCustomer">
                New
            </MudButton>

        </div>

        <MudDivider Class="my-3" />

        <MudTable Items="CustomerList"
                  Hover="true"
                  Dense="true">

            <HeaderContent>

                <MudTh>Code</MudTh>
                <MudTh>Display Name</MudTh>
                <MudTh>City</MudTh>
                <MudTh>Phone</MudTh>
                <MudTh>Mobile</MudTh>
                <MudTh>Email</MudTh>
                <MudTh>Status</MudTh>
                <MudTh></MudTh>

            </HeaderContent>

            <RowTemplate>

                <MudTd>@context.Code</MudTd>

                <MudTd>@context.DisplayName</MudTd>

                <MudTd>@context.City</MudTd>

                <MudTd>@context.Phone</MudTd>

                <MudTd>@context.Mobile</MudTd>

                <MudTd>@context.Email</MudTd>

                <MudTd>

                    @if (context.IsActive)
                    {
                        <MudChip T="string"
                                 Color="Color.Success">
                            Active
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string"
                                 Color="Color.Error">
                            Inactive
                        </MudChip>
                    }

                </MudTd>

                <MudTd>

                    <MudButton Size="Size.Small"
                               Variant="Variant.Outlined"
                               Color="Color.Primary"
                               OnClick="@(() => Edit(context))">
                        Edit
                    </MudButton>

                    @if (context.IsActive)
                    {
                        <MudButton Size="Size.Small"
                                   Variant="Variant.Text"
                                   Color="Color.Warning"
                                   OnClick="@(() => Deactivate(context.Id))">
                            Disable
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Size="Size.Small"
                                   Variant="Variant.Text"
                                   Color="Color.Success"
                                   OnClick="@(() => Activate(context.Id))">
                            Activate
                        </MudButton>
                    }

                    <MudButton Size="Size.Small"
                               Variant="Variant.Text"
                               Color="Color.Error"
                               OnClick="@(() => Delete(context.Id))">
                        Delete
                    </MudButton>

                </MudTd>

            </RowTemplate>

        </MudTable>

        <MudDialog @bind-Visible="DialogVisible">

            <DialogContent>

                <MudTextField Label="Code"
                              @bind-Value="CurrentCustomer.Code" />

                <MudTextField Label="Display Name"
                              @bind-Value="CurrentCustomer.DisplayName" />

                <MudTextField Label="Legal Name"
                              @bind-Value="CurrentCustomer.LegalName" />

                <MudTextField Label="National ID"
                              @bind-Value="CurrentCustomer.NationalId" />

                <MudTextField Label="Economic Code"
                              @bind-Value="CurrentCustomer.EconomicCode" />

                <MudTextField Label="Registration No"
                              @bind-Value="CurrentCustomer.RegistrationNo" />

                <MudTextField Label="Province"
                              @bind-Value="CurrentCustomer.Province" />

                <MudTextField Label="City"
                              @bind-Value="CurrentCustomer.City" />

                <MudTextField Label="Address"
                              Lines="3"
                              @bind-Value="CurrentCustomer.Address" />

                <MudTextField Label="Postal Code"
                              @bind-Value="CurrentCustomer.PostalCode" />

                <MudTextField Label="Phone"
                              @bind-Value="CurrentCustomer.Phone" />

                <MudTextField Label="Mobile"
                              @bind-Value="CurrentCustomer.Mobile" />

                <MudTextField Label="Email"
                              @bind-Value="CurrentCustomer.Email" />

                <MudTextField Label="Website"
                              @bind-Value="CurrentCustomer.Website" />

                <MudTextField Label="Description"
                              Lines="3"
                              @bind-Value="CurrentCustomer.Description" />

            </DialogContent>

            <DialogActions>

                <MudButton Color="Color.Primary"
                           OnClick="SaveCustomer">
                    Save
                </MudButton>

                <MudButton Color="Color.Secondary"
                           OnClick="CloseDialog">
                    Cancel
                </MudButton>

            </DialogActions>

        </MudDialog>

    </MudPaper>

</MudContainer>

@code {

    private List<Customer> CustomerList = new();

    private bool DialogVisible;

    private Customer CurrentCustomer = new();

    private bool IsEdit;

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        CustomerList =
            await CustomerService.GetAllAsync();
    }

    private void NewCustomer()
    {
        CurrentCustomer = new Customer();

        IsEdit = false;

        DialogVisible = true;
    }

    private void Edit(Customer customer)
    {
        CurrentCustomer = new Customer
        {
            Id = customer.Id,
            Code = customer.Code,
            DisplayName = customer.DisplayName,
            LegalName = customer.LegalName,
            NationalId = customer.NationalId,
            EconomicCode = customer.EconomicCode,
            RegistrationNo = customer.RegistrationNo,
            Province = customer.Province,
            City = customer.City,
            Address = customer.Address,
            PostalCode = customer.PostalCode,
            Phone = customer.Phone,
            Mobile = customer.Mobile,
            Email = customer.Email,
            Website = customer.Website,
            Description = customer.Description,
            IsActive = customer.IsActive
        };

        IsEdit = true;

        DialogVisible = true;
    }

    private async Task SaveCustomer()
    {
        if (IsEdit)
        {
            await CustomerService.UpdateAsync(CurrentCustomer);
        }
        else
        {
            await CustomerService.CreateAsync(CurrentCustomer);
        }

        DialogVisible = false;

        await Load();
    }

    private void CloseDialog()
    {
        DialogVisible = false;
    }

    private async Task Activate(Guid id)
    {
        await CustomerService.ActivateAsync(id);

        await Load();
    }

    private async Task Deactivate(Guid id)
    {
        await CustomerService.DeactivateAsync(id);

        await Load();
    }

    private async Task Delete(Guid id)
    {
        await CustomerService.DeleteAsync(id);

        await Load();
    }
}
