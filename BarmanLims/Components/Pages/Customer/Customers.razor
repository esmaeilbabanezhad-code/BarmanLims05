@page "/customers"

@using MudBlazor
@using Barman.Domain.Entities

@inject Barman.Application.Interfaces.ICustomerService CustomerService
@inject Barman.Application.Interfaces.IPermissionService PermissionService

<PageTitle>مشتریان</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-4">

    @if (!CanView)
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">
            شما مجوز مشاهده مشتریان را ندارید.
        </MudAlert>
    }
    else
    {
        <MudPaper Class="pa-4">

            <div class="d-flex justify-space-between">

                <MudText Typo="Typo.h5">
                    مشتریان
                </MudText>

                @if (CanCreate)
                {
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               OnClick="NewCustomer">
                        مشتری جدید
                    </MudButton>
                }

            </div>

            <MudDivider Class="my-3" />

            <BarmanDataGrid TItem="Customer"
                            Items="CustomerList"
                            Searchable="true"
                            SearchLabel="جستجوی مشتری"
                            SearchPlaceholder="کد، نام، شهر، تلفن یا ایمیل..."
                            SearchFunc="SearchCustomer">

                <HeaderContent>

                    <MudTh>
                        <MudTableSortLabel T="Customer"
                                           SortBy="@(x => x.Code)">
                            کد مشتری
                        </MudTableSortLabel>
                    </MudTh>

                    <MudTh>
                        <MudTableSortLabel T="Customer"
                                           SortBy="@(x => x.DisplayName)">
                            نام مشتری
                        </MudTableSortLabel>
                    </MudTh>

                    <MudTh>
                        <MudTableSortLabel T="Customer"
                                           SortBy="@(x => x.City)">
                            شهر
                        </MudTableSortLabel>
                    </MudTh>

                    <MudTh>
                        <MudTableSortLabel T="Customer"
                                           SortBy="@(x => x.Phone)">
                            تلفن
                        </MudTableSortLabel>
                    </MudTh>

                    <MudTh>
                        <MudTableSortLabel T="Customer"
                                           SortBy="@(x => x.Mobile)">
                            موبایل
                        </MudTableSortLabel>
                    </MudTh>

                    <MudTh>
                        <MudTableSortLabel T="Customer"
                                           SortBy="@(x => x.Email)">
                            ایمیل
                        </MudTableSortLabel>
                    </MudTh>

                    <MudTh>
                        <MudTableSortLabel T="Customer"
                                           SortBy="@(x => x.IsActive)">
                            وضعیت
                        </MudTableSortLabel>
                    </MudTh>

                    <MudTh>
                    </MudTh>

                </HeaderContent>

                <RowTemplate Context="context">

                    <MudTd>@context.Code</MudTd>

                    <MudTd>@context.DisplayName</MudTd>

                    <MudTd>@context.City</MudTd>

                    <MudTd>@context.Phone</MudTd>

                    <MudTd>@context.Mobile</MudTd>

                    <MudTd>@context.Email</MudTd>

                    <MudTd>

                        @if (context.IsActive)
                        {
                            <MudChip T="string"
                                     Color="Color.Success">
                                فعال
                            </MudChip>
                        }
                        else
                        {
                            <MudChip T="string"
                                     Color="Color.Error">
                                غیرفعال
                            </MudChip>
                        }

                    </MudTd>

                    <MudTd>

                        @if (CanEdit)
                        {
                            <MudButton Size="Size.Small"
                                       Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       OnClick="@(() => Edit(context))">
                                ویرایش
                            </MudButton>
                        }

                        @if (CanEdit)
                        {
                            @if (context.IsActive)
                            {
                                <MudButton Size="Size.Small"
                                           Variant="Variant.Text"
                                           Color="Color.Warning"
                                           OnClick="@(() => Deactivate(context.Id))">
                                    غیرفعال کردن
                                </MudButton>
                            }
                            else
                            {
                                <MudButton Size="Size.Small"
                                           Variant="Variant.Text"
                                           Color="Color.Success"
                                           OnClick="@(() => Activate(context.Id))">
                                    فعال کردن
                                </MudButton>
                            }
                        }

                        @if (CanDelete)
                        {
                            <MudButton Size="Size.Small"
                                       Variant="Variant.Text"
                                       Color="Color.Error"
                                       OnClick="@(() => Delete(context.Id))">
                                حذف
                            </MudButton>
                        }

                    </MudTd>

                </RowTemplate>

            </BarmanDataGrid>

            <MudDialog @bind-Visible="DialogVisible">

                <DialogContent>

                    <MudTextField Label="کد مشتری"
                                  @bind-Value="CurrentCustomer.Code"
                                  ReadOnly="true" />

                    <MudTextField Label="نام مشتری"
                                  @bind-Value="CurrentCustomer.DisplayName" />

                    <MudTextField Label="نام حقوقی"
                                  @bind-Value="CurrentCustomer.LegalName" />

                    <MudTextField Label="شناسه ملی"
                                  @bind-Value="CurrentCustomer.NationalId" />

                    <MudTextField Label="کد اقتصادی"
                                  @bind-Value="CurrentCustomer.EconomicCode" />

                    <MudTextField Label="شماره ثبت"
                                  @bind-Value="CurrentCustomer.RegistrationNo" />

                    <MudTextField Label="استان"
                                  @bind-Value="CurrentCustomer.Province" />

                    <MudTextField Label="شهر"
                                  @bind-Value="CurrentCustomer.City" />

                    <MudTextField Label="نشانی"
                                  Lines="3"
                                  @bind-Value="CurrentCustomer.Address" />

                    <MudTextField Label="کد پستی"
                                  @bind-Value="CurrentCustomer.PostalCode" />

                    <MudTextField Label="تلفن"
                                  @bind-Value="CurrentCustomer.Phone" />

                    <MudTextField Label="موبایل"
                                  @bind-Value="CurrentCustomer.Mobile" />

                    <MudTextField Label="ایمیل"
                                  @bind-Value="CurrentCustomer.Email" />

                    <MudTextField Label="وب‌سایت"
                                  @bind-Value="CurrentCustomer.Website" />

                    <MudTextField Label="توضیحات"
                                  Lines="3"
                                  @bind-Value="CurrentCustomer.Description" />

                </DialogContent>

                <DialogActions>

                    <MudButton Color="Color.Primary"
                               OnClick="SaveCustomer">
                        ذخیره
                    </MudButton>

                    <MudButton Color="Color.Secondary"
                               OnClick="CloseDialog">
                        انصراف
                    </MudButton>

                </DialogActions>

            </MudDialog>

        </MudPaper>
    }

</MudContainer>

@code {

    private List<Customer> CustomerList = new();

    private bool DialogVisible;

    private Customer CurrentCustomer = new();

    private bool IsEdit;
    private bool CanView;
    private bool CanCreate;
    private bool CanEdit;
    private bool CanDelete;

    private string SearchCustomer(Customer customer)
    {
        return string.Join(" ",
            customer.Code ?? "",
            customer.DisplayName ?? "",
            customer.City ?? "",
            customer.Phone ?? "",
            customer.Mobile ?? "",
            customer.Email ?? "");
    }

    protected override async Task OnInitializedAsync()
    {
        CanView =
            await PermissionService.HasPermissionAsync(
                "Customer.View");

        CanCreate =
            await PermissionService.HasPermissionAsync(
                "Customer.Create");

        CanEdit =
            await PermissionService.HasPermissionAsync(
                "Customer.Edit");

        CanDelete =
            await PermissionService.HasPermissionAsync(
                "Customer.Delete");

        if (CanView)
        {
            await Load();
        }
    }

    private async Task Load()
    {
        CustomerList =
            await CustomerService.GetAllAsync();
    }

    private void NewCustomer()
    {
        CurrentCustomer = new Customer();

        IsEdit = false;

        DialogVisible = true;
    }

    private void Edit(Customer customer)
    {
        CurrentCustomer = new Customer
        {
            Id = customer.Id,
            Code = customer.Code,
            DisplayName = customer.DisplayName,
            LegalName = customer.LegalName,
            NationalId = customer.NationalId,
            EconomicCode = customer.EconomicCode,
            RegistrationNo = customer.RegistrationNo,
            Province = customer.Province,
            City = customer.City,
            Address = customer.Address,
            PostalCode = customer.PostalCode,
            Phone = customer.Phone,
            Mobile = customer.Mobile,
            Email = customer.Email,
            Website = customer.Website,
            Description = customer.Description,
            IsActive = customer.IsActive
        };

        IsEdit = true;

        DialogVisible = true;
    }

    private async Task SaveCustomer()
    {
        if (IsEdit)
        {
            await CustomerService.UpdateAsync(CurrentCustomer);
        }
        else
        {
            await CustomerService.CreateAsync(CurrentCustomer);
        }

        DialogVisible = false;

        await Load();
    }

    private void CloseDialog()
    {
        DialogVisible = false;
    }

    private async Task Activate(Guid id)
    {
        await CustomerService.ActivateAsync(id);

        await Load();
    }

    private async Task Deactivate(Guid id)
    {
        await CustomerService.DeactivateAsync(id);

        await Load();
    }

    private async Task Delete(Guid id)
    {
        await CustomerService.DeleteAsync(id);

        await Load();
    }
}