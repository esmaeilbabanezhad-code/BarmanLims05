@page "/departments"

@using MudBlazor
@using Barman.Domain.Entities

@inject Barman.Application.Interfaces.IDepartmentService DepartmentService
@inject Barman.Application.Interfaces.IPermissionService PermissionService

<PageTitle>DepartmentList</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-4">
    @if (!CanView)
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">
             شما مجوز مشاهده بخش‌ها را ندارید.
        </MudAlert>
    }
    else
    {
    <MudPaper Class="pa-4">

        <div class="d-flex justify-space-between">

            <MudText Typo="Typo.h5">
                DepartmentList
            </MudText>

            @if (CanCreate)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="NewDepartment">
                    New
                </MudButton>
            }

        </div>

        <MudDivider Class="my-3"/>

        <MudTable Items="DepartmentList"
                  Hover="true"
                  Dense="true">

            <HeaderContent>

                <MudTh>Code</MudTh>
                <MudTh>Name</MudTh>
                <MudTh>Description</MudTh>
                <MudTh>Status</MudTh>
                <MudTh></MudTh>

            </HeaderContent>

            <RowTemplate>

                <MudTd>@context.Code</MudTd>

                <MudTd>@context.Name</MudTd>

                <MudTd>@context.Description</MudTd>

                <MudTd>

                    @if(context.IsActive)
                    {
                        <MudChip T="string" Color="Color.Success">Active</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Error">Inactive</MudChip>
                    }

                </MudTd>

                <MudTd>

                    @if (CanEdit)
                    {
                        <MudButton Size="Size.Small"
                                   Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   OnClick="@(()=>Edit(context))">
                            Edit
                        </MudButton>
                    }

                    @if (CanEdit)
                    {
                        @if (context.IsActive)
                        {
                            <MudButton Size="Size.Small"
                                       Variant="Variant.Text"
                                       Color="Color.Warning"
                                       OnClick="@(()=>Deactivate(context.Id))">
                                Disable
                            </MudButton>
                        }
                        else
                        {
                            <MudButton Size="Size.Small"
                                       Variant="Variant.Text"
                                       Color="Color.Success"
                                       OnClick="@(()=>Activate(context.Id))">
                                Activate
                            </MudButton>
                        }
                    }

                    @if (CanDelete)
                    {
                        <MudButton Size="Size.Small"
                                   Variant="Variant.Text"
                                   Color="Color.Error"
                                   OnClick="@(()=>Delete(context.Id))">
                            Delete
                        </MudButton>
                    }

                </MudTd>

            </RowTemplate>

        </MudTable>

        <MudDialog @bind-Visible="DialogVisible">

            <DialogContent>

                <MudTextField Label="Code"
                              @bind-Value="CurrentDepartment.Code" />

                <MudTextField Label="Name"
                              @bind-Value="CurrentDepartment.Name" />

                <MudTextField Label="Description"
                              Lines="3"
                              @bind-Value="CurrentDepartment.Description" />

            </DialogContent>

            <DialogActions>

                <MudButton Color="Color.Primary"
                           OnClick="SaveDepartment">

                    Save

                </MudButton>

                <MudButton Color="Color.Secondary"
                           OnClick="CloseDialog">

                    Cancel

                </MudButton>

            </DialogActions>

        </MudDialog>

    </MudPaper>
    }
</MudContainer>

@code{

    private List<Department> DepartmentList = new();

    private bool CanView;
    private bool CanCreate;
    private bool CanEdit;
    private bool CanDelete;

    protected override async Task OnInitializedAsync()
    {
        CanView =
            await PermissionService.HasPermissionAsync(
                "Department.View");

        CanCreate =
            await PermissionService.HasPermissionAsync(
                "Department.Create");

        CanEdit =
            await PermissionService.HasPermissionAsync(
                "Department.Edit");

        CanDelete =
            await PermissionService.HasPermissionAsync(
                "Department.Delete");

        if (CanView)
        {
            await Load();
        }
    }

    private async Task Load()
    {
        DepartmentList =
            await DepartmentService.GetAllAsync();
    }

    private void NewDepartment()
    {
        CurrentDepartment = new Department();

        IsEdit = false;

        DialogVisible = true;
    }

    private void Edit(Department department)
    {
        CurrentDepartment = new Department
        {
            Id = department.Id,
            Code = department.Code,
            Name = department.Name,
            Description = department.Description,
            IsActive = department.IsActive
        };

        IsEdit = true;

        DialogVisible = true;
    }

    private async Task SaveDepartment()
    {
        if (IsEdit)
        {
            await DepartmentService.UpdateAsync(CurrentDepartment);
        }
        else
        {
            await DepartmentService.CreateAsync(CurrentDepartment);
        }

        DialogVisible = false;

        await Load();
    }

    private void CloseDialog()
    {
        DialogVisible = false;
    }

    private async Task Activate(Guid id)
    {
        await DepartmentService.ActivateAsync(id);
        await Load();
    }

    private async Task Deactivate(Guid id)
    {
        await DepartmentService.DeactivateAsync(id);
        await Load();
    }

    private async Task Delete(Guid id)
    {
        await DepartmentService.DeleteAsync(id);
        await Load();
    }

    private bool DialogVisible;

    private Department CurrentDepartment = new();

    private bool IsEdit;

}